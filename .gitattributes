# 改行コードを LF に固定する (Windows でも作業ツリーで CRLF に変換しない)
* text=auto eol=lf

# Windows でしか使わないファイルは CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# バイナリ
*.png binary
*.ico binary
*.pfx binary
*.vhdx binary

# 同梱の Monaco Editor (第三者のファイル) はそのままの内容で持つ (改行を変換しない)
src/HexEditor.App/Assets/Monaco/vs/** -text
src/HexEditor.App/Assets/Monaco/*.txt -text
