<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HexEditor.App</RootNamespace>
    <!-- 実行ファイルは HexEditor.exe (PKG-05 の仕様 1、PKG-07)。名前空間は HexEditor.App のまま。 -->
    <AssemblyName>HexEditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en</DefaultLanguage>
  </PropertyGroup>

  <!--
    配布形態の切り替え (PKG-10)。HexDistro = Msix / Installer / Portable。指定しなければ開発用 (非パッケージ)。
    起動処理は Hosting/Program.cs に自分で書く (PKG-11)。
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HexDistro)' == 'Msix'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <DefineConstants>$(DefineConstants);HEX_DISTRO_MSIX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HexDistro)' != 'Msix'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HexDistro)' == 'Installer'">
    <DefineConstants>$(DefineConstants);HEX_DISTRO_INSTALLER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HexDistro)' == 'Portable'">
    <DefineConstants>$(DefineConstants);HEX_DISTRO_PORTABLE</DefineConstants>
  </PropertyGroup>
  <Target Name="CheckHexDistro" BeforeTargets="BeforeBuild"
          Condition="'$(HexDistro)' != '' and '$(HexDistro)' != 'Msix' and '$(HexDistro)' != 'Installer' and '$(HexDistro)' != 'Portable'">
    <Error Text="HexDistro には Msix / Installer / Portable のどれかを指定してください (指定値: $(HexDistro))。" />
  </Target>
  <ItemGroup Condition="'$(HexDistro)' == 'Installer'">
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- 第三者のライセンス表示はすべての配布形態に入れる (PKG-05 の仕様 1、UI-40)。 -->
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- settings.json の JSON スキーマ (UI-23 の仕様 8)。設定項目の登録から作る (Core のテスト SettingsSchemaIsUpToDate)。 -->
    <!-- 英語の文字列 (表示言語に関係なく英語名で検索するため。Loc.English)。 -->
    <EmbeddedResource Include="Strings\en\Resources.resw" LogicalName="HexEditor.Strings.en.resw" />
    <Content Include="settings.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ビルドの配布形態を実行時に読めるようにする (判定の結果との食い違いの警告。PKG-12 の仕様 2)。 -->
  <ItemGroup>
    <AssemblyMetadata Include="HexDistro" Value="$(HexDistro)" />
    <Using Include="HexEditor.Platform" />
  </ItemGroup>

  <!-- 補助プロセス (PKG-14 の仕様 2) の SHA-256。リリースのビルドで publish.ps1 が先にビルドした exe のハッシュを渡す。
       空のビルド (開発中) ではハッシュを照合しない。 -->
  <ItemGroup Condition="'$(HexHelperSha256)' != ''">
    <AssemblyMetadata Include="HelperSha256" Value="$(HexHelperSha256)" />
  </ItemGroup>

  <!--
    MSIX のマニフェストの版は PKG-28 の対応表で SemVer から作る (PKG-03 の仕様 4)。手で書かない。
    Package.appxmanifest をひな形として obj にコピーし、Identity の Version を書き換えたものを使う。
  -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="$(BaseIntermediateOutputPath)manifest\$(Configuration)\$(Platform)\Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <Target Name="HexGenerateAppxManifest" BeforeTargets="PrepareForBuild;_ValidatePresenceOfAppxManifestItems"
          Condition="'$(WindowsPackageType)' == 'MSIX'">
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="@(AppxManifest)" SkipUnchangedFiles="false" />
    <XmlPoke XmlInputPath="@(AppxManifest)" Query="/m:Package/m:Identity/@Version" Value="$(HexMsixVersion)"
             Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
  </Target>

  <!--
    Windows 11 の新しい右クリックメニューの COM サーバー (09 の UI-55)。MSIX 版だけに入れる。DLL は build/publish.ps1 が
    HexEditor.ShellExtension を NativeAOT で発行して HexShellExtensionDir で渡す (マニフェストの com:Class の Path と同じ名前)。
    渡されない MSIX のビルド (開発中の実行) では入れず、新しいメニューは出ない。
  -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX' and '$(HexShellExtensionDir)' != ''">
    <Content Include="$([MSBuild]::EnsureTrailingSlash('$(HexShellExtensionDir)'))HexEditor.ShellExtension.dll" Link="HexEditor.ShellExtension.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="HexWarnMissingShellExtension" BeforeTargets="BeforeBuild"
          Condition="'$(WindowsPackageType)' == 'MSIX' and '$(HexShellExtensionDir)' == ''">
    <Warning Text="HexShellExtensionDir が指定されていないため、HexEditor.ShellExtension.dll をパッケージに入れません (Windows 11 の新しい右クリックメニューが出ません。UI-55)。" />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    翻訳者向けのツールチップ (UI-41 の仕様 5): 実行時に x:Uid を読めないため、XAML (メインウィンドウ・設定画面・コントロール) を埋め込んで
    AutomationId / x:Name と x:Uid の対応を読む (Services/StringKeyTips.cs)。
  -->
  <ItemGroup>
    <EmbeddedResource Include="MainWindow.xaml;Views\*.xaml;Controls\*.xaml" LogicalName="HexEditor.App.Xaml.%(Filename).xaml" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!--
      Windows App SDK 2.5.1 の部品のうち使うものだけを参照する (メタパッケージ Microsoft.WindowsAppSDK は AI・ML・検索・ウィジェットの
      部品 (onnxruntime.dll、DirectML.dll など約 20 MB) も配布物に入れ、ポータブル版の zip が PKG-16 の目標 100 MB を超えるため)。
      版はメタパッケージ 2.5.1 の依存と同じ。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HexEditor.Core\HexEditor.Core.csproj" />
    <ProjectReference Include="..\HexEditor.Platform\HexEditor.Platform.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
  </PropertyGroup>

  <!-- 疑似翻訳 (UI-46)。安定版のビルドでは HexPseudoLocales=false にする。 -->
  <Import Project="..\..\build\PseudoLocalize.targets" />

  <!-- 翻訳の割合 translation-coverage.json (UI-49 の仕様 4)。表示言語の一覧 (UI-43) とリリースノート (PKG-29) に使う。 -->
  <Import Project="..\..\build\TranslationCoverage.targets" />
</Project>
