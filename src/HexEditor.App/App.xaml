<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HexEditor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HexEditor.App.Controls"
    xmlns:local="using:HexEditor.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  ブックマークの色とインスペクタの対象の強調 (INSP-18、INSP-24)  -->
                <ResourceDictionary Source="ms-appx:///Themes/AnnotationPalette.xaml" />
                <!--  比較の差分の配色 (ANA-04 の仕様 3)  -->
                <ResourceDictionary Source="ms-appx:///Themes/ComparePalette.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!--  画面全体のズーム (UI-08 の仕様 3): ダイアログもウィンドウの中身と同じ倍率で拡大する  -->
            <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="ContentDialog">
                <Setter Property="controls:ScreenZoom.Follow" Value="True" />
            </Style>
            <!--  メニュー (右クリックメニュー・メニューバー・サブメニュー) は項目の文字の大きさを倍率に合わせる (拡大はしない)  -->
            <Style BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}" TargetType="MenuFlyoutPresenter">
                <Setter Property="controls:PopupZoom.FollowMenu" Value="True" />
            </Style>
            <!--  ツールバーのオーバーフロー (「…」) もメニューと同じく項目の文字の大きさを倍率に合わせる  -->
            <Style BasedOn="{StaticResource DefaultCommandBarOverflowPresenterStyle}" TargetType="CommandBarOverflowPresenter">
                <Setter Property="controls:PopupZoom.FollowMenu" Value="True" />
            </Style>
            <!--  コンボボックスのドロップダウンの項目とツールチップは、ポップアップに出るので文字の大きさを倍率に合わせる  -->
            <Style BasedOn="{StaticResource DefaultComboBoxItemStyle}" TargetType="ComboBoxItem">
                <Setter Property="controls:PopupZoom.FollowItem" Value="True" />
            </Style>
            <Style BasedOn="{StaticResource DefaultToolTipStyle}" TargetType="ToolTip">
                <Setter Property="controls:PopupZoom.FollowToolTip" Value="True" />
            </Style>
            <!--  フライアウトは中身を倍率どおりに拡大する (Controls/PopupZoom.cs。テンプレートは既定と同じで、全体を PopupZoomPanel に入れる)  -->
            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="FlyoutPresenter">
                            <controls:PopupZoomPanel>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BackgroundSizing="InnerBorderEdge"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <ScrollViewer
                                        x:Name="ScrollViewer"
                                        AutomationProperties.AccessibilityView="Raw"
                                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                        HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                        VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                        ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}">
                                        <ContentPresenter
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                                    </ScrollViewer>
                                </Border>
                            </controls:PopupZoomPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
