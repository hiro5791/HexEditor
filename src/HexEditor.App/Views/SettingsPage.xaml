<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <!--  項目のカード (SettingsCard 相当)。  -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0,12,16,12" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <!--  既定値から変更されている印 (左端の縦線。UI-22 の仕様 3)。  -->
        <Style x:Key="ModifiedMarkStyle" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Margin" Value="0,0,13,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SettingDescriptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingNoteStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingErrorStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style x:Key="TableRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,6" />
        </Style>
    </UserControl.Resources>

    <!--
        設定画面 (UI-22)。左にカテゴリ、右に項目。上部の検索欄はカテゴリをまたいで項目を探す。変更は操作した時点で反映して保存する
        (「OK」「適用」はない)。項目は SettingsCatalog から作り、専用の画面 (キーボードなど) は SettingsSections に登録したもの。
    -->
    <Grid Padding="0,8,0,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Settings_Title" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <AutoSuggestBox
                x:Name="Search"
                x:Uid="Settings_Search"
                Grid.Column="1"
                MaxWidth="480"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="Settings_Search"
                QueryIcon="Find" />
        </Grid>
        <InfoBar
            x:Name="RestartBar"
            x:Uid="Settings_RestartBar"
            Grid.Row="1"
            Margin="16,0"
            AutomationProperties.AutomationId="Settings_RestartBar"
            IsClosable="True"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="RestartButton" x:Uid="Settings_RestartNow" AutomationProperties.AutomationId="Settings_RestartNow" />
            </InfoBar.ActionButton>
        </InfoBar>
        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            AutomationProperties.AutomationId="Settings_Categories"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left">
            <ScrollViewer x:Name="ItemsScroll" Padding="24,0,24,24">
                <StackPanel
                    x:Name="Items"
                    MaxWidth="1000"
                    AutomationProperties.AutomationId="Settings_Items"
                    Spacing="4" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</UserControl>
