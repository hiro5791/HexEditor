<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HexEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cmd="using:HexEditor.App.Commands"
    xmlns:controls="using:HexEditor.App.Controls"
    xmlns:local="using:HexEditor.App"
    xmlns:notifications="using:HexEditor.Core.Notifications"
    xmlns:vm="using:HexEditor.App.ViewModels"
    Title="HexEditor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            タイトルバー (UI-02): アイコン、メニューバー (UI-03)、タイトルの順。TitleBar は Content の対話する要素を
            ドラッグ領域から除く。タイトルは自分で表示する (TitleBar の Title はメニューより前に出るため)。
        -->
        <!--  タイトルバー自体はフォーカスを受けない (枠の出ないフォーカスの止まり先を作らない。UI-52 の仕様 6)。  -->
        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            AutomationProperties.AutomationId="TitleBar"
            IsTabStop="False">
            <TitleBar.LeftHeader>
                <Grid Padding="12,0,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        AutomationProperties.AutomationId="TitleBar_Icon"
                        Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
                <!--
                    メニューバー (UI-03)。各項目はコマンド (UI-16) を cmd:CommandUi.Id で参照する。クリック・ショートカットの表示・
                    有効状態は MenuBinder がコマンドから取る (キーの振り分けは KeyDispatcher。KeyboardAccelerator は置かない)。
                -->
                <MenuBar x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AutomationId="MainMenu">
                    <MenuBarItem x:Uid="Menu_File">
                        <MenuFlyoutItem x:Uid="Menu_File_New" cmd:CommandUi.Id="file.new" AutomationProperties.AutomationId="Command_New" />
                        <MenuFlyoutItem x:Uid="Menu_File_NewWithSize" cmd:CommandUi.Id="file.newWithSize" AutomationProperties.AutomationId="Command_NewWithSize" />
                        <MenuFlyoutItem x:Uid="Menu_File_Open" cmd:CommandUi.Id="file.open" AutomationProperties.AutomationId="Command_Open" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_Save" cmd:CommandUi.Id="file.save" AutomationProperties.AutomationId="Command_Save" />
                        <MenuFlyoutItem x:Uid="Menu_File_SaveAs" cmd:CommandUi.Id="file.saveAs" AutomationProperties.AutomationId="Command_SaveAs" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_SaveAll" cmd:CommandUi.Id="file.saveAll" AutomationProperties.AutomationId="Command_SaveAll" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_Close" cmd:CommandUi.Id="file.close" AutomationProperties.AutomationId="Command_Close" />
                        <MenuFlyoutItem x:Uid="Menu_File_CloseAll" cmd:CommandUi.Id="file.closeAll" AutomationProperties.AutomationId="Command_CloseAll" />
                        <MenuFlyoutItem x:Uid="Menu_File_Exit" cmd:CommandUi.Id="file.exit" AutomationProperties.AutomationId="Command_Exit" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Edit">
                        <MenuFlyoutItem x:Uid="Menu_Edit_Undo" cmd:CommandUi.Id="edit.undo" AutomationProperties.AutomationId="Command_Undo" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Redo" cmd:CommandUi.Id="edit.redo" AutomationProperties.AutomationId="Command_Redo" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Cut" cmd:CommandUi.Id="edit.cut" AutomationProperties.AutomationId="Command_Cut" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Copy" cmd:CommandUi.Id="edit.copy" AutomationProperties.AutomationId="Command_Copy" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Paste" cmd:CommandUi.Id="edit.paste" AutomationProperties.AutomationId="Command_Paste" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_PasteOverwrite" cmd:CommandUi.Id="edit.pasteOverwrite" AutomationProperties.AutomationId="Command_PasteOverwrite" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_SelectAll" cmd:CommandUi.Id="edit.selectAll" AutomationProperties.AutomationId="Command_SelectAll" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_ToggleInsert" cmd:CommandUi.Id="edit.toggleInsert" AutomationProperties.AutomationId="Command_ToggleInsert" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Search">
                        <MenuFlyoutItem x:Uid="Menu_Search_Find" cmd:CommandUi.Id="search.find" AutomationProperties.AutomationId="Command_Find" />
                        <MenuFlyoutItem x:Uid="Menu_Search_Next" cmd:CommandUi.Id="search.findNext" AutomationProperties.AutomationId="Command_FindNext" />
                        <MenuFlyoutItem x:Uid="Menu_Search_Previous" cmd:CommandUi.Id="search.findPrevious" AutomationProperties.AutomationId="Command_FindPrevious" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Go">
                        <MenuFlyoutItem x:Uid="Menu_Go_GoTo" cmd:CommandUi.Id="go.goTo" AutomationProperties.AutomationId="Command_GoTo" />
                        <MenuFlyoutItem x:Uid="Menu_Go_Back" cmd:CommandUi.Id="go.back" AutomationProperties.AutomationId="Command_GoBack" />
                        <MenuFlyoutItem x:Uid="Menu_Go_Forward" cmd:CommandUi.Id="go.forward" AutomationProperties.AutomationId="Command_GoForward" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Go_Start" cmd:CommandUi.Id="go.start" AutomationProperties.AutomationId="Command_GoStart" />
                        <MenuFlyoutItem x:Uid="Menu_Go_End" cmd:CommandUi.Id="go.end" AutomationProperties.AutomationId="Command_GoEnd" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_View">
                        <MenuFlyoutSubItem x:Uid="Menu_View_Theme" AutomationProperties.AutomationId="Command_Theme">
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" x:Uid="Menu_View_ThemeSystem" cmd:CommandUi.Id="view.theme.system" AutomationProperties.AutomationId="Command_ThemeSystem" GroupName="Theme" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight" x:Uid="Menu_View_ThemeLight" cmd:CommandUi.Id="view.theme.light" AutomationProperties.AutomationId="Command_ThemeLight" GroupName="Theme" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" x:Uid="Menu_View_ThemeDark" cmd:CommandUi.Id="view.theme.dark" AutomationProperties.AutomationId="Command_ThemeDark" GroupName="Theme" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_View_Encoding" AutomationProperties.AutomationId="Command_Encoding">
                            <RadioMenuFlyoutItem x:Name="EncodingAscii" x:Uid="Menu_View_EncodingAscii" cmd:CommandUi.Id="view.encoding.ascii" AutomationProperties.AutomationId="Command_EncodingAscii" GroupName="Encoding" />
                            <RadioMenuFlyoutItem x:Name="EncodingAnsi" cmd:CommandUi.Id="view.encoding.ansi" AutomationProperties.AutomationId="Command_EncodingAnsi" GroupName="Encoding" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <!--  パネルの表示切り替え (UI-01 の仕様 6、UI-04、UI-05)。  -->
                        <MenuFlyoutSubItem x:Uid="Menu_View_Panels" AutomationProperties.AutomationId="Command_Panels">
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_Toolbar" cmd:CommandUi.Id="view.toolbar" AutomationProperties.AutomationId="Command_Toolbar" />
                            <ToggleMenuFlyoutItem x:Name="StatusBarToggle" x:Uid="Menu_View_StatusBar" cmd:CommandUi.Id="view.statusBar" AutomationProperties.AutomationId="Command_StatusBar" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_LeftPanel" cmd:CommandUi.Id="view.leftPanel" AutomationProperties.AutomationId="Command_LeftPanel" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_RightPanel" cmd:CommandUi.Id="view.rightPanel" AutomationProperties.AutomationId="Command_RightPanel" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_BottomPanel" cmd:CommandUi.Id="view.bottomPanel" AutomationProperties.AutomationId="Command_BottomPanel" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_Inspector" cmd:CommandUi.Id="view.panel.inspector" AutomationProperties.AutomationId="Command_PanelInspector" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_View_ResetPanels" cmd:CommandUi.Id="view.resetPanelLayout" AutomationProperties.AutomationId="Command_ResetPanelLayout" />
                        </MenuFlyoutSubItem>
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Tools">
                        <MenuFlyoutItem x:Uid="Menu_Tools_Settings" cmd:CommandUi.Id="settings.open" AutomationProperties.AutomationId="Command_Settings" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Help">
                        <MenuFlyoutItem x:Uid="Menu_Help_CommandPalette" cmd:CommandUi.Id="help.commandPalette" AutomationProperties.AutomationId="Command_CommandPalette" />
                        <MenuFlyoutItem x:Uid="Menu_Help_Shortcuts" cmd:CommandUi.Id="help.shortcuts" AutomationProperties.AutomationId="Command_Shortcuts" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Help_Documentation" cmd:CommandUi.Id="help.documentation" AutomationProperties.AutomationId="Command_Documentation" />
                        <MenuFlyoutItem x:Uid="Menu_Help_Report" cmd:CommandUi.Id="help.reportProblem" AutomationProperties.AutomationId="Command_ReportProblem" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Help_About" cmd:CommandUi.Id="help.about" AutomationProperties.AutomationId="Command_About" />
                    </MenuBarItem>
                </MenuBar>
                    <TextBlock
                        x:Name="WindowTitle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="WindowTitle"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="HexEditor"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!--  ツールバー (UI-04)。既定では非表示。ボタンは設定 ui.toolbar.items からコードで作る (MainWindow.Toolbar.cs)。  -->
        <CommandBar
            x:Name="Toolbar"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="Toolbar"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True"
            OverflowButtonVisibility="Auto"
            Visibility="Collapsed">
            <CommandBar.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Toolbar_Customize" cmd:CommandUi.Id="view.customizeToolbar" AutomationProperties.AutomationId="Toolbar_Customize" />
                </MenuFlyout>
            </CommandBar.ContextFlyout>
        </CommandBar>

        <controls:NotificationHost
            x:Name="WindowNotifications"
            Grid.Row="2"
            AutomationProperties.AutomationId="WindowNotifications"
            Center="{x:Bind Vm.Notifications}"
            OverflowClicked="Notifications_OverflowClicked"
            Scope="Window" />

        <controls:FindBar
            x:Name="FindBar"
            Grid.Row="3"
            AutomationProperties.AutomationId="FindBar"
            Closed="Bar_Closed"
            Visibility="Collapsed" />

        <controls:GoToBar
            x:Name="GoToBar"
            Grid.Row="3"
            AutomationProperties.AutomationId="GoToBar"
            Closed="Bar_Closed"
            Visibility="Collapsed" />

        <!--
            作業領域 (UI-01 の仕様 1 の 4): 左パネル / エディタ / 右パネル、その下に下パネル (UI-05)。パネルの中身は
            PanelRegistry に登録したもの (MainWindow.Panels.cs)。境界は分割バー (幅 4 px、矢印キーで 8 px ずつ動く。UI-01 の仕様 5)。
        -->
        <Grid x:Name="WorkArea" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BottomRow" Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PanelDockArea x:Name="LeftPanel" Grid.RowSpan="3" AutomationProperties.AutomationId="LeftPanel" Visibility="Collapsed" />
            <controls:Splitter x:Name="LeftSplitter" Grid.RowSpan="3" Grid.Column="1" AutomationProperties.AutomationId="LeftSplitter" Visibility="Collapsed" />
            <Grid x:Name="EditorArea" Grid.Column="2">
                <!--  スタートページ (UI-01 の仕様 2。文書が 1 つもないとき)。最近使ったファイル・初回の「はじめに」は UI-38 (フェーズ 1)。  -->
                <ScrollViewer
                    x:Name="StartPage"
                    Canvas.ZIndex="1"
                    AutomationProperties.AutomationId="StartPage"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="720"
                        Margin="24,48"
                        HorizontalAlignment="Center"
                        Spacing="16">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="HexEditor" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Start_Open" AutomationProperties.AutomationId="Start_Open" Click="Open_Click" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Uid="Start_New" AutomationProperties.AutomationId="Start_New" Click="New_Click" />
                        </StackPanel>
                        <TextBlock x:Uid="Start_DropHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <TabView
                    x:Name="Tabs"
                    AddTabButtonClick="Tabs_AddTabButtonClick"
                    AutomationProperties.AutomationId="DocumentTabs"
                    SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
                    TabCloseRequested="Tabs_TabCloseRequested"
                    TabItemsSource="{x:Bind Vm.Documents}"
                    VerticalAlignment="Stretch">
                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentViewModel">
                            <TabViewItem Header="{x:Bind Header, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                                <TabViewItem.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="Tab_Close" cmd:CommandUi.Id="file.close" Click="TabClose_Click" />
                                        <MenuFlyoutItem x:Uid="Tab_CloseOthers" cmd:CommandUi.Id="file.closeOthers" Click="TabCloseOthers_Click" />
                                        <MenuFlyoutItem x:Uid="Tab_CloseRight" cmd:CommandUi.Id="file.closeToRight" Click="TabCloseRight_Click" />
                                    </MenuFlyout>
                                </TabViewItem.ContextFlyout>
                                <TabViewItem.IconSource>
                                    <SymbolIconSource Symbol="Document" />
                                </TabViewItem.IconSource>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <controls:NotificationHost
                                        AutomationProperties.AutomationId="DocumentNotifications"
                                        Center="{x:Bind Notifications}"
                                        Owner="{x:Bind}"
                                        Scope="Document" />
                                    <controls:HexView
                                        Grid.Row="1"
                                        CommandRequested="HexView_CommandRequested"
                                        Editor="{x:Bind Editor}"
                                        EditRejected="HexView_EditRejected"
                                        Loaded="HexView_Loaded" />
                                </Grid>
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.TabItemTemplate>
                </TabView>

                <!--  設定画面・ショートカット一覧 (UI-22、UI-39)。タブの見出しの帯の下 (エディタ領域) に重ねて開く。  -->
                <Grid
                    x:Name="ToolPageHost"
                    Canvas.ZIndex="2"
                    AutomationProperties.AutomationId="ToolPageHost"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed" />
            </Grid>
            <controls:Splitter x:Name="BottomSplitter" Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="BottomSplitter" Visibility="Collapsed" />
            <controls:PanelDockArea x:Name="BottomPanel" Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="BottomPanel" Visibility="Collapsed" />
            <controls:Splitter x:Name="RightSplitter" Grid.RowSpan="3" Grid.Column="3" AutomationProperties.AutomationId="RightSplitter" Visibility="Collapsed" />
            <controls:PanelDockArea x:Name="RightPanel" Grid.RowSpan="3" Grid.Column="4" AutomationProperties.AutomationId="RightPanel" Visibility="Collapsed" />
        </Grid>

        <!--  コマンドパレット (UI-17)。タイトルバーの下の中央に重ねる。モーダルにしない。  -->
        <controls:CommandPalette
            x:Name="Palette"
            Grid.Row="1"
            Grid.RowSpan="4"
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Canvas.ZIndex="10"
            AutomationProperties.AutomationId="CommandPalette"
            Visibility="Collapsed" />

        <!--
            ステータスバー (UI-06)。項目はボタンで、クリック・Enter で対応する操作をする。← / → で項目間を移動できる。
            幅が足りないときは優先度の低い項目から隠す (コードビハインドの UpdateStatusBarLayout)。
        -->
        <Grid
            x:Name="StatusBar"
            Grid.Row="5"
            MinHeight="28"
            Padding="8,0"
            AutomationProperties.AutomationId="StatusBar"
            AutomationProperties.LandmarkType="Custom"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            SizeChanged="StatusBar_SizeChanged">
            <Grid.Resources>
                <Style x:Key="StatusItemStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Resources>
            <Grid.ContextFlyout>
                <MenuFlyout x:Name="StatusItemsMenu" />
            </Grid.ContextFlyout>
            <StackPanel
                x:Name="StatusItems"
                Orientation="Horizontal"
                TabFocusNavigation="Once"
                XYFocusKeyboardNavigation="Enabled">
                <Button x:Name="StatusCursor" AutomationProperties.AutomationId="Status_Offset" Click="StatusCursor_Click" Content="{x:Bind Vm.Selected.CursorText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="cursor" />
                <Button x:Name="StatusValue" AutomationProperties.AutomationId="Status_Value" Content="{x:Bind Vm.Selected.ValueText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="value" />
                <Button x:Name="StatusSelection" AutomationProperties.AutomationId="Status_Selection" Content="{x:Bind Vm.Selected.SelectionText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="selection" ToolTipService.ToolTip="{x:Bind Vm.Selected.SelectionToolTip, Mode=OneWay, FallbackValue=''}" />
                <Button x:Name="StatusColumn" AutomationProperties.AutomationId="Status_Column" Click="StatusColumn_Click" Content="{x:Bind Vm.Selected.ColumnText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="column" />
                <Button x:Name="StatusEncoding" AutomationProperties.AutomationId="Status_Encoding" Click="StatusEncoding_Click" Content="{x:Bind Vm.Selected.EncodingText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="encoding" />
                <Button x:Name="StatusMode" AutomationProperties.AutomationId="Status_Mode" Click="StatusMode_Click" Content="{x:Bind Vm.Selected.ModeText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="mode" />
                <Button x:Name="StatusModified" AutomationProperties.AutomationId="Status_Modified" Content="{x:Bind Vm.Selected.ModifiedText, Mode=OneWay, FallbackValue=''}" IsTabStop="False" Style="{StaticResource StatusItemStyle}" Tag="modified" />
                <Button x:Name="StatusSize" AutomationProperties.AutomationId="Status_Size" Click="StatusSize_Click" Content="{x:Bind Vm.Selected.SizeText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="size" />
                <Button x:Name="StatusOperations" AutomationProperties.AutomationId="Status_Operations" Style="{StaticResource StatusItemStyle}" Tag="operations">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="StatusOperationsText" VerticalAlignment="Center" />
                        <ProgressBar x:Name="StatusOperationsProgress" Width="80" VerticalAlignment="Center" Maximum="1" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ProcessingCenterFlyout" Placement="TopEdgeAlignedRight">
                            <controls:ProcessingCenter x:Name="ProcessingCenter" Width="420" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="NotificationHistoryButton"
                    x:Uid="Status_Notifications"
                    AutomationProperties.AutomationId="Status_Notifications"
                    Style="{StaticResource StatusItemStyle}"
                    Tag="notifications">
                    <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                    <Button.Flyout>
                        <Flyout x:Name="NotificationHistoryFlyout" Placement="TopEdgeAlignedRight">
                            <StackPanel Width="420" Spacing="8">
                                <TextBlock x:Uid="Notifications_HistoryTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ListView
                                    MaxHeight="400"
                                    AutomationProperties.AutomationId="Notifications_History"
                                    ItemsSource="{x:Bind Vm.Notifications.History}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="notifications:NotificationHistoryItem">
                                            <StackPanel Padding="0,4">
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind local:MainWindow.FormatHistoryTime(Time)}" />
                                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!--  幅が足りないときに隠した項目 (UI-06 の仕様 5)。  -->
                <Button
                    x:Name="StatusMore"
                    x:Uid="Status_More"
                    AutomationProperties.AutomationId="Status_More"
                    Click="StatusMore_Click"
                    Style="{StaticResource StatusItemStyle}"
                    Tag="more"
                    Visibility="Collapsed">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
