<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HexEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HexEditor.App.Controls"
    xmlns:vm="using:HexEditor.App.ViewModels"
    Title="HexEditor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="HexEditor">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <MenuBar Grid.Row="1" AutomationProperties.AutomationId="MainMenu">
            <MenuBarItem x:Uid="Menu_File">
                <MenuFlyoutItem x:Uid="Menu_File_New" AutomationProperties.AutomationId="Command_New" Click="New_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_File_Open" AutomationProperties.AutomationId="Command_Open" Click="Open_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="Menu_File_Save" AutomationProperties.AutomationId="Command_Save" Click="Save_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_File_SaveAs" AutomationProperties.AutomationId="Command_SaveAs" Click="SaveAs_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="Menu_File_Close" AutomationProperties.AutomationId="Command_Close" Click="Close_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_File_Exit" AutomationProperties.AutomationId="Command_Exit" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="Menu_Edit">
                <MenuFlyoutItem x:Uid="Menu_Edit_Undo" AutomationProperties.AutomationId="Command_Undo" Click="Undo_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_Edit_Redo" AutomationProperties.AutomationId="Command_Redo" Click="Redo_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control" />
                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="Menu_Edit_SelectAll" AutomationProperties.AutomationId="Command_SelectAll" Click="SelectAll_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_Edit_ToggleInsert" AutomationProperties.AutomationId="Command_ToggleInsert" Click="ToggleInsert_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="Menu_Search">
                <MenuFlyoutItem x:Uid="Menu_Search_Find" AutomationProperties.AutomationId="Command_Find" Click="Find_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_Search_Next" AutomationProperties.AutomationId="Command_FindNext" Click="FindNext_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_Search_Previous" AutomationProperties.AutomationId="Command_FindPrevious" Click="FindPrevious_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" Modifiers="Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem x:Uid="Menu_Go">
                <MenuFlyoutItem x:Uid="Menu_Go_GoTo" AutomationProperties.AutomationId="Command_GoTo" Click="GoTo_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="G" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_Go_Back" AutomationProperties.AutomationId="Command_GoBack" Click="GoBack_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="Menu_Go_Forward" AutomationProperties.AutomationId="Command_GoForward" Click="GoForward_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="Menu_Go_Start" AutomationProperties.AutomationId="Command_GoStart" Click="GoStart_Click" />
                <MenuFlyoutItem x:Uid="Menu_Go_End" AutomationProperties.AutomationId="Command_GoEnd" Click="GoEnd_Click" />
            </MenuBarItem>
        </MenuBar>

        <InfoBar
            x:Name="Notice"
            Grid.Row="2"
            AutomationProperties.AutomationId="Notice"
            IsOpen="False"
            Severity="Warning" />

        <controls:FindBar
            x:Name="FindBar"
            Grid.Row="3"
            AutomationProperties.AutomationId="FindBar"
            Closed="Bar_Closed"
            Visibility="Collapsed" />

        <controls:GoToBar
            x:Name="GoToBar"
            Grid.Row="3"
            AutomationProperties.AutomationId="GoToBar"
            Closed="Bar_Closed"
            Visibility="Collapsed" />

        <TabView
            x:Name="Tabs"
            Grid.Row="4"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            AutomationProperties.AutomationId="DocumentTabs"
            SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
            TabCloseRequested="Tabs_TabCloseRequested"
            TabItemsSource="{x:Bind Vm.Documents}"
            VerticalAlignment="Stretch">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:DocumentViewModel">
                    <TabViewItem Header="{x:Bind Header, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                        <TabViewItem.IconSource>
                            <SymbolIconSource Symbol="Document" />
                        </TabViewItem.IconSource>
                        <controls:HexView Editor="{x:Bind Editor}" EditRejected="HexView_EditRejected" Loaded="HexView_Loaded" />
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <Grid
            Grid.Row="5"
            Padding="12,4"
            AutomationProperties.AutomationId="StatusBar"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock AutomationProperties.AutomationId="Status_Offset" Text="{x:Bind Vm.Selected.CursorText, Mode=OneWay, FallbackValue=''}" />
            <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Status_Selection" Text="{x:Bind Vm.Selected.SelectionText, Mode=OneWay, FallbackValue=''}" />
            <TextBlock Grid.Column="3" AutomationProperties.AutomationId="Status_Modified" Text="{x:Bind Vm.Selected.ModifiedText, Mode=OneWay, FallbackValue=''}" />
            <TextBlock Grid.Column="4" AutomationProperties.AutomationId="Status_Column" Text="{x:Bind Vm.Selected.ColumnText, Mode=OneWay, FallbackValue=''}" />
            <TextBlock Grid.Column="5" AutomationProperties.AutomationId="Status_Mode" Text="{x:Bind Vm.Selected.ModeText, Mode=OneWay, FallbackValue=''}" />
            <TextBlock Grid.Column="6" AutomationProperties.AutomationId="Status_Length" Text="{x:Bind Vm.Selected.LengthText, Mode=OneWay, FallbackValue=''}" />
        </Grid>
    </Grid>
</Window>
