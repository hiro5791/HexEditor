<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HexEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HexEditor.App.Controls"
    xmlns:local="using:HexEditor.App"
    xmlns:notifications="using:HexEditor.Core.Notifications"
    xmlns:vm="using:HexEditor.App.ViewModels"
    Title="HexEditor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            タイトルバー (UI-02): アイコン、メニューバー (UI-03)、タイトルの順。TitleBar は Content の対話する要素を
            ドラッグ領域から除く。タイトルは自分で表示する (TitleBar の Title はメニューより前に出るため)。
        -->
        <TitleBar x:Name="AppTitleBar" Height="48">
            <TitleBar.LeftHeader>
                <Grid Padding="12,0,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
                <MenuBar x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AutomationId="MainMenu">
                    <MenuBarItem x:Uid="Menu_File">
                        <MenuFlyoutItem x:Uid="Menu_File_New" AutomationProperties.AutomationId="Command_New" Click="New_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_File_NewWithSize" AutomationProperties.AutomationId="Command_NewWithSize" Click="NewWithSize_Click" />
                        <MenuFlyoutItem x:Uid="Menu_File_Open" AutomationProperties.AutomationId="Command_Open" Click="Open_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_Save" AutomationProperties.AutomationId="Command_Save" Click="Save_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_File_SaveAs" AutomationProperties.AutomationId="Command_SaveAs" Click="SaveAs_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_SaveAll" AutomationProperties.AutomationId="Command_SaveAll" Click="SaveAll_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_Close" AutomationProperties.AutomationId="Command_Close" Click="Close_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="W" Modifiers="Control" />
                                <KeyboardAccelerator Key="F4" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_File_CloseAll" AutomationProperties.AutomationId="Command_CloseAll" Click="CloseAll_Click" />
                        <MenuFlyoutItem x:Uid="Menu_File_Exit" AutomationProperties.AutomationId="Command_Exit" Click="Exit_Click" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Edit">
                        <MenuFlyoutItem x:Uid="Menu_Edit_Undo" AutomationProperties.AutomationId="Command_Undo" Click="Undo_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Z" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_Edit_Redo" AutomationProperties.AutomationId="Command_Redo" Click="Redo_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Y" Modifiers="Control" />
                                <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Cut" AutomationProperties.AutomationId="Command_Cut" Click="Cut_Click" KeyboardAcceleratorTextOverride="Ctrl+X" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Copy" AutomationProperties.AutomationId="Command_Copy" Click="Copy_Click" KeyboardAcceleratorTextOverride="Ctrl+C" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Paste" AutomationProperties.AutomationId="Command_Paste" Click="Paste_Click" KeyboardAcceleratorTextOverride="Ctrl+V" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_PasteOverwrite" AutomationProperties.AutomationId="Command_PasteOverwrite" Click="PasteOverwrite_Click" KeyboardAcceleratorTextOverride="Ctrl+B" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_SelectAll" AutomationProperties.AutomationId="Command_SelectAll" Click="SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_ToggleInsert" AutomationProperties.AutomationId="Command_ToggleInsert" Click="ToggleInsert_Click" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Search">
                        <MenuFlyoutItem x:Uid="Menu_Search_Find" AutomationProperties.AutomationId="Command_Find" Click="Find_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_Search_Next" AutomationProperties.AutomationId="Command_FindNext" Click="FindNext_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F3" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_Search_Previous" AutomationProperties.AutomationId="Command_FindPrevious" Click="FindPrevious_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F3" Modifiers="Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Go">
                        <MenuFlyoutItem x:Uid="Menu_Go_GoTo" AutomationProperties.AutomationId="Command_GoTo" Click="GoTo_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="G" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_Go_Back" AutomationProperties.AutomationId="Command_GoBack" Click="GoBack_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_Go_Forward" AutomationProperties.AutomationId="Command_GoForward" Click="GoForward_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Go_Start" AutomationProperties.AutomationId="Command_GoStart" Click="GoStart_Click" />
                        <MenuFlyoutItem x:Uid="Menu_Go_End" AutomationProperties.AutomationId="Command_GoEnd" Click="GoEnd_Click" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_View">
                        <MenuFlyoutSubItem x:Uid="Menu_View_Theme" AutomationProperties.AutomationId="Command_Theme">
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" x:Uid="Menu_View_ThemeSystem" AutomationProperties.AutomationId="Command_ThemeSystem" Click="Theme_Click" GroupName="Theme" Tag="system" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight" x:Uid="Menu_View_ThemeLight" AutomationProperties.AutomationId="Command_ThemeLight" Click="Theme_Click" GroupName="Theme" Tag="light" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" x:Uid="Menu_View_ThemeDark" AutomationProperties.AutomationId="Command_ThemeDark" Click="Theme_Click" GroupName="Theme" Tag="dark" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_View_Encoding" AutomationProperties.AutomationId="Command_Encoding">
                            <RadioMenuFlyoutItem x:Name="EncodingAscii" x:Uid="Menu_View_EncodingAscii" AutomationProperties.AutomationId="Command_EncodingAscii" Click="Encoding_Click" GroupName="Encoding" Tag="ascii" />
                            <RadioMenuFlyoutItem x:Name="EncodingAnsi" AutomationProperties.AutomationId="Command_EncodingAnsi" Click="Encoding_Click" GroupName="Encoding" Tag="ansi" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="StatusBarToggle" x:Uid="Menu_View_StatusBar" AutomationProperties.AutomationId="Command_StatusBar" Click="StatusBarToggle_Click" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Help">
                        <MenuFlyoutItem x:Uid="Menu_Help_Documentation" AutomationProperties.AutomationId="Command_Documentation" Click="Documentation_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F1" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_Help_Report" AutomationProperties.AutomationId="Command_ReportProblem" Click="ReportProblem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Help_About" AutomationProperties.AutomationId="Command_About" Click="About_Click" />
                    </MenuBarItem>
                </MenuBar>
                    <TextBlock
                        x:Name="WindowTitle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="WindowTitle"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="HexEditor"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>


        <controls:NotificationHost
            x:Name="WindowNotifications"
            Grid.Row="2"
            AutomationProperties.AutomationId="WindowNotifications"
            Center="{x:Bind Vm.Notifications}"
            OverflowClicked="Notifications_OverflowClicked"
            Scope="Window" />

        <controls:FindBar
            x:Name="FindBar"
            Grid.Row="3"
            AutomationProperties.AutomationId="FindBar"
            Closed="Bar_Closed"
            Visibility="Collapsed" />

        <controls:GoToBar
            x:Name="GoToBar"
            Grid.Row="3"
            AutomationProperties.AutomationId="GoToBar"
            Closed="Bar_Closed"
            Visibility="Collapsed" />

        <!--  スタートページ (UI-01 の仕様 2。文書が 1 つもないとき)。最近使ったファイル・初回の「はじめに」は UI-38 (フェーズ 1)。  -->
        <ScrollViewer
            x:Name="StartPage"
            Grid.Row="4"
            AutomationProperties.AutomationId="StartPage"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="720"
                Margin="24,48"
                HorizontalAlignment="Center"
                Spacing="16">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="HexEditor" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Start_Open" AutomationProperties.AutomationId="Start_Open" Click="Open_Click" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Uid="Start_New" AutomationProperties.AutomationId="Start_New" Click="New_Click" />
                </StackPanel>
                <TextBlock x:Uid="Start_DropHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <TabView
            x:Name="Tabs"
            Grid.Row="4"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            AutomationProperties.AutomationId="DocumentTabs"
            SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
            TabCloseRequested="Tabs_TabCloseRequested"
            TabItemsSource="{x:Bind Vm.Documents}"
            VerticalAlignment="Stretch">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:DocumentViewModel">
                    <TabViewItem Header="{x:Bind Header, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                        <TabViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="Tab_Close" Click="TabClose_Click" />
                                <MenuFlyoutItem x:Uid="Tab_CloseOthers" Click="TabCloseOthers_Click" />
                                <MenuFlyoutItem x:Uid="Tab_CloseRight" Click="TabCloseRight_Click" />
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>
                        <TabViewItem.IconSource>
                            <SymbolIconSource Symbol="Document" />
                        </TabViewItem.IconSource>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <controls:NotificationHost
                                AutomationProperties.AutomationId="DocumentNotifications"
                                Center="{x:Bind Notifications}"
                                Owner="{x:Bind}"
                                Scope="Document" />
                            <controls:HexView
                                Grid.Row="1"
                                CommandRequested="HexView_CommandRequested"
                                Editor="{x:Bind Editor}"
                                EditRejected="HexView_EditRejected"
                                Loaded="HexView_Loaded" />
                        </Grid>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!--
            ステータスバー (UI-06)。項目はボタンで、クリック・Enter で対応する操作をする。← / → で項目間を移動できる。
            幅が足りないときは優先度の低い項目から隠す (コードビハインドの UpdateStatusBarLayout)。
        -->
        <Grid
            x:Name="StatusBar"
            Grid.Row="5"
            MinHeight="28"
            Padding="8,0"
            AutomationProperties.AutomationId="StatusBar"
            AutomationProperties.LandmarkType="Custom"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            SizeChanged="StatusBar_SizeChanged">
            <Grid.Resources>
                <Style x:Key="StatusItemStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Resources>
            <Grid.ContextFlyout>
                <MenuFlyout x:Name="StatusItemsMenu" />
            </Grid.ContextFlyout>
            <StackPanel
                x:Name="StatusItems"
                Orientation="Horizontal"
                TabFocusNavigation="Once"
                XYFocusKeyboardNavigation="Enabled">
                <Button x:Name="StatusCursor" AutomationProperties.AutomationId="Status_Offset" Click="StatusCursor_Click" Content="{x:Bind Vm.Selected.CursorText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="cursor" />
                <Button x:Name="StatusValue" AutomationProperties.AutomationId="Status_Value" Content="{x:Bind Vm.Selected.ValueText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="value" />
                <Button x:Name="StatusSelection" AutomationProperties.AutomationId="Status_Selection" Content="{x:Bind Vm.Selected.SelectionText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="selection" ToolTipService.ToolTip="{x:Bind Vm.Selected.SelectionToolTip, Mode=OneWay, FallbackValue=''}" />
                <Button x:Name="StatusColumn" AutomationProperties.AutomationId="Status_Column" Click="StatusColumn_Click" Content="{x:Bind Vm.Selected.ColumnText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="column" />
                <Button x:Name="StatusEncoding" AutomationProperties.AutomationId="Status_Encoding" Click="StatusEncoding_Click" Content="{x:Bind Vm.Selected.EncodingText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="encoding" />
                <Button x:Name="StatusMode" AutomationProperties.AutomationId="Status_Mode" Click="StatusMode_Click" Content="{x:Bind Vm.Selected.ModeText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="mode" />
                <Button x:Name="StatusModified" AutomationProperties.AutomationId="Status_Modified" Content="{x:Bind Vm.Selected.ModifiedText, Mode=OneWay, FallbackValue=''}" IsTabStop="False" Style="{StaticResource StatusItemStyle}" Tag="modified" />
                <Button x:Name="StatusSize" AutomationProperties.AutomationId="Status_Size" Click="StatusSize_Click" Content="{x:Bind Vm.Selected.SizeText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="size" />
                <Button x:Name="StatusOperations" AutomationProperties.AutomationId="Status_Operations" Style="{StaticResource StatusItemStyle}" Tag="operations">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="StatusOperationsText" VerticalAlignment="Center" />
                        <ProgressBar x:Name="StatusOperationsProgress" Width="80" VerticalAlignment="Center" Maximum="1" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ProcessingCenterFlyout" Placement="TopEdgeAlignedRight">
                            <controls:ProcessingCenter x:Name="ProcessingCenter" Width="420" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="NotificationHistoryButton"
                    x:Uid="Status_Notifications"
                    AutomationProperties.AutomationId="Status_Notifications"
                    Style="{StaticResource StatusItemStyle}"
                    Tag="notifications">
                    <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                    <Button.Flyout>
                        <Flyout x:Name="NotificationHistoryFlyout" Placement="TopEdgeAlignedRight">
                            <StackPanel Width="420" Spacing="8">
                                <TextBlock x:Uid="Notifications_HistoryTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ListView
                                    MaxHeight="400"
                                    AutomationProperties.AutomationId="Notifications_History"
                                    ItemsSource="{x:Bind Vm.Notifications.History}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="notifications:NotificationHistoryItem">
                                            <StackPanel Padding="0,4">
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind local:MainWindow.FormatHistoryTime(Time)}" />
                                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
