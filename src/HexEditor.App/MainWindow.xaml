<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HexEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cmd="using:HexEditor.App.Commands"
    xmlns:controls="using:HexEditor.App.Controls"
    xmlns:local="using:HexEditor.App"
    xmlns:notifications="using:HexEditor.Core.Notifications"
    xmlns:vm="using:HexEditor.App.ViewModels"
    Title="HexEditor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!--  「すべて表示…」の一覧の行 (UI-32 の仕様 4): ファイル名、フォルダ、サイズ、最後に開いた日時。  -->
            <DataTemplate x:Key="RecentAllItemTemplate" x:DataType="vm:RecentEntryViewModel">
                <Grid
                    Padding="0,6"
                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                    ColumnSpacing="12"
                    Opacity="{x:Bind Opacity, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Path}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FlowDirection="LeftToRight"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Folder}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{x:Bind SizeText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Text="{x:Bind LastOpened}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            タイトルバー (UI-02): アイコン、メニューバー (UI-03)、タイトルの順。TitleBar は Content の対話する要素を
            ドラッグ領域から除く。タイトルは自分で表示する (TitleBar の Title はメニューより前に出るため)。
        -->
        <!--  タイトルバー自体はフォーカスを受けない (枠の出ないフォーカスの止まり先を作らない。UI-52 の仕様 6)。  -->
        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            AutomationProperties.AutomationId="TitleBar"
            IsTabStop="False">
            <TitleBar.LeftHeader>
                <Grid Padding="12,0,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        AutomationProperties.AutomationId="TitleBar_Icon"
                        Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
                <!--
                    メニューバー (UI-03)。各項目はコマンド (UI-16) を cmd:CommandUi.Id で参照する。クリック・ショートカットの表示・
                    有効状態は MenuBinder がコマンドから取る (キーの振り分けは KeyDispatcher。KeyboardAccelerator は置かない)。
                -->
                <MenuBar x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AutomationId="MainMenu">
                    <MenuBarItem x:Uid="Menu_File">
                        <MenuFlyoutItem x:Uid="Menu_File_New" cmd:CommandUi.Id="file.new" AutomationProperties.AutomationId="Command_New" />
                        <MenuFlyoutItem x:Uid="Menu_File_NewWithSize" cmd:CommandUi.Id="file.newWithSize" AutomationProperties.AutomationId="Command_NewWithSize" />
                        <MenuFlyoutItem x:Uid="Menu_File_Open" cmd:CommandUi.Id="file.open" AutomationProperties.AutomationId="Command_Open" />
                        <!--  読み取り専用で開く (ENG-14 の仕様 1)。標準のダイアログにチェックボックスを置けないため、別の項目にする。  -->
                        <MenuFlyoutItem x:Uid="Menu_File_OpenReadOnly" cmd:CommandUi.Id="file.openReadOnly" AutomationProperties.AutomationId="Command_OpenReadOnly" />
                        <!--  詳細を指定して開く (ENG-11 の仕様 2)、選択範囲を新しいタブで開く (ENG-39)  -->
                        <MenuFlyoutItem x:Uid="Menu_File_OpenAdvanced" cmd:CommandUi.Id="file.openAdvanced" AutomationProperties.AutomationId="Command_OpenAdvanced" />
                        <MenuFlyoutSubItem x:Uid="Menu_File_OpenSelection" AutomationProperties.AutomationId="Command_OpenSelection">
                            <MenuFlyoutItem x:Uid="Menu_File_OpenSelectionLinked" cmd:CommandUi.Id="file.openSelectionInNewTab" AutomationProperties.AutomationId="Command_OpenSelectionInNewTab" />
                            <MenuFlyoutItem x:Uid="Menu_File_OpenSelectionCopy" cmd:CommandUi.Id="file.openSelectionAsCopy" AutomationProperties.AutomationId="Command_OpenSelectionAsCopy" />
                        </MenuFlyoutSubItem>
                        <!--  新しいウィンドウ (UI-14)  -->
                        <MenuFlyoutItem x:Uid="Menu_File_NewWindow" cmd:CommandUi.Id="window.new" AutomationProperties.AutomationId="Command_NewWindow" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_Save" cmd:CommandUi.Id="file.save" AutomationProperties.AutomationId="Command_Save" />
                        <MenuFlyoutItem x:Uid="Menu_File_SaveAs" cmd:CommandUi.Id="file.saveAs" AutomationProperties.AutomationId="Command_SaveAs" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_SaveAll" cmd:CommandUi.Id="file.saveAll" AutomationProperties.AutomationId="Command_SaveAll" />
                        <!--  インポート / エクスポート (TOOL-04)、範囲の切り出しと保存 (TOOL-16)、ワークスペース (UI-33)  -->
                        <MenuFlyoutItem x:Uid="Menu_File_Import" cmd:CommandUi.Id="file.import" AutomationProperties.AutomationId="Command_Import" />
                        <MenuFlyoutSubItem x:Uid="Menu_File_Export" AutomationProperties.AutomationId="Command_ExportMenu">
                            <MenuFlyoutItem x:Uid="Menu_File_ExportDialog" cmd:CommandUi.Id="file.export" AutomationProperties.AutomationId="Command_Export" />
                            <MenuFlyoutItem x:Uid="Menu_File_ExportSelection" cmd:CommandUi.Id="file.exportSelection" AutomationProperties.AutomationId="Command_ExportSelection" />
                            <MenuFlyoutItem x:Uid="Menu_File_SaveSelection" cmd:CommandUi.Id="file.saveSelection" AutomationProperties.AutomationId="Command_SaveSelection" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_File_Workspace" AutomationProperties.AutomationId="Command_WorkspaceMenu">
                            <MenuFlyoutItem x:Uid="Menu_File_WorkspaceSave" cmd:CommandUi.Id="workspace.save" AutomationProperties.AutomationId="Command_WorkspaceSave" />
                            <MenuFlyoutItem x:Uid="Menu_File_WorkspaceOpen" cmd:CommandUi.Id="workspace.open" AutomationProperties.AutomationId="Command_WorkspaceOpen" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <!--  再読み込みと変更の破棄 (ENG-18)  -->
                        <MenuFlyoutItem x:Uid="Menu_File_Reload" cmd:CommandUi.Id="file.reload" AutomationProperties.AutomationId="Command_Reload" />
                        <MenuFlyoutItem x:Uid="Menu_File_DiscardReload" cmd:CommandUi.Id="file.discardReload" AutomationProperties.AutomationId="Command_DiscardReload" />
                        <MenuFlyoutSeparator />
                        <!--
                            最近使ったファイル (UI-32 の仕様 3): ピン留めした項目、最近の 10 件、閉じたタブを開き直す (UI-12)、一覧を消去、すべて表示。
                            ファイルの項目はコードビハインドで先頭に並べる。Ctrl+Shift+T などのキーは KeyDispatcher が受ける (サブメニューを開かなくても働く)。
                        -->
                        <MenuFlyoutSubItem x:Name="RecentMenu" x:Uid="Menu_File_Recent" AutomationProperties.AutomationId="Command_Recent">
                            <MenuFlyoutSeparator x:Name="RecentMenuSeparator" />
                            <MenuFlyoutItem x:Uid="Menu_File_ReopenClosed" cmd:CommandUi.Id="file.reopenClosed" AutomationProperties.AutomationId="Command_ReopenClosedTab" />
                            <MenuFlyoutItem x:Uid="Menu_File_ClearRecent" cmd:CommandUi.Id="file.recent.clear" AutomationProperties.AutomationId="Command_ClearRecent" />
                            <MenuFlyoutItem x:Uid="Menu_File_ShowAllRecent" cmd:CommandUi.Id="file.recent.showAll" AutomationProperties.AutomationId="Command_ShowAllRecent" />
                        </MenuFlyoutSubItem>
                        <!--  インポート / エクスポート (INSP-30 のブックマーク)  -->
                        <MenuFlyoutSubItem x:Uid="Menu_File_ImportExport" AutomationProperties.AutomationId="Command_ImportExport">
                            <MenuFlyoutItem x:Uid="Menu_File_ImportBookmarks" cmd:CommandUi.Id="file.importBookmarks" AutomationProperties.AutomationId="Command_ImportBookmarks" />
                            <MenuFlyoutItem x:Uid="Menu_File_ExportBookmarks" cmd:CommandUi.Id="file.exportBookmarks" AutomationProperties.AutomationId="Command_ExportBookmarks" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_File_Close" cmd:CommandUi.Id="file.close" AutomationProperties.AutomationId="Command_Close" />
                        <MenuFlyoutItem x:Uid="Menu_File_CloseAll" cmd:CommandUi.Id="file.closeAll" AutomationProperties.AutomationId="Command_CloseAll" />
                        <MenuFlyoutItem x:Uid="Menu_File_Exit" cmd:CommandUi.Id="file.exit" AutomationProperties.AutomationId="Command_Exit" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Edit">
                        <MenuFlyoutItem x:Uid="Menu_Edit_Undo" cmd:CommandUi.Id="edit.undo" AutomationProperties.AutomationId="Command_Undo" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Redo" cmd:CommandUi.Id="edit.redo" AutomationProperties.AutomationId="Command_Redo" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Cut" cmd:CommandUi.Id="edit.cut" AutomationProperties.AutomationId="Command_Cut" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Copy" cmd:CommandUi.Id="edit.copy" AutomationProperties.AutomationId="Command_Copy" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_CopyAs" cmd:CommandUi.Id="edit.copyAs" AutomationProperties.AutomationId="Command_CopyAs" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_CopyAsLast" cmd:CommandUi.Id="edit.copyAsLast" AutomationProperties.AutomationId="Command_CopyAsLast" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Paste" cmd:CommandUi.Id="edit.paste" AutomationProperties.AutomationId="Command_Paste" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_PasteOverwrite" cmd:CommandUi.Id="edit.pasteOverwrite" AutomationProperties.AutomationId="Command_PasteOverwrite" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_PasteSpecial" cmd:CommandUi.Id="edit.pasteSpecial" AutomationProperties.AutomationId="Command_PasteSpecial" />
                        <!--  ユーザークリップボード (EDIT-28)。番号 1〜9 の項目はコードで作る。  -->
                        <MenuFlyoutSubItem x:Uid="Menu_Edit_UserClipboard" AutomationProperties.AutomationId="Command_UserClipboardMenu">
                            <MenuFlyoutSubItem x:Name="UserCopyMenu" x:Uid="Menu_UserClipboard_Copy" AutomationProperties.AutomationId="Command_UserClipboardCopy" />
                            <MenuFlyoutSubItem x:Name="UserPasteMenu" x:Uid="Menu_UserClipboard_Paste" AutomationProperties.AutomationId="Command_UserClipboardPaste" />
                            <MenuFlyoutItem x:Uid="Menu_UserClipboard_History" cmd:CommandUi.Id="edit.clipboardHistory.paste" AutomationProperties.AutomationId="Command_ClipboardHistoryPaste" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_SelectAll" cmd:CommandUi.Id="edit.selectAll" AutomationProperties.AutomationId="Command_SelectAll" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_SelectRange" cmd:CommandUi.Id="edit.selectRange" AutomationProperties.AutomationId="Command_SelectRange" />
                        <!--  選択 (EDIT-05〜EDIT-09、EDIT-17)  -->
                        <MenuFlyoutSubItem x:Uid="Menu_Edit_Selection" AutomationProperties.AutomationId="Command_SelectionMenu">
                            <MenuFlyoutItem x:Uid="Menu_Selection_ShiftNext" cmd:CommandUi.Id="edit.selection.shiftNext" AutomationProperties.AutomationId="Command_Selection_ShiftNext" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_ShiftPrevious" cmd:CommandUi.Id="edit.selection.shiftPrevious" AutomationProperties.AutomationId="Command_Selection_ShiftPrevious" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_ShiftBy" cmd:CommandUi.Id="edit.selection.shiftBy" AutomationProperties.AutomationId="Command_Selection_ShiftBy" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_Resize" cmd:CommandUi.Id="edit.selection.resize" AutomationProperties.AutomationId="Command_Selection_Resize" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_SwapEnds" cmd:CommandUi.Id="edit.selection.swapEnds" AutomationProperties.AutomationId="Command_Selection_SwapEnds" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_Selection_Invert" cmd:CommandUi.Id="edit.selection.invert" AutomationProperties.AutomationId="Command_Selection_Invert" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_NextElement" cmd:CommandUi.Id="edit.selection.nextElement" AutomationProperties.AutomationId="Command_Selection_NextElement" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_PreviousElement" cmd:CommandUi.Id="edit.selection.previousElement" AutomationProperties.AutomationId="Command_Selection_PreviousElement" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_ToMulti" cmd:CommandUi.Id="edit.selection.toMulti" AutomationProperties.AutomationId="Command_Selection_ToMulti" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_StartRectangle" cmd:CommandUi.Id="edit.selection.startRectangle" AutomationProperties.AutomationId="Command_Selection_StartRectangle" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_InsertRectangle" cmd:CommandUi.Id="edit.insertRectangle" AutomationProperties.AutomationId="Command_Selection_InsertRectangle" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_Selection_CaretsAtElements" cmd:CommandUi.Id="edit.caret.atElements" AutomationProperties.AutomationId="Command_Selection_CaretsAtElements" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_AddCaretAbove" cmd:CommandUi.Id="edit.caret.addAbove" AutomationProperties.AutomationId="Command_Selection_AddCaretAbove" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_AddCaretBelow" cmd:CommandUi.Id="edit.caret.addBelow" AutomationProperties.AutomationId="Command_Selection_AddCaretBelow" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_Selection_Save" cmd:CommandUi.Id="edit.selection.save" AutomationProperties.AutomationId="Command_Selection_Save" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_Load" cmd:CommandUi.Id="edit.selection.load" AutomationProperties.AutomationId="Command_Selection_Load" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_Export" cmd:CommandUi.Id="edit.selection.export" AutomationProperties.AutomationId="Command_Selection_Export" />
                            <MenuFlyoutItem x:Uid="Menu_Selection_Import" cmd:CommandUi.Id="edit.selection.import" AutomationProperties.AutomationId="Command_Selection_Import" />
                        </MenuFlyoutSubItem>
                        <!--  選択範囲をブックマークに (INSP-28)  -->
                        <MenuFlyoutItem x:Uid="Menu_Edit_SelectionToBookmarks" cmd:CommandUi.Id="edit.selectionToBookmarks" AutomationProperties.AutomationId="Command_SelectionToBookmarks" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_InsertBytes" cmd:CommandUi.Id="edit.insertBytes" AutomationProperties.AutomationId="Command_InsertBytes" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_InsertFile" cmd:CommandUi.Id="edit.insertFile" AutomationProperties.AutomationId="Command_InsertFile" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Fill" cmd:CommandUi.Id="edit.fill" AutomationProperties.AutomationId="Command_Fill" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Resize" cmd:CommandUi.Id="edit.resize" AutomationProperties.AutomationId="Command_Resize" />
                        <MenuFlyoutItem x:Uid="Menu_Edit_Truncate" cmd:CommandUi.Id="edit.truncate" AutomationProperties.AutomationId="Command_TruncateAtCursor" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Edit_ToggleInsert" cmd:CommandUi.Id="edit.toggleInsert" AutomationProperties.AutomationId="Command_ToggleInsert" />
                        <ToggleMenuFlyoutItem x:Name="ReadOnlyToggle" x:Uid="Menu_Edit_ReadOnly" cmd:CommandUi.Id="edit.readOnly" AutomationProperties.AutomationId="Command_ReadOnly" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Search">
                        <MenuFlyoutItem x:Uid="Menu_Search_Find" cmd:CommandUi.Id="search.find" AutomationProperties.AutomationId="Command_Find" />
                        <MenuFlyoutItem x:Uid="Menu_Search_Next" cmd:CommandUi.Id="search.findNext" AutomationProperties.AutomationId="Command_FindNext" />
                        <MenuFlyoutItem x:Uid="Menu_Search_Previous" cmd:CommandUi.Id="search.findPrevious" AutomationProperties.AutomationId="Command_FindPrevious" />
                        <MenuFlyoutItem x:Uid="Menu_Search_Replace" cmd:CommandUi.Id="search.replace" AutomationProperties.AutomationId="Command_Replace" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Search_MultiFile" cmd:CommandUi.Id="search.multiFile" AutomationProperties.AutomationId="Command_MultiFileSearch" />
                        <MenuFlyoutItem x:Uid="Menu_Search_Strings" cmd:CommandUi.Id="search.strings" AutomationProperties.AutomationId="Command_Strings" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Search_ClearHistory" cmd:CommandUi.Id="search.clearHistory" AutomationProperties.AutomationId="Command_ClearSearchHistory" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Go">
                        <MenuFlyoutItem x:Uid="Menu_Go_GoTo" cmd:CommandUi.Id="go.goTo" AutomationProperties.AutomationId="Command_GoTo" />
                        <MenuFlyoutItem x:Uid="Menu_Go_Back" cmd:CommandUi.Id="go.back" AutomationProperties.AutomationId="Command_GoBack" />
                        <MenuFlyoutItem x:Uid="Menu_Go_Forward" cmd:CommandUi.Id="go.forward" AutomationProperties.AutomationId="Command_GoForward" />
                        <MenuFlyoutSeparator />
                        <!--  ブックマーク (INSP-23〜INSP-26)。番号付きの項目はコードビハインドで作る (go.bookmark.set1〜9、go.bookmark.goto1〜9)。  -->
                        <MenuFlyoutSubItem x:Uid="Menu_Go_Bookmarks" AutomationProperties.AutomationId="Command_Bookmarks">
                            <MenuFlyoutItem x:Uid="Menu_Go_ToggleBookmark" cmd:CommandUi.Id="go.bookmark.toggle" AutomationProperties.AutomationId="Command_ToggleBookmark" />
                            <MenuFlyoutItem x:Uid="Menu_Go_NextBookmark" cmd:CommandUi.Id="go.bookmark.next" AutomationProperties.AutomationId="Command_NextBookmark" />
                            <MenuFlyoutItem x:Uid="Menu_Go_PreviousBookmark" cmd:CommandUi.Id="go.bookmark.previous" AutomationProperties.AutomationId="Command_PreviousBookmark" />
                            <MenuFlyoutItem x:Uid="Menu_Go_EditBookmark" cmd:CommandUi.Id="go.bookmark.edit" AutomationProperties.AutomationId="Command_EditBookmark" />
                            <MenuFlyoutItem x:Uid="Menu_Go_BookmarkList" cmd:CommandUi.Id="go.bookmark.list" AutomationProperties.AutomationId="Command_BookmarkList" />
                            <!--  位置マネージャ・カーソル位置の説明 (INSP-31)、ブックマークを選択範囲に (INSP-28)  -->
                            <MenuFlyoutItem x:Uid="Menu_Go_PositionManager" cmd:CommandUi.Id="view.panel.positionManager" AutomationProperties.AutomationId="Command_PositionManager" />
                            <MenuFlyoutItem x:Uid="Menu_Go_ShowDescription" cmd:CommandUi.Id="go.bookmark.showDescription" AutomationProperties.AutomationId="Command_ShowDescription" />
                            <MenuFlyoutItem x:Uid="Menu_Go_BookmarksToSelection" cmd:CommandUi.Id="go.bookmark.toSelection" AutomationProperties.AutomationId="Command_BookmarksToSelection" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Name="NumberedSetMenu" x:Uid="Menu_Go_NumberedSet" AutomationProperties.AutomationId="Command_NumberedSet" />
                            <MenuFlyoutSubItem x:Name="NumberedGoMenu" x:Uid="Menu_Go_NumberedGo" AutomationProperties.AutomationId="Command_NumberedGo" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <!--  次 / 前の差分 (ANA-05)  -->
                        <MenuFlyoutItem x:Uid="Menu_Go_NextDiff" cmd:CommandUi.Id="compare.nextDiff" AutomationProperties.AutomationId="Command_NextDiff" />
                        <MenuFlyoutItem x:Uid="Menu_Go_PreviousDiff" cmd:CommandUi.Id="compare.previousDiff" AutomationProperties.AutomationId="Command_PreviousDiff" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Go_Start" cmd:CommandUi.Id="go.start" AutomationProperties.AutomationId="Command_GoStart" />
                        <MenuFlyoutItem x:Uid="Menu_Go_End" cmd:CommandUi.Id="go.end" AutomationProperties.AutomationId="Command_GoEnd" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_View">
                        <MenuFlyoutSubItem x:Uid="Menu_View_Theme" AutomationProperties.AutomationId="Command_Theme">
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" x:Uid="Menu_View_ThemeSystem" cmd:CommandUi.Id="view.theme.system" AutomationProperties.AutomationId="Command_ThemeSystem" GroupName="Theme" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight" x:Uid="Menu_View_ThemeLight" cmd:CommandUi.Id="view.theme.light" AutomationProperties.AutomationId="Command_ThemeLight" GroupName="Theme" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" x:Uid="Menu_View_ThemeDark" cmd:CommandUi.Id="view.theme.dark" AutomationProperties.AutomationId="Command_ThemeDark" GroupName="Theme" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_View_Encoding" AutomationProperties.AutomationId="Command_Encoding">
                            <RadioMenuFlyoutItem x:Name="EncodingAscii" x:Uid="Menu_View_EncodingAscii" cmd:CommandUi.Id="view.encoding.ascii" AutomationProperties.AutomationId="Command_EncodingAscii" GroupName="Encoding" />
                            <RadioMenuFlyoutItem x:Name="EncodingAnsi" cmd:CommandUi.Id="view.encoding.ansi" AutomationProperties.AutomationId="Command_EncodingAnsi" GroupName="Encoding" />
                        </MenuFlyoutSubItem>
                        <!--  注釈 (INSP-32): 出どころごとの表示と注釈の列。色付けルール (INSP-33・INSP-34)。  -->
                        <MenuFlyoutSubItem x:Uid="Menu_View_Annotations" AutomationProperties.AutomationId="Command_Annotations">
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_AnnotationsToggle" cmd:CommandUi.Id="view.annotations.toggle" AutomationProperties.AutomationId="Command_AnnotationsToggle" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_AnnotationsColumn" cmd:CommandUi.Id="view.annotations.column" AutomationProperties.AutomationId="Command_AnnotationsColumn" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_AnnotationsBookmark" cmd:CommandUi.Id="view.annotations.bookmark" AutomationProperties.AutomationId="Command_AnnotationsBookmark" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_AnnotationsYara" cmd:CommandUi.Id="view.annotations.yara" AutomationProperties.AutomationId="Command_AnnotationsYara" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_AnnotationsSearch" cmd:CommandUi.Id="view.annotations.searchResults" AutomationProperties.AutomationId="Command_AnnotationsSearchResults" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_AnnotationsTemplate" cmd:CommandUi.Id="view.annotations.template" AutomationProperties.AutomationId="Command_AnnotationsTemplate" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_AnnotationsScript" cmd:CommandUi.Id="view.annotations.script" AutomationProperties.AutomationId="Command_AnnotationsScript" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_View_Coloring" AutomationProperties.AutomationId="Command_Coloring">
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_ColoringRules" cmd:CommandUi.Id="view.panel.coloringRules" AutomationProperties.AutomationId="Command_ColoringRules" />
                            <MenuFlyoutItem x:Uid="Menu_View_ColoringFromSelection" cmd:CommandUi.Id="view.coloring.fromSelection" AutomationProperties.AutomationId="Command_ColoringFromSelection" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_Legend" cmd:CommandUi.Id="view.panel.legend" AutomationProperties.AutomationId="Command_Legend" />
                        </MenuFlyoutSubItem>
                        <!--  比較のレイアウト (左右 / 上下。ANA-04 の「呼び出し」)  -->
                        <ToggleMenuFlyoutItem x:Uid="Menu_View_CompareStacked" cmd:CommandUi.Id="compare.layout" AutomationProperties.AutomationId="Command_CompareLayout" />
                        <MenuFlyoutSeparator />
                        <!--  パネルの表示切り替え (UI-01 の仕様 6、UI-04、UI-05)。  -->
                        <MenuFlyoutSubItem x:Uid="Menu_View_Panels" AutomationProperties.AutomationId="Command_Panels">
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_Toolbar" cmd:CommandUi.Id="view.toolbar" AutomationProperties.AutomationId="Command_Toolbar" />
                            <ToggleMenuFlyoutItem x:Name="StatusBarToggle" x:Uid="Menu_View_StatusBar" cmd:CommandUi.Id="view.statusBar" AutomationProperties.AutomationId="Command_StatusBar" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_LeftPanel" cmd:CommandUi.Id="view.leftPanel" AutomationProperties.AutomationId="Command_LeftPanel" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_RightPanel" cmd:CommandUi.Id="view.rightPanel" AutomationProperties.AutomationId="Command_RightPanel" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_BottomPanel" cmd:CommandUi.Id="view.bottomPanel" AutomationProperties.AutomationId="Command_BottomPanel" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_Inspector" cmd:CommandUi.Id="view.panel.inspector" AutomationProperties.AutomationId="Command_ToggleInspector" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_BookmarksPanel" cmd:CommandUi.Id="view.panel.bookmarks" AutomationProperties.AutomationId="Command_ToggleBookmarks" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_Hash" cmd:CommandUi.Id="view.panel.hash" AutomationProperties.AutomationId="Command_PanelHash" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_SearchResults" cmd:CommandUi.Id="view.panel.searchResults" AutomationProperties.AutomationId="Command_ToggleSearchResults" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_HistoryPanel" cmd:CommandUi.Id="view.panel.history" AutomationProperties.AutomationId="Command_ToggleHistory" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_ClipboardPanel" cmd:CommandUi.Id="view.panel.clipboard" AutomationProperties.AutomationId="Command_ToggleClipboard" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_PositionManagerPanel" cmd:CommandUi.Id="view.panel.positionManager" AutomationProperties.AutomationId="Command_TogglePositionManager" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_ColoringRulesPanel" cmd:CommandUi.Id="view.panel.coloringRules" AutomationProperties.AutomationId="Command_ToggleColoringRules" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_LegendPanel" cmd:CommandUi.Id="view.panel.legend" AutomationProperties.AutomationId="Command_ToggleLegend" />
                            <ToggleMenuFlyoutItem x:Uid="Menu_View_Diffs" cmd:CommandUi.Id="view.panel.diffs" AutomationProperties.AutomationId="Command_ToggleDiffs" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_View_ResetPanels" cmd:CommandUi.Id="view.resetPanelLayout" AutomationProperties.AutomationId="Command_ResetPanelLayout" />
                        </MenuFlyoutSubItem>
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Analysis">
                        <!--  比較 (ANA-01、ANA-08)  -->
                        <MenuFlyoutSubItem x:Uid="Menu_Analysis_Compare" AutomationProperties.AutomationId="Command_CompareMenu">
                            <MenuFlyoutItem x:Uid="Menu_Analysis_CompareFiles" cmd:CommandUi.Id="analysis.compare" AutomationProperties.AutomationId="Command_Compare" />
                            <MenuFlyoutItem x:Uid="Menu_Analysis_CompareSaved" cmd:CommandUi.Id="analysis.compareSaved" AutomationProperties.AutomationId="Command_CompareSaved" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Uid="Menu_Analysis_Hash" cmd:CommandUi.Id="analysis.hash" AutomationProperties.AutomationId="Command_Hash" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Tools">
                        <MenuFlyoutItem x:Uid="Menu_Tools_Settings" cmd:CommandUi.Id="settings.open" AutomationProperties.AutomationId="Command_Settings" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Menu_Help">
                        <MenuFlyoutItem x:Uid="Menu_Help_CommandPalette" cmd:CommandUi.Id="help.commandPalette" AutomationProperties.AutomationId="Command_CommandPalette" />
                        <MenuFlyoutItem x:Uid="Menu_Help_Shortcuts" cmd:CommandUi.Id="help.shortcuts" AutomationProperties.AutomationId="Command_Shortcuts" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Help_Documentation" cmd:CommandUi.Id="help.documentation" AutomationProperties.AutomationId="Command_Documentation" />
                        <MenuFlyoutItem x:Uid="Menu_Help_Report" cmd:CommandUi.Id="help.reportProblem" AutomationProperties.AutomationId="Command_ReportProblem" />
                        <MenuFlyoutItem x:Uid="Menu_Help_ReportTranslation" cmd:CommandUi.Id="help.reportTranslation" AutomationProperties.AutomationId="Command_ReportTranslation" />
                        <MenuFlyoutItem x:Uid="Menu_Help_CheckForUpdates" cmd:CommandUi.Id="help.checkForUpdates" AutomationProperties.AutomationId="Command_CheckForUpdates" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_Help_About" cmd:CommandUi.Id="help.about" AutomationProperties.AutomationId="Command_About" />
                    </MenuBarItem>
                </MenuBar>
                    <TextBlock
                        x:Name="WindowTitle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="WindowTitle"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="HexEditor"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!--  ツールバー (UI-04)。既定では非表示。ボタンは設定 ui.toolbar.items からコードで作る (MainWindow.Toolbar.cs)。  -->
        <CommandBar
            x:Name="Toolbar"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="Toolbar"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True"
            OverflowButtonVisibility="Auto"
            Visibility="Collapsed">
            <CommandBar.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Toolbar_Customize" cmd:CommandUi.Id="view.customizeToolbar" AutomationProperties.AutomationId="Toolbar_Customize" />
                </MenuFlyout>
            </CommandBar.ContextFlyout>
        </CommandBar>

        <!--  更新の InfoBar (PKG-22) とアプリ全体の通知。更新の通知はボタンが 3 つまであるため通知の一覧とは別に置く。  -->
        <StackPanel Grid.Row="2">
            <controls:UpdateBar x:Name="UpdateBar" />
            <controls:NotificationHost
                x:Name="WindowNotifications"
                AutomationProperties.AutomationId="WindowNotifications"
                Center="{x:Bind Vm.Notifications}"
                OverflowClicked="Notifications_OverflowClicked"
                Scope="Window" />
        </StackPanel>

        <!--  検索バー・移動バー。すべて検索の結果一覧 (FIND-20) は下のパネル (UI-05) に置く。  -->
        <StackPanel Grid.Row="3">
            <controls:FindBar
                x:Name="FindBar"
                AutomationProperties.AutomationId="FindBar"
                Closed="Bar_Closed"
                Visibility="Collapsed" />

            <controls:GoToBar
                x:Name="GoToBar"
                AutomationProperties.AutomationId="GoToBar"
                Closed="Bar_Closed"
                Visibility="Collapsed" />

        </StackPanel>

        <!--
            作業領域 (UI-01 の仕様 1 の 4): 左パネル / エディタ / 右パネル、その下に下パネル (UI-05)。パネルの中身は
            PanelRegistry に登録したもの (MainWindow.Panels.cs)。境界は分割バー (幅 4 px、矢印キーで 8 px ずつ動く。UI-01 の仕様 5)。
        -->
        <Grid x:Name="WorkArea" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BottomRow" Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PanelDockArea x:Name="LeftPanel" Grid.RowSpan="3" AutomationProperties.AutomationId="LeftPanel" Visibility="Collapsed" />
            <controls:Splitter x:Name="LeftSplitter" Grid.RowSpan="3" Grid.Column="1" AutomationProperties.AutomationId="LeftSplitter" Visibility="Collapsed" />
            <Grid x:Name="EditorArea" Grid.Column="2">
                <!--  並べて表示 (VIEW-39): 右の列に、並べたドキュメントのビューを置く (MainWindow.SideBySide.cs)。  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorMainColumn" Width="*" />
                    <ColumnDefinition x:Name="SideBySideColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="SideBySideHost"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="SideBySideHost"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed" />
                <!--  スタートページ (UI-01 の仕様 2、UI-38。文書が 1 つもないとき)。  -->
                <controls:StartPage
                    x:Name="StartPage"
                    Canvas.ZIndex="1"
                    AutomationProperties.AutomationId="StartPage"
                    Visibility="Collapsed" />

                <TabView
                    x:Name="Tabs"
                    AddTabButtonClick="Tabs_AddTabButtonClick"
                    AutomationProperties.AutomationId="DocumentTabs"
                    TabCloseRequested="Tabs_TabCloseRequested"
                    VerticalAlignment="Stretch">
                    <!--
                        タブの項目と選択はコードで文書の一覧とつなぐ (MainWindow.TabItems.cs)。文書のタブの後ろに、設定画面などのページのタブ
                        (UI-22) を置く。
                    -->
                    <TabView.Resources>
                        <DataTemplate x:Key="DocumentTabTemplate" x:DataType="vm:DocumentViewModel">
                            <!--  タブ (UI-09): 見出しは種類のアイコンと状態の印と表示名。右クリックメニューはコードで作る (MainWindow.Tabs.cs)。  -->
                            <TabViewItem
                                AutomationProperties.Name="{x:Bind Header, Mode=OneWay}"
                                Loaded="DocumentTab_Loaded"
                                ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                                <!--  長時間処理の実行中は小さな進捗リングを出す (UI-09 の仕様 2、UI-37 の仕様 8)。  -->
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ProgressRing
                                            Width="12"
                                            Height="12"
                                            MinWidth="12"
                                            MinHeight="12"
                                            AutomationProperties.AccessibilityView="Raw"
                                            IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                            Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                        <!--  未保存の印 (●) は閉じるボタンの位置に出す (UI-09 の仕様 2。MainWindow.TabsUnsaved.cs)  -->
                                        <TextBlock Text="{x:Bind local:MainWindow.VisibleTabHeader(Header, Document.IsModified), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <TabViewItem.ContextFlyout>
                                    <MenuFlyout Opening="TabMenu_Opening" />
                                </TabViewItem.ContextFlyout>
                                <TabViewItem.IconSource>
                                    <FontIconSource Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                                </TabViewItem.IconSource>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <controls:NotificationHost
                                        AutomationProperties.AutomationId="DocumentNotifications"
                                        Center="{x:Bind Notifications}"
                                        Owner="{x:Bind}"
                                        Scope="Document" />
                                    <!--  画面分割 (VIEW-37): 1 つ目のペインの Hex ビュー。分割すると PaneHost が 2 つ目を加える (MainWindow.Split.cs)。  -->
                                    <controls:PaneHost Grid.Row="1" AutomationProperties.AutomationId="PaneHost">
                                        <controls:HexView
                                            CommandRequested="HexView_CommandRequested"
                                            Editor="{x:Bind PrimaryEditor}"
                                            EditRejected="HexView_EditRejected"
                                            Loaded="HexView_Loaded" />
                                    </controls:PaneHost>
                                    <!--  セッションのファイルが見つからないタブ (UI-31 の「エラー」)  -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Padding="24"
                                        AutomationProperties.AutomationId="Session_MissingPanel"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        Spacing="12"
                                        Visibility="{x:Bind IsMissing}">
                                        <TextBlock
                                            AutomationProperties.AutomationId="Session_MissingText"
                                            FlowDirection="LeftToRight"
                                            Text="{x:Bind MissingText}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="Session_Close" AutomationProperties.AutomationId="Session_Close" Click="MissingClose_Click" />
                                            <Button x:Uid="Session_Locate" AutomationProperties.AutomationId="Session_Locate" Click="MissingLocate_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </TabViewItem>
                        </DataTemplate>

                        <!--  設定画面・ショートカット一覧のタブ (UI-22、UI-39)。内容はエディタ領域に重ねて出す (ToolPageHost)。  -->
                        <DataTemplate x:Key="ToolPageTabTemplate" x:DataType="local:ToolPageTab">
                            <TabViewItem
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind Title}"
                                Header="{x:Bind Title}"
                                ToolTipService.ToolTip="{x:Bind Title}">
                                <TabViewItem.ContextFlyout>
                                    <MenuFlyout Opening="ToolTabMenu_Opening" />
                                </TabViewItem.ContextFlyout>
                                <TabViewItem.IconSource>
                                    <FontIconSource Glyph="{x:Bind Glyph}" />
                                </TabViewItem.IconSource>
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.Resources>
                </TabView>

                <!--  設定画面・ショートカット一覧 (UI-22、UI-39)。タブの見出しの帯の下 (エディタ領域) に重ねて開く。  -->
                <Grid
                    x:Name="ToolPageHost"
                    Canvas.ZIndex="2"
                    AutomationProperties.AutomationId="ToolPageHost"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed" />
            </Grid>
            <controls:Splitter x:Name="BottomSplitter" Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="BottomSplitter" Visibility="Collapsed" />
            <controls:PanelDockArea x:Name="BottomPanel" Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="BottomPanel" Visibility="Collapsed" />
            <controls:Splitter x:Name="RightSplitter" Grid.RowSpan="3" Grid.Column="3" AutomationProperties.AutomationId="RightSplitter" Visibility="Collapsed" />
            <controls:PanelDockArea x:Name="RightPanel" Grid.RowSpan="3" Grid.Column="4" AutomationProperties.AutomationId="RightPanel" Visibility="Collapsed" />
        </Grid>

        <!--  コマンドパレット (UI-17)。タイトルバーの下の中央に重ねる。モーダルにしない。  -->
        <controls:CommandPalette
            x:Name="Palette"
            Grid.Row="1"
            Grid.RowSpan="4"
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Canvas.ZIndex="10"
            AutomationProperties.AutomationId="CommandPalette"
            Visibility="Collapsed" />

        <!--
            ステータスバー (UI-06)。項目はボタンで、クリック・Enter で対応する操作をする。← / → で項目間を移動できる。
            幅が足りないときは優先度の低い項目から隠す (コードビハインドの UpdateStatusBarLayout)。
        -->
        <Grid
            x:Name="StatusBar"
            Grid.Row="5"
            MinHeight="28"
            Padding="8,0"
            AutomationProperties.AutomationId="StatusBar"
            AutomationProperties.LandmarkType="Custom"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            SizeChanged="StatusBar_SizeChanged">
            <Grid.Resources>
                <Style x:Key="StatusItemStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Resources>
            <Grid.ContextFlyout>
                <MenuFlyout x:Name="StatusItemsMenu" />
            </Grid.ContextFlyout>
            <StackPanel
                x:Name="StatusItems"
                Orientation="Horizontal"
                TabFocusNavigation="Once"
                XYFocusKeyboardNavigation="Enabled">
                <Button x:Name="StatusCursor" AutomationProperties.AutomationId="Status_Offset" Click="StatusCursor_Click" Content="{x:Bind Vm.StatusDocument.CursorText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="cursor" />
                <Button x:Name="StatusValue" AutomationProperties.AutomationId="Status_Value" Content="{x:Bind Vm.StatusDocument.ValueText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="value" />
                <Button x:Name="StatusSelection" AutomationProperties.AutomationId="Status_Selection" Click="StatusSelection_Click" Content="{x:Bind Vm.StatusDocument.SelectionText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="selection" ToolTipService.ToolTip="{x:Bind Vm.StatusDocument.SelectionToolTip, Mode=OneWay, FallbackValue=''}" />
                <!--  セクタ / ページ / レコード (VIEW-40、VIEW-18、VIEW-33)。有効なときだけ表示する。  -->
                <Button x:Name="StatusPosition" AutomationProperties.AutomationId="Status_Position" Click="StatusCursor_Click" Content="{x:Bind Vm.StatusDocument.PositionText, Mode=OneWay, FallbackValue=''}" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="position" />
                <Button x:Name="StatusColumn" AutomationProperties.AutomationId="Status_Column" Click="StatusColumn_Click" Content="{x:Bind Vm.StatusDocument.ColumnText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="column" />
                <!--  表示形式 (VIEW-10。Hex 以外のときだけ)  -->
                <Button x:Name="StatusCellFormat" AutomationProperties.AutomationId="Status_Format" Click="StatusFormat_Click" Content="{x:Bind Vm.StatusDocument.FormatText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="format" />
                <Button x:Name="StatusEncoding" AutomationProperties.AutomationId="Status_Encoding" Click="StatusEncoding_Click" Content="{x:Bind Vm.StatusDocument.EncodingText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="encoding" />
                <!--  エンディアン (VIEW-11 の仕様 3): クリックで切り替える。  -->
                <Button x:Name="StatusEndian" AutomationProperties.AutomationId="Status_Endian" Click="StatusEndian_Click" Content="{x:Bind Vm.StatusDocument.EndianText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="endian" />
                <Button x:Name="StatusMode" AutomationProperties.AutomationId="Status_Mode" Click="StatusMode_Click" Content="{x:Bind Vm.StatusDocument.ModeText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="mode" />
                <Button x:Name="StatusModified" AutomationProperties.AutomationId="Status_Modified" Content="{x:Bind Vm.StatusDocument.ModifiedText, Mode=OneWay, FallbackValue=''}" IsTabStop="False" Style="{StaticResource StatusItemStyle}" Tag="modified" />
                <!--  比較タブの表示中: 「差分 12 / 340」、異なるバイト数、一致率 (ANA-04 の仕様 6)。  -->
                <Button x:Name="StatusCompare" AutomationProperties.AutomationId="Status_Compare" Click="StatusCompare_Click" FlowDirection="LeftToRight" Style="{StaticResource StatusItemStyle}" Tag="compare" Visibility="Collapsed" />
                <Button x:Name="StatusSize" AutomationProperties.AutomationId="Status_Size" Click="StatusSize_Click" Content="{x:Bind Vm.StatusDocument.SizeText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource StatusItemStyle}" Tag="size" />
                <!--  同期 (VIEW-39 の仕様 6): 同期スクロール中だけ表示する。クリックで同期のモードのメニュー。  -->
                <Button x:Name="StatusSync" AutomationProperties.AutomationId="Status_Sync" Click="StatusSync_Click" Style="{StaticResource StatusItemStyle}" Tag="sync" />
                <Button x:Name="StatusOperations" AutomationProperties.AutomationId="Status_Operations" Style="{StaticResource StatusItemStyle}" Tag="operations">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="StatusOperationsText" VerticalAlignment="Center" />
                        <ProgressBar x:Name="StatusOperationsProgress" Width="80" VerticalAlignment="Center" Maximum="1" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ProcessingCenterFlyout" Placement="TopEdgeAlignedRight">
                            <controls:ProcessingCenter x:Name="ProcessingCenter" Width="420" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="NotificationHistoryButton"
                    x:Uid="Status_Notifications"
                    AutomationProperties.AutomationId="Status_Notifications"
                    Style="{StaticResource StatusItemStyle}"
                    Tag="notifications">
                    <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                    <Button.Flyout>
                        <Flyout x:Name="NotificationHistoryFlyout" Placement="TopEdgeAlignedRight">
                            <StackPanel Width="420" Spacing="8">
                                <TextBlock x:Uid="Notifications_HistoryTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ListView
                                    MaxHeight="400"
                                    AutomationProperties.AutomationId="Notifications_History"
                                    ItemsSource="{x:Bind Vm.Notifications.History}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="notifications:NotificationHistoryItem">
                                            <StackPanel Padding="0,4">
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind local:MainWindow.FormatHistoryTime(Time)}" />
                                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!--  幅が足りないときに隠した項目 (UI-06 の仕様 5)。  -->
                <Button
                    x:Name="StatusMore"
                    x:Uid="Status_More"
                    AutomationProperties.AutomationId="Status_More"
                    Click="StatusMore_Click"
                    Style="{StaticResource StatusItemStyle}"
                    Tag="more"
                    Visibility="Collapsed">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
