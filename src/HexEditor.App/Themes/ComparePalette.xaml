<?xml version="1.0" encoding="utf-8" ?>
<!--
    比較の差分の配色 (ANA-04 の仕様 3、UI-28)。背景 (Compare*Brush) は Hex の文字が読めるよう淡く、差分マップと印 (Compare*MarkBrush)
    ははっきりした色。変更は赤系、挿入 (右のみ) は緑系、削除 (左のみ) は青系。色だけに頼らないため、変更は点線の枠、挿入はセルの左端の
    縦線、削除は取り消し線、揃えるための空白と読み込み不可は斜線の模様も付ける (色以外の印。HexView の HexMark)。
    ハイコントラストでは背景を塗らず (システム色の背景)、印をシステム色で描く (色以外の印だけで区別できる)。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="CompareChangedColor">#FFF8D0D0</Color>
            <SolidColorBrush x:Key="CompareChangedBrush" Color="{StaticResource CompareChangedColor}" />
            <Color x:Key="CompareInsertedColor">#FFCDEFCB</Color>
            <SolidColorBrush x:Key="CompareInsertedBrush" Color="{StaticResource CompareInsertedColor}" />
            <Color x:Key="CompareDeletedColor">#FFCFE0FA</Color>
            <SolidColorBrush x:Key="CompareDeletedBrush" Color="{StaticResource CompareDeletedColor}" />
            <Color x:Key="CompareUnreadableColor">#FFE3E3E3</Color>
            <SolidColorBrush x:Key="CompareUnreadableBrush" Color="{StaticResource CompareUnreadableColor}" />
            <Color x:Key="ComparePaddingColor">#FFF0F0F0</Color>
            <SolidColorBrush x:Key="ComparePaddingBrush" Color="{StaticResource ComparePaddingColor}" />
            <Color x:Key="CompareChangedMarkColor">#FFC42B1C</Color>
            <SolidColorBrush x:Key="CompareChangedMarkBrush" Color="{StaticResource CompareChangedMarkColor}" />
            <Color x:Key="CompareInsertedMarkColor">#FF107C10</Color>
            <SolidColorBrush x:Key="CompareInsertedMarkBrush" Color="{StaticResource CompareInsertedMarkColor}" />
            <Color x:Key="CompareDeletedMarkColor">#FF0063B1</Color>
            <SolidColorBrush x:Key="CompareDeletedMarkBrush" Color="{StaticResource CompareDeletedMarkColor}" />
            <Color x:Key="CompareUnreadableMarkColor">#FF6E6E6E</Color>
            <SolidColorBrush x:Key="CompareUnreadableMarkBrush" Color="{StaticResource CompareUnreadableMarkColor}" />
            <Color x:Key="ComparePaddingMarkColor">#FF8A8A8A</Color>
            <SolidColorBrush x:Key="ComparePaddingMarkBrush" Color="{StaticResource ComparePaddingMarkColor}" />
            <Color x:Key="CompareMapBackgroundColor">#FFF3F3F3</Color>
            <SolidColorBrush x:Key="CompareMapBackgroundBrush" Color="{StaticResource CompareMapBackgroundColor}" />
            <Color x:Key="CompareMapViewportColor">#40000000</Color>
            <SolidColorBrush x:Key="CompareMapViewportBrush" Color="{StaticResource CompareMapViewportColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="CompareChangedColor">#FF5A2626</Color>
            <SolidColorBrush x:Key="CompareChangedBrush" Color="{StaticResource CompareChangedColor}" />
            <Color x:Key="CompareInsertedColor">#FF214A23</Color>
            <SolidColorBrush x:Key="CompareInsertedBrush" Color="{StaticResource CompareInsertedColor}" />
            <Color x:Key="CompareDeletedColor">#FF213A63</Color>
            <SolidColorBrush x:Key="CompareDeletedBrush" Color="{StaticResource CompareDeletedColor}" />
            <Color x:Key="CompareUnreadableColor">#FF3A3A3A</Color>
            <SolidColorBrush x:Key="CompareUnreadableBrush" Color="{StaticResource CompareUnreadableColor}" />
            <Color x:Key="ComparePaddingColor">#FF2B2B2B</Color>
            <SolidColorBrush x:Key="ComparePaddingBrush" Color="{StaticResource ComparePaddingColor}" />
            <Color x:Key="CompareChangedMarkColor">#FFFF8C8C</Color>
            <SolidColorBrush x:Key="CompareChangedMarkBrush" Color="{StaticResource CompareChangedMarkColor}" />
            <Color x:Key="CompareInsertedMarkColor">#FF7FD47F</Color>
            <SolidColorBrush x:Key="CompareInsertedMarkBrush" Color="{StaticResource CompareInsertedMarkColor}" />
            <Color x:Key="CompareDeletedMarkColor">#FF79A9FF</Color>
            <SolidColorBrush x:Key="CompareDeletedMarkBrush" Color="{StaticResource CompareDeletedMarkColor}" />
            <Color x:Key="CompareUnreadableMarkColor">#FFA0A0A0</Color>
            <SolidColorBrush x:Key="CompareUnreadableMarkBrush" Color="{StaticResource CompareUnreadableMarkColor}" />
            <Color x:Key="ComparePaddingMarkColor">#FF8A8A8A</Color>
            <SolidColorBrush x:Key="ComparePaddingMarkBrush" Color="{StaticResource ComparePaddingMarkColor}" />
            <Color x:Key="CompareMapBackgroundColor">#FF202020</Color>
            <SolidColorBrush x:Key="CompareMapBackgroundBrush" Color="{StaticResource CompareMapBackgroundColor}" />
            <Color x:Key="CompareMapViewportColor">#40FFFFFF</Color>
            <SolidColorBrush x:Key="CompareMapViewportBrush" Color="{StaticResource CompareMapViewportColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CompareChangedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CompareInsertedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CompareDeletedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CompareUnreadableBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ComparePaddingBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CompareChangedMarkBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CompareInsertedMarkBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="CompareDeletedMarkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CompareUnreadableMarkBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ComparePaddingMarkBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="CompareMapBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CompareMapViewportBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
