<?xml version="1.0" encoding="utf-8" ?>
<!--
    ブックマークの色の一覧 (INSP-24 の仕様 4) と、インスペクタの対象の強調 (INSP-18) の配色。
    ライト・ダーク・ハイコントラストのそれぞれで判読できる色にする。背景 (BookmarkBackgroundN) は Hex の文字が読めるよう淡く、
    見本・目印 (BookmarkMarkN) ははっきりした色。ハイコントラストでは背景を塗らず、システム色の枠線 (BookmarkBorderN) と
    線の形 (1〜4 は実線、5〜8 は破線) で区別する。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BookmarkBackground1Color">#FFFFD6D6</Color>
            <Color x:Key="BookmarkBackground2Color">#FFFFE2C2</Color>
            <Color x:Key="BookmarkBackground3Color">#FFFFF2B3</Color>
            <Color x:Key="BookmarkBackground4Color">#FFD4F2D2</Color>
            <Color x:Key="BookmarkBackground5Color">#FFC8EEF0</Color>
            <Color x:Key="BookmarkBackground6Color">#FFD3E3FF</Color>
            <Color x:Key="BookmarkBackground7Color">#FFE6D9FF</Color>
            <Color x:Key="BookmarkBackground8Color">#FFFFD6EE</Color>
            <Color x:Key="BookmarkMark1Color">#FFD13438</Color>
            <Color x:Key="BookmarkMark2Color">#FFCA5010</Color>
            <Color x:Key="BookmarkMark3Color">#FF9D7700</Color>
            <Color x:Key="BookmarkMark4Color">#FF107C10</Color>
            <Color x:Key="BookmarkMark5Color">#FF038387</Color>
            <Color x:Key="BookmarkMark6Color">#FF0063B1</Color>
            <Color x:Key="BookmarkMark7Color">#FF8764B8</Color>
            <Color x:Key="BookmarkMark8Color">#FFC239B3</Color>
            <SolidColorBrush x:Key="BookmarkBackground1Brush" Color="{StaticResource BookmarkBackground1Color}" />
            <SolidColorBrush x:Key="BookmarkBackground2Brush" Color="{StaticResource BookmarkBackground2Color}" />
            <SolidColorBrush x:Key="BookmarkBackground3Brush" Color="{StaticResource BookmarkBackground3Color}" />
            <SolidColorBrush x:Key="BookmarkBackground4Brush" Color="{StaticResource BookmarkBackground4Color}" />
            <SolidColorBrush x:Key="BookmarkBackground5Brush" Color="{StaticResource BookmarkBackground5Color}" />
            <SolidColorBrush x:Key="BookmarkBackground6Brush" Color="{StaticResource BookmarkBackground6Color}" />
            <SolidColorBrush x:Key="BookmarkBackground7Brush" Color="{StaticResource BookmarkBackground7Color}" />
            <SolidColorBrush x:Key="BookmarkBackground8Brush" Color="{StaticResource BookmarkBackground8Color}" />
            <SolidColorBrush x:Key="BookmarkMark1Brush" Color="{StaticResource BookmarkMark1Color}" />
            <SolidColorBrush x:Key="BookmarkMark2Brush" Color="{StaticResource BookmarkMark2Color}" />
            <SolidColorBrush x:Key="BookmarkMark3Brush" Color="{StaticResource BookmarkMark3Color}" />
            <SolidColorBrush x:Key="BookmarkMark4Brush" Color="{StaticResource BookmarkMark4Color}" />
            <SolidColorBrush x:Key="BookmarkMark5Brush" Color="{StaticResource BookmarkMark5Color}" />
            <SolidColorBrush x:Key="BookmarkMark6Brush" Color="{StaticResource BookmarkMark6Color}" />
            <SolidColorBrush x:Key="BookmarkMark7Brush" Color="{StaticResource BookmarkMark7Color}" />
            <SolidColorBrush x:Key="BookmarkMark8Brush" Color="{StaticResource BookmarkMark8Color}" />
            <StaticResource x:Key="BookmarkMarkTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="InspectorTargetBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="InspectorTargetBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BookmarkBackground1Color">#FF5C2626</Color>
            <Color x:Key="BookmarkBackground2Color">#FF5C3B1A</Color>
            <Color x:Key="BookmarkBackground3Color">#FF524618</Color>
            <Color x:Key="BookmarkBackground4Color">#FF234D25</Color>
            <Color x:Key="BookmarkBackground5Color">#FF1D4A4D</Color>
            <Color x:Key="BookmarkBackground6Color">#FF233D66</Color>
            <Color x:Key="BookmarkBackground7Color">#FF3F2E66</Color>
            <Color x:Key="BookmarkBackground8Color">#FF5C2649</Color>
            <Color x:Key="BookmarkMark1Color">#FFFF8C8C</Color>
            <Color x:Key="BookmarkMark2Color">#FFFFAA66</Color>
            <Color x:Key="BookmarkMark3Color">#FFF2D35B</Color>
            <Color x:Key="BookmarkMark4Color">#FF7FD47F</Color>
            <Color x:Key="BookmarkMark5Color">#FF5CD6D9</Color>
            <Color x:Key="BookmarkMark6Color">#FF79A9FF</Color>
            <Color x:Key="BookmarkMark7Color">#FFB9A3FF</Color>
            <Color x:Key="BookmarkMark8Color">#FFFF8CD9</Color>
            <SolidColorBrush x:Key="BookmarkBackground1Brush" Color="{StaticResource BookmarkBackground1Color}" />
            <SolidColorBrush x:Key="BookmarkBackground2Brush" Color="{StaticResource BookmarkBackground2Color}" />
            <SolidColorBrush x:Key="BookmarkBackground3Brush" Color="{StaticResource BookmarkBackground3Color}" />
            <SolidColorBrush x:Key="BookmarkBackground4Brush" Color="{StaticResource BookmarkBackground4Color}" />
            <SolidColorBrush x:Key="BookmarkBackground5Brush" Color="{StaticResource BookmarkBackground5Color}" />
            <SolidColorBrush x:Key="BookmarkBackground6Brush" Color="{StaticResource BookmarkBackground6Color}" />
            <SolidColorBrush x:Key="BookmarkBackground7Brush" Color="{StaticResource BookmarkBackground7Color}" />
            <SolidColorBrush x:Key="BookmarkBackground8Brush" Color="{StaticResource BookmarkBackground8Color}" />
            <SolidColorBrush x:Key="BookmarkMark1Brush" Color="{StaticResource BookmarkMark1Color}" />
            <SolidColorBrush x:Key="BookmarkMark2Brush" Color="{StaticResource BookmarkMark2Color}" />
            <SolidColorBrush x:Key="BookmarkMark3Brush" Color="{StaticResource BookmarkMark3Color}" />
            <SolidColorBrush x:Key="BookmarkMark4Brush" Color="{StaticResource BookmarkMark4Color}" />
            <SolidColorBrush x:Key="BookmarkMark5Brush" Color="{StaticResource BookmarkMark5Color}" />
            <SolidColorBrush x:Key="BookmarkMark6Brush" Color="{StaticResource BookmarkMark6Color}" />
            <SolidColorBrush x:Key="BookmarkMark7Brush" Color="{StaticResource BookmarkMark7Color}" />
            <SolidColorBrush x:Key="BookmarkMark8Brush" Color="{StaticResource BookmarkMark8Color}" />
            <StaticResource x:Key="BookmarkMarkTextBrush" ResourceKey="TextFillColorInverseBrush" />
            <StaticResource x:Key="InspectorTargetBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="InspectorTargetBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BookmarkBackground1Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkBackground2Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkBackground3Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkBackground4Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkBackground5Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkBackground6Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkBackground7Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkBackground8Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BookmarkMark1Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BookmarkMark2Brush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="BookmarkMark3Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BookmarkMark4Brush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="BookmarkMark5Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BookmarkMark6Brush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="BookmarkMark7Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BookmarkMark8Brush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="BookmarkMarkTextBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InspectorTargetBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InspectorTargetBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
