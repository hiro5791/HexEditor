<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.VisualizerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls"
    AutomationProperties.AutomationId="VisualizerPanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        画像表示 (VIEW-36)。上部に設定の行 (折り返し可能): 画素の形式・幅・1 行のバイト数・開始位置・上下の向き・拡大率・メニュー
        (画像として保存…)。その下にマウスを合わせた画素の値、画像。画像の右のスクロールバーで開始位置より後ろを見る。
        画像はキーボードでも操作できる (矢印で画素を選び、Enter でカーソルを移す)。
    -->
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:WrapPanel Margin="8,6,8,0" HorizontalSpacing="4" VerticalSpacing="4">
            <ComboBox
                x:Name="FormatChoice"
                MinWidth="120"
                AutomationProperties.AutomationId="Visualizer_Format"
                SelectionChanged="FormatChoice_SelectionChanged" />
            <TextBox
                x:Name="WidthBox"
                MinWidth="72"
                AutomationProperties.AutomationId="Visualizer_Width"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                KeyDown="NumberBox_KeyDown"
                LostFocus="NumberBox_LostFocus" />
            <TextBox
                x:Name="StrideBox"
                MinWidth="72"
                AutomationProperties.AutomationId="Visualizer_Stride"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                KeyDown="NumberBox_KeyDown"
                LostFocus="NumberBox_LostFocus" />
            <ComboBox
                x:Name="StartChoice"
                AutomationProperties.AutomationId="Visualizer_StartMode"
                SelectionChanged="StartChoice_SelectionChanged" />
            <TextBox
                x:Name="StartBox"
                MinWidth="96"
                AutomationProperties.AutomationId="Visualizer_StartOffset"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                KeyDown="NumberBox_KeyDown"
                LostFocus="NumberBox_LostFocus" />
            <ComboBox
                x:Name="OrientationChoice"
                AutomationProperties.AutomationId="Visualizer_Orientation"
                SelectionChanged="OrientationChoice_SelectionChanged" />
            <ComboBox
                x:Name="ZoomChoice"
                AutomationProperties.AutomationId="Visualizer_Zoom"
                SelectionChanged="ZoomChoice_SelectionChanged" />
            <DropDownButton x:Name="MenuButton" AutomationProperties.AutomationId="Visualizer_Menu">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem
                            x:Name="SaveItem"
                            AutomationProperties.AutomationId="Visualizer_SaveImage"
                            Click="SaveItem_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </local:WrapPanel>

        <StackPanel Grid.Row="1" Padding="8,0">
            <TextBlock
                AutomationProperties.AutomationId="Visualizer_Hover"
                AutomationProperties.LiveSetting="Polite"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Vm.HoverText, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="Visualizer_Status"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="8,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="Viewport"
                AllowFocusOnInteraction="True"
                AutomationProperties.AutomationId="Visualizer_Viewport"
                Background="Transparent"
                IsTabStop="True"
                KeyDown="Viewport_KeyDown"
                PointerExited="Viewport_PointerExited"
                PointerWheelChanged="Viewport_PointerWheelChanged"
                SizeChanged="Viewport_SizeChanged"
                UseSystemFocusVisuals="True">
                <Canvas x:Name="ImageCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image
                        x:Name="ImageView"
                        AutomationProperties.AutomationId="Visualizer_Image"
                        PointerMoved="Image_PointerMoved"
                        PointerPressed="Image_PointerPressed"
                        Stretch="None" />
                    <!--  Hex ビューのカーソル位置と選択範囲の枠 (仕様 5)  -->
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                </Canvas>
            </Grid>
            <ScrollBar
                x:Name="RowScroll"
                Grid.Column="1"
                AutomationProperties.AutomationId="Visualizer_Scroll"
                IndicatorMode="MouseIndicator"
                Orientation="Vertical"
                SmallChange="1"
                ValueChanged="RowScroll_ValueChanged" />
        </Grid>
    </Grid>
</UserControl>
