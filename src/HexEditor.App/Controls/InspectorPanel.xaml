<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.InspectorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="InspectorPanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        データインスペクタ (INSP-01)。上部にツールバー (エンディアン・表示形式・ローカル / UTC・行の設定)、その下に起点のオフセット、
        グループに分けた 2 列の一覧。値の列は等幅フォントで、右から左に書く言語でも左から右に表示する。
        Tab の順序は一覧を先頭にする (F6 で一覧に入り、Tab でツールバーへ進む。INSP-19 の受け入れ基準 4)。
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:InspectorItemViewModel">
            <StackPanel
                Padding="0,6,0,2"
                AutomationProperties.AccessibilityView="Raw"
                Background="Transparent"
                Orientation="Horizontal"
                Spacing="6"
                Tapped="Group_Tapped">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="10"
                    Glyph="{x:Bind Chevron, Mode=OneWay}" />
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" x:DataType="vm:InspectorItemViewModel">
            <Grid
                Padding="0,2"
                AutomationProperties.AccessibilityView="Raw"
                Background="Transparent"
                ColumnSpacing="8"
                DoubleTapped="Row_DoubleTapped"
                PointerEntered="Row_PointerEntered"
                PointerExited="Row_PointerExited"
                ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="10"
                        Glyph="{x:Bind Chevron, Mode=OneWay}"
                        Tapped="Expand_Tapped"
                        Visibility="{x:Bind CanExpand, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    Text="{x:Bind Value, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind IsNotEditing, Mode=OneWay}" />
                <StackPanel
                    Grid.Column="1"
                    x:Name="EditArea"
                    x:Load="{x:Bind IsEditing, Mode=OneWay}"
                    Spacing="2">
                    <TextBox
                        AutomationProperties.AutomationId="Inspector_Edit"
                        FlowDirection="LeftToRight"
                        FontFamily="Cascadia Mono, Consolas"
                        KeyDown="Edit_KeyDown"
                        Loaded="Edit_Loaded"
                        LostFocus="Edit_LostFocus"
                        Text="{x:Bind EditText, Mode=OneWay}"
                        TextChanged="Edit_TextChanged" />
                    <TextBlock
                        AutomationProperties.AutomationId="Inspector_EditPreview"
                        FlowDirection="LeftToRight"
                        FontFamily="Cascadia Mono, Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Preview, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="Inspector_EditError"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind Error, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasError, Mode=OneWay}" />
                </StackPanel>
                <!--  2 進の行のビット (INSP-08 の仕様 3)。最上位ビットが左。  -->
                <ItemsRepeater
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,2,0,0"
                    FlowDirection="LeftToRight"
                    ItemsSource="{x:Bind Bits}"
                    Visibility="{x:Bind IsBinary}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinColumnSpacing="2" MinItemWidth="22" MinRowSpacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:InspectorBitViewModel">
                            <Button
                                MinWidth="0"
                                Padding="4,0"
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind ToolTip}"
                                Click="Bit_Click"
                                Content="{x:Bind Text, Mode=OneWay}"
                                FontFamily="Cascadia Mono, Consolas"
                                KeyDown="Bit_KeyDown"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind ToolTip}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ComponentTemplate" x:DataType="vm:InspectorItemViewModel">
            <Grid
                Padding="16,1,0,1"
                AutomationProperties.AccessibilityView="Raw"
                Background="Transparent"
                ColumnSpacing="8"
                PointerEntered="Row_PointerEntered"
                PointerExited="Row_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    Text="{x:Bind Value, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <local:InspectorTemplateSelector
            x:Key="ItemSelector"
            Component="{StaticResource ComponentTemplate}"
            Group="{StaticResource GroupTemplate}"
            Row="{StaticResource RowTemplate}" />
    </UserControl.Resources>

    <Grid RowSpacing="4" TabFocusNavigation="Local">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:WrapPanel Margin="8,6,8,0" HorizontalSpacing="4" VerticalSpacing="4">
            <DropDownButton
                x:Name="EndianButton"
                AutomationProperties.AutomationId="Inspector_Endian"
                Content="{x:Bind Vm.EndianText, Mode=OneWay}"
                FlowDirection="LeftToRight"
                TabIndex="1">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="EndianMenu" Placement="BottomEdgeAlignedLeft">
                        <RadioMenuFlyoutItem
                            x:Name="EndianDocument"
                            x:Uid="Inspector_EndianDocument"
                            AutomationProperties.AutomationId="Inspector_EndianDocument"
                            Click="Endian_Click"
                            GroupName="InspectorEndian"
                            Tag="document" />
                        <RadioMenuFlyoutItem
                            x:Name="EndianLittle"
                            x:Uid="Inspector_EndianLittle"
                            AutomationProperties.AutomationId="Inspector_EndianLittle"
                            Click="Endian_Click"
                            GroupName="InspectorEndian"
                            Tag="little" />
                        <RadioMenuFlyoutItem
                            x:Name="EndianBig"
                            x:Uid="Inspector_EndianBig"
                            AutomationProperties.AutomationId="Inspector_EndianBig"
                            Click="Endian_Click"
                            GroupName="InspectorEndian"
                            Tag="big" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <ComboBox
                x:Name="BaseChoice"
                AutomationProperties.AutomationId="Inspector_Base"
                SelectionChanged="BaseChoice_SelectionChanged"
                TabIndex="2">
                <ComboBoxItem x:Uid="Inspector_BaseDecimal" />
                <ComboBoxItem x:Uid="Inspector_BaseHex" />
                <ComboBoxItem x:Uid="Inspector_BaseOctal" />
            </ComboBox>
            <ComboBox
                x:Name="FloatChoice"
                AutomationProperties.AutomationId="Inspector_FloatFormat"
                SelectionChanged="FloatChoice_SelectionChanged"
                TabIndex="3">
                <ComboBoxItem x:Uid="Inspector_FloatShortest" />
                <ComboBoxItem x:Uid="Inspector_FloatExponent" />
                <ComboBoxItem x:Uid="Inspector_FloatHex" />
            </ComboBox>
            <ToggleButton
                x:Name="UtcToggle"
                AutomationProperties.AutomationId="Inspector_Utc"
                Checked="UtcToggle_Changed"
                Unchecked="UtcToggle_Changed"
                TabIndex="4" />
            <Button
                x:Name="RowsButton"
                AutomationProperties.AutomationId="Inspector_Rows"
                TabIndex="5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE71D;" />
                    <TextBlock x:Uid="Inspector_RowsText" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="RowsFlyout" Opened="RowsFlyout_Opened" Placement="BottomEdgeAlignedRight">
                        <local:InspectorRowSettings x:Name="RowSettings" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </local:WrapPanel>

        <TextBlock
            x:Name="OriginLabel"
            Grid.Row="1"
            Padding="8,0"
            AutomationProperties.AutomationId="Inspector_Origin"
            FlowDirection="LeftToRight"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Vm.OriginText, Mode=OneWay}" />

        <ListView
            x:Name="RowsList"
            Grid.Row="2"
            Padding="0,0,0,4"
            AutomationProperties.AutomationId="Inspector_List"
            ContainerContentChanging="RowsList_ContainerContentChanging"
            ContextRequested="RowsList_ContextRequested"
            ItemTemplateSelector="{StaticResource ItemSelector}"
            ItemsSource="{x:Bind Vm.Items}"
            KeyDown="RowsList_KeyDown"
            PreviewKeyDown="RowsList_PreviewKeyDown"
            SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
            SelectionMode="Single"
            TabIndex="0">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextFlyout>
                <MenuFlyout x:Name="RowMenu" Opening="RowMenu_Opening">
                    <MenuFlyoutItem x:Uid="Inspector_MenuCopy" AutomationProperties.AutomationId="Inspector_MenuCopy" Click="MenuCopy_Click" />
                    <MenuFlyoutItem x:Uid="Inspector_MenuCopyAll" AutomationProperties.AutomationId="Inspector_MenuCopyAll" Click="MenuCopyAll_Click" />
                    <MenuFlyoutItem x:Name="MenuEdit" x:Uid="Inspector_MenuEdit" AutomationProperties.AutomationId="Inspector_MenuEdit" Click="MenuEdit_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="MenuHide" x:Uid="Inspector_MenuHide" AutomationProperties.AutomationId="Inspector_MenuHide" Click="MenuHide_Click" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <TextBlock
            x:Name="StoredLabel"
            Grid.Row="3"
            Padding="8,0,8,6"
            AutomationProperties.AutomationId="Inspector_Stored"
            AutomationProperties.LiveSetting="Polite"
            FlowDirection="LeftToRight"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Vm.StoredText, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
