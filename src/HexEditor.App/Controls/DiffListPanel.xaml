<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.DiffListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="DiffListPanel">
    <!--
        差分の一覧とグラフ (ANA-06)。下のパネル「差分」(UI-05) に置く。左に結果一覧、右にグラフと要約 (幅が 800 px 未満のときは上下に並べる)。
        一覧の行は見えている分だけ作って並べ (仮想化)、1,000 万件以上でも表示できる。表示するのは最後に使った比較タブの結果。
    -->
    <Grid x:Name="Root" Background="{ThemeResource LayerFillColorDefaultBrush}" SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="SideColumn" Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ListRow" Height="*" />
            <RowDefinition x:Name="SideRow" Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="EmptyText"
            x:Uid="Compare_List_Empty"
            Grid.ColumnSpan="2"
            Margin="12"
            AutomationProperties.AutomationId="DiffList_Empty"
            TextWrapping="Wrap" />

        <!--  一覧: 絞り込み (種類・長さ)、並べ替え、エクスポート、行。  -->
        <Grid x:Name="ListArea" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Padding="12,4"
                Orientation="Horizontal"
                Spacing="8">
                <ToggleButton x:Name="FilterChanged" AutomationProperties.AutomationId="DiffList_FilterChanged" Click="Filter_Click" IsChecked="True" />
                <ToggleButton x:Name="FilterInserted" AutomationProperties.AutomationId="DiffList_FilterInserted" Click="Filter_Click" IsChecked="True" />
                <ToggleButton x:Name="FilterDeleted" AutomationProperties.AutomationId="DiffList_FilterDeleted" Click="Filter_Click" IsChecked="True" />
                <ToggleButton x:Name="FilterUnreadable" AutomationProperties.AutomationId="DiffList_FilterUnreadable" Click="Filter_Click" IsChecked="True" />
                <TextBox
                    x:Name="MinLengthBox"
                    x:Uid="Compare_List_MinLength"
                    Width="120"
                    AutomationProperties.AutomationId="DiffList_MinLength"
                    TextChanged="MinLength_TextChanged" />
                <ComboBox x:Name="SortBox" AutomationProperties.AutomationId="DiffList_Sort" SelectionChanged="Sort_SelectionChanged" />
                <DropDownButton x:Name="ExportButton" AutomationProperties.AutomationId="DiffList_Export">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ExportMenu" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock
                    x:Name="BusyText"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="DiffList_Busy"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="Collapsed" />
            </StackPanel>
            <ScrollViewer
                Grid.Row="1"
                Grid.RowSpan="2"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid x:Name="Table">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="HeaderRow" Padding="12,0" />
                    <UserControl
                        x:Name="ListHost"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="DiffList_Rows"
                        IsTabStop="True"
                        KeyDown="ListHost_KeyDown"
                        PointerWheelChanged="ListHost_PointerWheelChanged"
                        SizeChanged="ListHost_SizeChanged"
                        UseSystemFocusVisuals="True">
                        <Canvas x:Name="RowsCanvas" Background="Transparent" />
                    </UserControl>
                </Grid>
            </ScrollViewer>
            <ScrollBar
                x:Name="RowsScroll"
                Grid.Row="2"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="DiffList_Scroll"
                IndicatorMode="MouseIndicator"
                Orientation="Vertical"
                Scroll="RowsScroll_Scroll" />
        </Grid>

        <!--  要約 (ANA-06 の仕様 6) とグラフ「差分の分布」(仕様 7)。グラフは「表で表示」で表に切り替える (06 の 0.4)。  -->
        <ScrollViewer
            x:Name="SideArea"
            Grid.Column="1"
            Padding="12,8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <StackPanel x:Name="SummaryRows" AutomationProperties.AutomationId="DiffList_Summary" Spacing="2" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  区間の数 (64〜4,096、既定 512。ANA-06 の仕様 7)  -->
                    <ComboBox
                        x:Name="BucketsBox"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="DiffList_Buckets"
                        SelectionChanged="BucketsBox_SelectionChanged" />
                    <TextBlock x:Uid="Compare_GraphHeading" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ToggleButton
                        x:Name="TableToggle"
                        x:Uid="Compare_Graph_AsTable"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="DiffList_GraphAsTable"
                        Click="TableToggle_Click" />
                </Grid>
                <Canvas
                    x:Name="Graph"
                    Height="120"
                    AutomationProperties.AutomationId="DiffList_Graph"
                    Background="{ThemeResource CompareMapBackgroundBrush}"
                    PointerPressed="Graph_PointerPressed"
                    SizeChanged="Graph_SizeChanged" />
                <ListView
                    x:Name="GraphTable"
                    MaxHeight="240"
                    AutomationProperties.AutomationId="DiffList_GraphTable"
                    SelectionMode="None"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
