<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.ColoringRulesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="ColoringRulesPanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        「色付けルール」パネル (INSP-33 の「画面」、INSP-34): 上部に「全体」「このドキュメント」の切り替え、ルールの一覧 (有効のチェック、
        色見本と文字での色の説明、名前、条件の要約。上ほど優先)、選んだルールの編集欄。変更はその場で表示に反映する。
        一覧のキー: Enter で編集欄へ、Delete で削除、Space で有効 / 無効 (00-overview 8.6)。
    -->
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Padding="8,6,8,0" Orientation="Horizontal" Spacing="8">
            <RadioButton
                x:Name="DocumentScope"
                x:Uid="Coloring_ScopeDocument"
                MinWidth="0"
                AutomationProperties.AutomationId="Coloring_ScopeDocument"
                Checked="Scope_Checked"
                GroupName="ColoringScope" />
            <RadioButton
                x:Name="GlobalScope"
                x:Uid="Coloring_ScopeGlobal"
                MinWidth="0"
                AutomationProperties.AutomationId="Coloring_ScopeGlobal"
                Checked="Scope_Checked"
                GroupName="ColoringScope" />
        </StackPanel>
        <StackPanel Grid.Row="1" Padding="8,0" Orientation="Horizontal" Spacing="4">
            <Button x:Name="AddButton" AutomationProperties.AutomationId="Coloring_Add" Click="Add_Click">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="Coloring_Delete" Click="Delete_Click">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
            </Button>
            <Button x:Name="UpButton" AutomationProperties.AutomationId="Coloring_MoveUp" Click="Up_Click">
                <FontIcon FontSize="14" Glyph="&#xE70E;" />
            </Button>
            <Button x:Name="DownButton" AutomationProperties.AutomationId="Coloring_MoveDown" Click="Down_Click">
                <FontIcon FontSize="14" Glyph="&#xE70D;" />
            </Button>
        </StackPanel>
        <ListView
            x:Name="List"
            Grid.Row="2"
            AutomationProperties.AutomationId="Coloring_List"
            ContainerContentChanging="List_ContainerContentChanging"
            ItemsSource="{x:Bind Vm.Items}"
            KeyDown="List_KeyDown"
            SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ColoringRuleItem">
                    <Grid AutomationProperties.AccessibilityView="Raw" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            MinWidth="0"
                            AutomationProperties.AutomationId="Coloring_Enabled"
                            Click="Enabled_Click"
                            IsChecked="{x:Bind Enabled, Mode=OneWay}"
                            IsTabStop="False"
                            Tag="{x:Bind}" />
                        <Border
                            Grid.Column="1"
                            Width="22"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{x:Bind BackgroundSwatch, Mode=OneWay}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono, Consolas"
                                Foreground="{x:Bind ForegroundSwatch, Mode=OneWay}"
                                x:Uid="Coloring_Sample" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Summary, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ColorText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Error, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasError, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  選んだルールの編集欄 (INSP-33 の仕様 1・2)  -->
        <ScrollViewer Grid.Row="3" MaxHeight="420" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Editor" AutomationProperties.AutomationId="Coloring_Editor" Spacing="6">
                <TextBox x:Name="NameBox" x:Uid="Coloring_Name" AutomationProperties.AutomationId="Coloring_Name" TextChanged="Field_Changed" />
                <ComboBox x:Name="KindChoice" x:Uid="Coloring_Kind" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Coloring_Kind" SelectionChanged="Field_SelectionChanged" />
                <TextBox
                    x:Name="PatternBox"
                    AutomationProperties.AutomationId="Coloring_Pattern"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    TextChanged="Field_Changed" />
                <TextBox
                    x:Name="EndBox"
                    x:Uid="Coloring_End"
                    AutomationProperties.AutomationId="Coloring_End"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    TextChanged="Field_Changed" />
                <StackPanel x:Name="PeriodFields" Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="ModulusBox" x:Uid="Coloring_Modulus" Width="96" AutomationProperties.AutomationId="Coloring_Modulus" TextChanged="Field_Changed" />
                    <TextBox x:Name="RemainderBox" x:Uid="Coloring_Remainder" Width="96" AutomationProperties.AutomationId="Coloring_Remainder" TextChanged="Field_Changed" />
                    <TextBox x:Name="PeriodLengthBox" x:Uid="Coloring_PeriodLength" Width="96" AutomationProperties.AutomationId="Coloring_PeriodLength" TextChanged="Field_Changed" />
                </StackPanel>
                <StackPanel x:Name="TextFields" Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="CodePageChoice" x:Uid="Coloring_CodePage" AutomationProperties.AutomationId="Coloring_CodePage" SelectionChanged="Field_SelectionChanged" />
                    <CheckBox x:Name="CaseBox" x:Uid="Coloring_CaseSensitive" MinWidth="0" AutomationProperties.AutomationId="Coloring_CaseSensitive" Click="Field_Click" />
                    <CheckBox x:Name="RegexTextBox" x:Uid="Coloring_RegexOnText" MinWidth="0" AutomationProperties.AutomationId="Coloring_RegexOnText" Click="Field_Click" />
                </StackPanel>
                <StackPanel x:Name="NumberFields" Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="NumberTypeChoice" x:Uid="Coloring_NumberType" AutomationProperties.AutomationId="Coloring_NumberType" SelectionChanged="Field_SelectionChanged" />
                    <CheckBox x:Name="BigEndianBox" x:Uid="Coloring_BigEndian" MinWidth="0" AutomationProperties.AutomationId="Coloring_BigEndian" Click="Field_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox x:Name="ForegroundBox" x:Uid="Coloring_UseForeground" MinWidth="0" AutomationProperties.AutomationId="Coloring_UseForeground" Click="Field_Click" />
                    <TextBox
                        x:Name="ForegroundText"
                        Width="100"
                        AutomationProperties.AutomationId="Coloring_Foreground"
                        FlowDirection="LeftToRight"
                        FontFamily="Cascadia Mono, Consolas"
                        TextChanged="Field_Changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox x:Name="BackgroundBox" x:Uid="Coloring_UseBackground" MinWidth="0" AutomationProperties.AutomationId="Coloring_UseBackground" Click="Field_Click" />
                    <TextBox
                        x:Name="BackgroundText"
                        Width="100"
                        AutomationProperties.AutomationId="Coloring_Background"
                        FlowDirection="LeftToRight"
                        FontFamily="Cascadia Mono, Consolas"
                        TextChanged="Field_Changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="BorderChoice" x:Uid="Coloring_BorderChoice" AutomationProperties.AutomationId="Coloring_Border" SelectionChanged="Field_SelectionChanged" />
                    <ComboBox x:Name="TargetChoice" x:Uid="Coloring_Target" AutomationProperties.AutomationId="Coloring_Target" SelectionChanged="Field_SelectionChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox
                        x:Name="RangeStartBox"
                        x:Uid="Coloring_RangeStart"
                        Width="140"
                        AutomationProperties.AutomationId="Coloring_RangeStart"
                        FlowDirection="LeftToRight"
                        FontFamily="Cascadia Mono, Consolas"
                        TextChanged="Field_Changed" />
                    <TextBox
                        x:Name="RangeEndBox"
                        x:Uid="Coloring_RangeEnd"
                        Width="140"
                        AutomationProperties.AutomationId="Coloring_RangeEnd"
                        FlowDirection="LeftToRight"
                        FontFamily="Cascadia Mono, Consolas"
                        TextChanged="Field_Changed" />
                </StackPanel>
                <TextBlock
                    x:Name="ErrorText"
                    AutomationProperties.AutomationId="Coloring_EditorError"
                    AutomationProperties.LiveSetting="Assertive"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
