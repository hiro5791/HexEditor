<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.InspectorRowSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls"
    AutomationProperties.AutomationId="Inspector_RowSettings">
    <!--
        行の設定 (INSP-19): すべての型をグループごとにチェックボックス付きで並べ、表示する行と順序、型ごとのオプションを決める。
        キーボードだけで操作できる (↑ / ↓ で行を選び、Space で表示を切り替え、「上へ」「下へ」で並べ替える)。
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="SettingGroupTemplate" x:DataType="local:RowSettingItem">
            <TextBlock Padding="0,4,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
        </DataTemplate>
        <DataTemplate x:Key="SettingRowTemplate" x:DataType="local:RowSettingItem">
            <CheckBox
                MinWidth="0"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                Click="Row_Click"
                Content="{x:Bind Name}"
                IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                IsTabStop="False"
                Tag="{x:Bind}" />
        </DataTemplate>
        <local:RowSettingTemplateSelector
            x:Key="SettingSelector"
            Group="{StaticResource SettingGroupTemplate}"
            Row="{StaticResource SettingRowTemplate}" />
    </UserControl.Resources>

    <Grid Width="340" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView
            x:Name="SettingsList"
            MaxHeight="360"
            AllowDrop="True"
            AutomationProperties.AutomationId="Inspector_SettingsList"
            CanDragItems="True"
            CanReorderItems="True"
            ContainerContentChanging="SettingsList_ContainerContentChanging"
            DragItemsCompleted="SettingsList_DragItemsCompleted"
            DragItemsStarting="SettingsList_DragItemsStarting"
            ItemTemplateSelector="{StaticResource SettingSelector}"
            KeyDown="SettingsList_KeyDown"
            SelectionChanged="SettingsList_SelectionChanged"
            SelectionMode="Single"
            TabIndex="0" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="UpButton"
                x:Uid="Inspector_MoveUp"
                AutomationProperties.AutomationId="Inspector_MoveUp"
                Click="Up_Click"
                TabIndex="1" />
            <Button
                x:Name="DownButton"
                x:Uid="Inspector_MoveDown"
                AutomationProperties.AutomationId="Inspector_MoveDown"
                Click="Down_Click"
                TabIndex="2" />
        </StackPanel>
        <CheckBox
            x:Name="OppositeBox"
            x:Uid="Inspector_Opposite"
            Grid.Row="2"
            AutomationProperties.AutomationId="Inspector_Opposite"
            Click="Opposite_Click"
            TabIndex="3" />
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Uid="Inspector_DateFormatLabel" />
            <ComboBox
                x:Name="DateFormatChoice"
                AutomationProperties.AutomationId="Inspector_DateFormat"
                SelectionChanged="DateFormat_SelectionChanged"
                TabIndex="4">
                <ComboBoxItem x:Uid="Inspector_DateRegional" />
                <ComboBoxItem x:Uid="Inspector_DateIso" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock x:Uid="Inspector_PresetLabel" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="PresetChoice"
                    AutomationProperties.AutomationId="Inspector_Preset"
                    SelectionChanged="Preset_SelectionChanged"
                    TabIndex="5">
                    <ComboBoxItem x:Uid="Inspector_PresetBasic" />
                    <ComboBoxItem x:Uid="Inspector_PresetAll" />
                    <ComboBoxItem x:Uid="Inspector_PresetDateTime" />
                    <ComboBoxItem x:Uid="Inspector_PresetEmbedded" />
                </ComboBox>
                <Button
                    x:Name="ResetButton"
                    x:Uid="Inspector_ResetRows"
                    AutomationProperties.AutomationId="Inspector_ResetRows"
                    Click="Reset_Click"
                    TabIndex="6" />
            </StackPanel>
            <!--  名前を付けたプリセットとして保存する (INSP-19 の仕様 4)  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="PresetName"
                    x:Uid="Inspector_PresetName"
                    Width="180"
                    AutomationProperties.AutomationId="Inspector_PresetName"
                    TabIndex="7" />
                <Button
                    x:Name="SavePresetButton"
                    x:Uid="Inspector_SavePreset"
                    AutomationProperties.AutomationId="Inspector_SavePreset"
                    Click="SavePreset_Click"
                    TabIndex="8" />
            </StackPanel>
        </StackPanel>
        <!--
            固定小数点の行を加える (INSP-06 の仕様 3): 符号・全体のビット数 (8 / 16 / 32 / 64)・小数部のビット数 (0〜全体)。最大 16 行。
            行の設定で加えた行は「外す」で一覧から外せる。
        -->
        <StackPanel Grid.Row="5" Spacing="4">
            <TextBlock x:Uid="Inspector_FixedLabel" />
            <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                <CheckBox
                    x:Name="FixedSigned"
                    x:Uid="Inspector_FixedSignedBox"
                    MinWidth="0"
                    AutomationProperties.AutomationId="Inspector_FixedSigned"
                    IsChecked="True"
                    TabIndex="9" />
                <ComboBox
                    x:Name="FixedTotal"
                    AutomationProperties.AutomationId="Inspector_FixedTotal"
                    SelectedIndex="2"
                    TabIndex="10">
                    <ComboBoxItem Content="8" Tag="8" />
                    <ComboBoxItem Content="16" Tag="16" />
                    <ComboBoxItem Content="32" Tag="32" />
                    <ComboBoxItem Content="64" Tag="64" />
                </ComboBox>
                <NumberBox
                    x:Name="FixedFraction"
                    Width="96"
                    AutomationProperties.AutomationId="Inspector_FixedFraction"
                    Maximum="64"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    TabIndex="11"
                    Value="16" />
                <Button
                    x:Name="AddFixedButton"
                    x:Uid="Inspector_AddFixed"
                    AutomationProperties.AutomationId="Inspector_AddFixed"
                    Click="AddFixed_Click"
                    TabIndex="12" />
                <Button
                    x:Name="RemoveFixedButton"
                    x:Uid="Inspector_RemoveFixed"
                    AutomationProperties.AutomationId="Inspector_RemoveFixed"
                    Click="RemoveFixed_Click"
                    TabIndex="13" />
            </local:WrapPanel>
            <TextBlock
                x:Name="FixedError"
                AutomationProperties.AutomationId="Inspector_FixedError"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
