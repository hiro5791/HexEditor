<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.CompareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="CompareView">
    <!--
        比較タブ (ANA-04 の「画面」)。上部にツールバー (再比較、方式、前の差分、次の差分、同期スクロール、レイアウト、マージ操作、差分の一覧)、
        比較結果が古くなった・中止したことを示す InfoBar と進捗バー、中央に 2 つの Hex ビューと各ビューの差分マップ。差分の一覧は下のパネル
        (「差分」) に出す。右から左に書く言語でも、左右の配置は「左 = 比較の左側」のまま反転しない (仕様 9)。
    -->
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ツールバー。ボタンはコマンド (UI-16) から作る (CompareView.xaml.cs)。方式の切り替えだけはコンボボックス。  -->
        <Grid Padding="8,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="MethodBox"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Compare_Method"
                SelectionChanged="MethodBox_SelectionChanged" />
            <CommandBar
                x:Name="Toolbar"
                Grid.Column="1"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="Compare_Toolbar"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True"
                OverflowButtonVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="1">
            <!--  編集で比較結果が古くなった (ANA-04 の仕様 7)。  -->
            <InfoBar
                x:Name="StaleBar"
                x:Uid="Compare_StaleBar"
                AutomationProperties.AutomationId="Compare_StaleBar"
                IsClosable="False"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="StaleRecompare"
                        x:Uid="Compare_StaleRecompare"
                        AutomationProperties.AutomationId="Compare_StaleRecompare"
                        Click="Recompare_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!--  中止した位置、ドキュメントが閉じられた、一時ファイルに書けない (ANA-02・ANA-04 の「エラー」)、マージの結果。  -->
            <InfoBar
                x:Name="MessageBar"
                AutomationProperties.AutomationId="Compare_MessageBar"
                IsClosable="True"
                Severity="Warning" />
        </StackPanel>

        <ProgressBar
            x:Name="Progress"
            Grid.Row="2"
            AutomationProperties.AutomationId="Compare_Progress"
            IsIndeterminate="False"
            Maximum="1"
            Visibility="Collapsed" />

        <!--  左右 (または上下) の Hex ビュー。中身はコードで作る (レイアウトの切り替えで行と列を入れ替える)。  -->
        <Grid
            x:Name="Sides"
            Grid.Row="3"
            FlowDirection="LeftToRight" />
    </Grid>
</UserControl>
