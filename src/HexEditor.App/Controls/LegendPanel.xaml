<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.LegendPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="LegendPanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        凡例 (INSP-34 の仕様 3): 有効な色付けルール、表示中の注釈の出どころ、ブックマークのグループを色見本・枠線の形・名前で並べ、表示範囲での
        一致件数を出す。ルールの項目の「次へ」「前へ」で、そのルールに一致する次 / 前の位置に移動する。
    -->
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button
            x:Name="CountAllButton"
            x:Uid="Legend_CountAll"
            Margin="8,6,8,0"
            AutomationProperties.AutomationId="Legend_CountAll"
            Click="CountAll_Click" />
        <ListView
            x:Name="List"
            Grid.Row="1"
            AutomationProperties.AutomationId="Legend_List"
            ContainerContentChanging="List_ContainerContentChanging"
            ItemsSource="{x:Bind Vm.Items}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LegendItem">
                    <Grid AutomationProperties.AccessibilityView="Raw" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="22" Height="16" VerticalAlignment="Center">
                            <Rectangle Fill="{x:Bind Swatch}" />
                            <Rectangle
                                AutomationProperties.AutomationId="Legend_Shape"
                                Stroke="{x:Bind Stroke}"
                                StrokeDashArray="{x:Bind Dash}"
                                StrokeThickness="1.5" />
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ShapeText}" />
                            <TextBlock
                                AutomationProperties.AutomationId="Legend_ItemCount"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind CountText, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind TotalText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Visibility="{x:Bind CanNavigate}">
                            <Button
                                Padding="6,2"
                                AutomationProperties.AutomationId="Legend_Previous"
                                Click="Previous_Click"
                                Loaded="NavButton_Loaded"
                                Tag="{x:Bind}">
                                <FontIcon FontSize="12" Glyph="&#xE70E;" />
                            </Button>
                            <Button
                                Padding="6,2"
                                AutomationProperties.AutomationId="Legend_Next"
                                Click="Next_Click"
                                Loaded="NavButton_Loaded"
                                Tag="{x:Bind}">
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
