<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.BookmarkListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="BookmarksPanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        ブックマーク一覧 (INSP-26)。上部にツールバー (追加・編集・削除・元に戻す) と絞り込み欄、その下に仮想化した一覧。
        一覧の中のキー: Enter で移動、Delete で削除、Shift+F10 / アプリケーションキーで右クリックメニュー (00-overview 8.6)。
    -->
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Padding="8,6,8,0" Orientation="Horizontal" Spacing="4">
            <Button x:Name="AddButton" AutomationProperties.AutomationId="Bookmarks_Add" Click="Add_Click">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button x:Name="EditButton" AutomationProperties.AutomationId="Bookmarks_Edit" Click="Edit_Click">
                <FontIcon FontSize="14" Glyph="&#xE70F;" />
            </Button>
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="Bookmarks_Delete" Click="Delete_Click">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
            </Button>
            <Button x:Name="UndoButton" AutomationProperties.AutomationId="Bookmarks_Undo" Click="Undo_Click">
                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
            </Button>
            <!--  すべてのドキュメント (INSP-26 の仕様 8。既定オフ)  -->
            <ToggleButton
                x:Name="AllDocumentsButton"
                AutomationProperties.AutomationId="Bookmarks_AllDocuments"
                IsChecked="{x:Bind Vm.AllDocuments, Mode=TwoWay}">
                <FontIcon FontSize="14" Glyph="&#xE8F1;" />
            </ToggleButton>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Bookmarks_Count"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Vm.CountText, Mode=OneWay}" />
        </StackPanel>
        <TextBox
            x:Name="FilterBox"
            x:Uid="Bookmarks_Filter"
            Grid.Row="1"
            Margin="8,0"
            AutomationProperties.AutomationId="Bookmarks_Filter"
            Text="{x:Bind Vm.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <!--
            列の見出し: 押すとその列で並べ替える (INSP-26 の仕様 2)。右クリック (Shift+F10) のメニューで列の表示と順序を変える
            (仕様 1)。見出しは列の配置に合わせてコードで作る。
        -->
        <Grid
            x:Name="Header"
            Grid.Row="2"
            Padding="12,0,8,0"
            AutomationProperties.AutomationId="Bookmarks_Header"
            ColumnSpacing="4"
            ContextRequested="Header_ContextRequested">
            <Grid.ContextFlyout>
                <MenuFlyout x:Name="ColumnsMenu" Opening="ColumnsMenu_Opening" />
            </Grid.ContextFlyout>
        </Grid>
        <ListView
            x:Name="List"
            Grid.Row="3"
            AutomationProperties.AutomationId="Bookmarks_List"
            ContainerContentChanging="List_ContainerContentChanging"
            ContextRequested="List_ContextRequested"
            IsItemClickEnabled="True"
            ItemClick="List_ItemClick"
            ItemsSource="{x:Bind Vm.Rows}"
            KeyDown="List_KeyDown"
            SelectionChanged="List_SelectionChanged"
            SelectionMode="Extended">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BookmarkRowViewModel">
                    <!--  列は 8 つの欄のどれかに置く。位置・表示・幅は列の配置 (Layout) に従う (INSP-26 の仕様 1)。  -->
                    <Grid AutomationProperties.AccessibilityView="Raw" ColumnSpacing="4" ToolTipService.ToolTip="{x:Bind CommentLine, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.Width0, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Width1, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Width2, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Width3, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Width4, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Width5, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Width6, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Width7, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Column="{x:Bind Layout.DocumentColumn, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Text="{x:Bind DocumentName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind Layout.DocumentVisibility, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="{x:Bind Layout.NumberColumn, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono, Consolas"
                            Text="{x:Bind NumberText, Mode=OneWay}"
                            Visibility="{x:Bind Layout.NumberVisibility, Mode=OneWay}" />
                        <Border
                            Grid.Column="{x:Bind Layout.ColorColumn, Mode=OneWay}"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Background="{x:Bind Swatch, Mode=OneWay}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Visibility="{x:Bind Layout.ColorVisibility, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="{x:Bind Layout.NameColumn, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="{x:Bind Layout.StartColumn, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight"
                            FontFamily="Cascadia Mono, Consolas"
                            Text="{x:Bind StartText, Mode=OneWay}"
                            Visibility="{x:Bind Layout.StartVisibility, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="{x:Bind Layout.LengthColumn, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight"
                            FontFamily="Cascadia Mono, Consolas"
                            Text="{x:Bind LengthText, Mode=OneWay}"
                            TextAlignment="Right"
                            Visibility="{x:Bind Layout.LengthVisibility, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="{x:Bind Layout.GroupColumn, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Text="{x:Bind GroupText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind Layout.GroupVisibility, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="{x:Bind Layout.CommentColumn, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Text="{x:Bind CommentLine, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind Layout.CommentVisibility, Mode=OneWay}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="{x:Bind Layout.NameColumn, Mode=OneWay}"
                            Grid.ColumnSpan="{x:Bind Layout.DetailSpan, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind CommentLine, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind vm:BookmarkRowViewModel.CommentLineShown(HasComment, Layout.CommentLineVisibility), Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind DeletedText, Mode=OneWay}"
                                Visibility="{x:Bind RangeDeleted, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout x:Name="RowMenu" Opening="RowMenu_Opening">
                    <MenuFlyoutItem x:Uid="Bookmarks_MenuGo" AutomationProperties.AutomationId="Bookmarks_MenuGo" Click="MenuGo_Click" />
                    <MenuFlyoutItem x:Uid="Bookmarks_MenuRename" AutomationProperties.AutomationId="Bookmarks_MenuRename" Click="MenuRename_Click" />
                    <MenuFlyoutItem x:Uid="Bookmarks_MenuEdit" AutomationProperties.AutomationId="Bookmarks_MenuEdit" Click="Edit_Click" />
                    <!--  ブックマークの範囲を新しいタブで開く (ENG-39 の仕様 3。範囲を持たないブックマークは開けない)  -->
                    <MenuFlyoutItem x:Name="OpenInNewTabItem" x:Uid="Bookmarks_MenuOpenInNewTab" AutomationProperties.AutomationId="Bookmarks_MenuOpenInNewTab" Click="OpenInNewTab_Click" />
                    <MenuFlyoutSubItem x:Name="ColorMenu" x:Uid="Bookmarks_MenuColor" AutomationProperties.AutomationId="Bookmarks_MenuColor" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Bookmarks_MenuDelete" AutomationProperties.AutomationId="Bookmarks_MenuDelete" Click="Delete_Click" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>
    </Grid>
</UserControl>
