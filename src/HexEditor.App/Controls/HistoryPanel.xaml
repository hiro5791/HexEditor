<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.HistoryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="HistoryPanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        履歴パネル (EDIT-20)。上部に「元に戻す」「やり直し」「比較」、その下に仮想化した一覧 (番号、操作名、対象範囲、長さの変化、日時、保存の印)。
        一覧の中のキー: Enter でその時点へ移る、Shift+F10 / アプリケーションキーで右クリックメニュー (00-overview 8.6)。
    -->
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Padding="8,6,8,0" Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="UndoButton"
                AutomationProperties.AutomationId="History_Undo"
                Click="Undo_Click"
                IsEnabled="{x:Bind Vm.CanUndo, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
            </Button>
            <Button
                x:Name="RedoButton"
                AutomationProperties.AutomationId="History_Redo"
                Click="Redo_Click"
                IsEnabled="{x:Bind Vm.CanRedo, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE7A6;" />
            </Button>
            <Button
                x:Name="CompareButton"
                AutomationProperties.AutomationId="History_Compare"
                Click="Compare_Click"
                IsEnabled="{x:Bind Vm.CanCompare, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE89A;" />
            </Button>
        </StackPanel>
        <ListView
            x:Name="List"
            Grid.Row="1"
            AutomationProperties.AutomationId="History_List"
            DoubleTapped="List_DoubleTapped"
            ItemsSource="{x:Bind Vm.Rows}"
            KeyDown="List_KeyDown"
            SelectionMode="Extended">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="History_GoToState" AutomationProperties.AutomationId="History_GoToState" Click="GoToState_Click" />
                    <MenuFlyoutItem x:Uid="History_SelectRange" AutomationProperties.AutomationId="History_SelectRange" Click="SelectRange_Click" />
                    <MenuFlyoutItem
                        x:Uid="History_CompareMenu"
                        AutomationProperties.AutomationId="History_CompareMenu"
                        Click="Compare_Click"
                        IsEnabled="{x:Bind Vm.CanCompare, Mode=OneWay}" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                    <Grid
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="8"
                        Opacity="{x:Bind Opacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="{x:Bind Weight}" Text="{x:Bind CurrentMark}" />
                        <TextBlock Grid.Column="1" FontWeight="{x:Bind Weight}" Text="{x:Bind NumberText}" />
                        <TextBlock Grid.Column="2" FontWeight="{x:Bind Weight}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" FontFamily="Cascadia Mono, Consolas" FontWeight="{x:Bind Weight}" Text="{x:Bind RangeText}" />
                        <TextBlock Grid.Column="4" FontFamily="Cascadia Mono, Consolas" FontWeight="{x:Bind Weight}" Text="{x:Bind DeltaText}" />
                        <TextBlock Grid.Column="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TimeText}" />
                        <TextBlock Grid.Column="6" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind SavedText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
