<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HexEditor.App.ViewModels">
    <!--
        スタートページ (UI-38)。文書が 1 つもないときのエディタ領域。中央に最大幅 720 px の縦並び。
        初回起動の「はじめに」はウィザードにせず、上部の欄に既定値を選んだ状態で出す。
    -->
    <ScrollViewer>
        <StackPanel
            x:Name="Body"
            MaxWidth="720"
            Margin="24,48"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="HexEditor" />

            <!--  はじめに (UI-38 の仕様 2〜4)  -->
            <Border
                x:Name="WelcomePanel"
                Padding="16"
                AutomationProperties.AutomationId="Start_Welcome"
                AutomationProperties.LandmarkType="Custom"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind ViewModel.ShowWelcome, Mode=OneWay}">
                <StackPanel x:Name="WelcomeItems" Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="Start_WelcomeTitle"
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Uid="Start_WelcomeClose"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="Start_WelcomeClose"
                            Click="WelcomeClose_Click" />
                    </Grid>
                    <ComboBox
                        x:Name="LanguageChoice"
                        x:Uid="Start_Language"
                        MinWidth="280"
                        AutomationProperties.AutomationId="Start_Language"
                        ItemsSource="{x:Bind ViewModel.Languages}"
                        SelectionChanged="Language_SelectionChanged" />
                    <TextBlock
                        x:Uid="Start_LanguageRestart"
                        AutomationProperties.AutomationId="Start_LanguageRestart"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.LanguageRestartNeeded, Mode=OneWay}" />
                    <ComboBox
                        x:Name="ThemeChoice"
                        x:Uid="Start_Theme"
                        MinWidth="280"
                        AutomationProperties.AutomationId="Start_Theme"
                        ItemsSource="{x:Bind ViewModel.Themes}"
                        SelectionChanged="Theme_SelectionChanged" />
                    <ComboBox
                        x:Name="PresetChoice"
                        x:Uid="Start_Preset"
                        MinWidth="280"
                        AutomationProperties.AutomationId="Start_Preset"
                        ItemsSource="{x:Bind ViewModel.Presets}"
                        SelectionChanged="Preset_SelectionChanged" />
                    <TextBlock
                        x:Uid="Start_NetworkInfo"
                        AutomationProperties.AutomationId="Start_NetworkInfo"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="OpenButton"
                    x:Uid="Start_Open"
                    AutomationProperties.AutomationId="Start_Open"
                    Click="Open_Click"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button x:Uid="Start_New" AutomationProperties.AutomationId="Start_New" Click="New_Click" />
                <Button
                    x:Uid="Start_RestoreSession"
                    AutomationProperties.AutomationId="Start_RestoreSession"
                    Click="RestoreSession_Click"
                    Visibility="{x:Bind ViewModel.CanRestoreSession, Mode=OneWay}" />
            </StackPanel>

            <!--  最近使ったファイル (ピン留め + 最近の 10 件。UI-32)  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                <Grid>
                    <TextBlock
                        x:Uid="Start_RecentTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <HyperlinkButton
                        x:Uid="Start_ShowAll"
                        Padding="0"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="Start_ShowAll"
                        Click="ShowAll_Click" />
                </Grid>
                <ListView
                    x:Name="RecentList"
                    x:Uid="Start_RecentList"
                    AutomationProperties.AutomationId="Start_Recent"
                    IsItemClickEnabled="True"
                    ItemClick="RecentList_ItemClick"
                    ItemsSource="{x:Bind ViewModel.RecentItems}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentEntryViewModel">
                            <Grid
                                Padding="0,6"
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                ColumnSpacing="12"
                                Opacity="{x:Bind Opacity, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="&#xE8A5;" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FlowDirection="LeftToRight"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ShortFolder}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="Start_DropHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="Start_PaletteHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
