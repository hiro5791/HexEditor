<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.SearchResultsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        「検索結果」の一覧 (FIND-20、FIND-21)。下のパネル (UI-05) に置く。パネルの見出しと閉じるボタンはパネルの枠が持つ。
        行は見えている分だけ作り、100 万件以上でもスクロールが止まらないように自分で並べる (Hex ビューと同じ考え方)。
    -->
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  結果のタブ (FIND-20 の仕様 3)。2 つ以上あるときだけ出す。タブの部品はコードで作る。  -->
        <ScrollViewer
            x:Name="TabStripHost"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            Visibility="Collapsed">
            <StackPanel
                x:Name="TabStrip"
                Padding="12,4,12,0"
                AutomationProperties.AutomationId="SearchResults_Tabs"
                Orientation="Horizontal"
                Spacing="4" />
        </ScrollViewer>

        <!--  見出し: 条件の要約・件数・状態、絞り込み、再検索、読めなかった範囲、続ける、キャンセル、固定、変換 (エクスポートを含む)。  -->
        <Grid Grid.Row="1" Padding="12,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="Summary"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SearchResults_Summary"
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <!--  絞り込み (00-overview 9 章の「結果一覧」): Hex (空白を無視) とテキストの列に含まれる語。  -->
            <TextBox
                x:Name="FilterBox"
                x:Uid="SearchResults_Filter"
                Grid.Column="1"
                Width="200"
                AutomationProperties.AutomationId="SearchResults_Filter"
                TextChanged="FilterBox_TextChanged" />
            <!--  古い結果 (元ファイルを読み直した) の再検索 (FIND-03 の「エラー」)。  -->
            <Button
                x:Name="ResearchButton"
                x:Uid="SearchResults_Research"
                Grid.Column="2"
                AutomationProperties.AutomationId="SearchResults_Research"
                Click="Research_Click"
                Visibility="Collapsed" />
            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="8">
                <!--  語ごとの件数 (FIND-26 の仕様 7)。項目はコードで作る。  -->
                <DropDownButton
                    x:Name="VariantCountsButton"
                    AutomationProperties.AutomationId="SearchResults_VariantCounts"
                    Visibility="Collapsed">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="VariantCountsMenu" Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!--  読み込めなかった範囲 (FIND-01 の「エラー」)。項目はコードで作る。  -->
                <DropDownButton
                    x:Name="SkippedButton"
                    AutomationProperties.AutomationId="SearchResults_Skipped"
                    Visibility="Collapsed">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SkippedMenu" Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <Button
                x:Name="ContinueButton"
                x:Uid="SearchResults_Continue"
                Grid.Column="4"
                AutomationProperties.AutomationId="SearchResults_Continue"
                Click="Continue_Click"
                Visibility="Collapsed" />
            <Button
                x:Name="CancelButton"
                x:Uid="SearchResults_Cancel"
                Grid.Column="5"
                AutomationProperties.AutomationId="SearchResults_Cancel"
                Click="Cancel_Click"
                Visibility="Collapsed" />
            <!--  固定: 次のすべて検索で置き換えない (FIND-20 の仕様 3)。  -->
            <ToggleButton
                x:Name="PinButton"
                Grid.Column="6"
                AutomationProperties.AutomationId="SearchResults_Pin"
                Click="Pin_Click">
                <FontIcon FontSize="14" Glyph="&#xE718;" />
            </ToggleButton>
            <DropDownButton
                x:Name="ConvertButton"
                x:Uid="SearchResults_Convert"
                Grid.Column="7"
                AutomationProperties.AutomationId="SearchResults_Convert">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="ConvertMenu" Opening="ConvertMenu_Opening" Placement="BottomEdgeAlignedRight">
                        <!--  変換・エクスポートの対象 (FIND-21 の仕様 1)。  -->
                        <RadioMenuFlyoutItem
                            x:Name="TargetSelectedItem"
                            x:Uid="SearchResults_TargetSelected"
                            AutomationProperties.AutomationId="SearchResults_TargetSelected"
                            Click="Target_Click"
                            GroupName="ConvertTarget" />
                        <RadioMenuFlyoutItem
                            x:Name="TargetAllItem"
                            x:Uid="SearchResults_TargetAll"
                            AutomationProperties.AutomationId="SearchResults_TargetAll"
                            Click="Target_Click"
                            GroupName="ConvertTarget" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="ToSelectionItem"
                            x:Uid="SearchResults_ToSelection"
                            AutomationProperties.AutomationId="SearchResults_ToSelection"
                            Click="ToSelection_Click" />
                        <MenuFlyoutItem
                            x:Name="ToBookmarksItem"
                            x:Uid="SearchResults_ToBookmarks"
                            AutomationProperties.AutomationId="SearchResults_ToBookmarks"
                            Click="ToBookmarks_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="SearchResults_CopyHex"
                            AutomationProperties.AutomationId="SearchResults_CopyHex"
                            Click="CopyHex_Click" />
                        <MenuFlyoutItem
                            x:Uid="SearchResults_CopyText"
                            AutomationProperties.AutomationId="SearchResults_CopyText"
                            Click="CopyText_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="SearchResults_ExportCsv"
                            AutomationProperties.AutomationId="SearchResults_ExportCsv"
                            Click="ExportCsv_Click" />
                        <MenuFlyoutItem
                            x:Uid="SearchResults_ExportJson"
                            AutomationProperties.AutomationId="SearchResults_ExportJson"
                            Click="ExportJson_Click" />
                        <!--  文字列の抽出の結果は 1 行 1 文字列のテキストにも書き出せる (FIND-32 の仕様 5)。  -->
                        <MenuFlyoutItem
                            x:Name="ExportTextItem"
                            x:Uid="SearchResults_ExportText"
                            AutomationProperties.AutomationId="SearchResults_ExportText"
                            Click="ExportText_Click"
                            Visibility="Collapsed" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!--  列の見出し。列の幅はコードの Columns と同じ。  -->
        <Grid
            x:Name="ColumnHeaders"
            Grid.Row="2"
            Padding="12,2"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1" />

        <!--  行の一覧とスクロールバー。キーボードの操作は ListHost で受ける。  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl
                x:Name="ListHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AutomationProperties.AutomationId="SearchResults_List"
                GotFocus="ListHost_GotFocus"
                IsTabStop="True"
                KeyDown="ListHost_KeyDown"
                LostFocus="ListHost_LostFocus"
                PointerWheelChanged="ListHost_PointerWheelChanged"
                SizeChanged="ListHost_SizeChanged"
                UseSystemFocusVisuals="True">
                <StackPanel x:Name="RowsPanel" Padding="12,0" Background="Transparent" />
            </ContentControl>
            <ScrollBar
                x:Name="Scroll"
                Grid.Column="1"
                AutomationProperties.AutomationId="SearchResults_Scroll"
                IndicatorMode="MouseIndicator"
                Orientation="Vertical"
                SmallChange="1"
                ValueChanged="Scroll_ValueChanged" />
        </Grid>
    </Grid>
</UserControl>
