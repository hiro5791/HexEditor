<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.DisassemblyListingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls"
    AutomationProperties.AutomationId="Disasm_Listing"
    FlowDirection="LeftToRight"
    IsTabStop="True"
    UseSystemFocusVisuals="True">
    <!--
        逆アセンブルのリスティング (ANA-23)。表示範囲の行だけを並べる (仮想化。行の作成は DisassemblyViewModel)。スクロールバーはバイトの
        オフセットに比例する。等幅フォントで、右から左の言語でも左から右に表示する (FlowDirection は固定)。
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 分岐の矢印と線の色 (テーマに合わせる。線はこの要素の Foreground に結び付ける) -->
        <TextBlock x:Name="LineBrushHost" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="AccentBrushHost" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <Canvas x:Name="Arrows" Grid.Column="0" IsHitTestVisible="False" />
        <ItemsRepeater
            x:Name="RowsRepeater"
            Grid.Column="1"
            ItemsSource="{x:Bind Items}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:DisasmRowItem">
                    <Grid
                        Height="{x:Bind RowHeight}"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        Background="Transparent"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind ToolTip}">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0"
                                Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                        <Grid Padding="6,0,0,0" ColumnSpacing="12" Visibility="{x:Bind InstructionVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Bind AddressWidth}" />
                                <ColumnDefinition Width="{x:Bind BytesWidth}" />
                                <ColumnDefinition Width="{x:Bind MnemonicWidth}" />
                                <ColumnDefinition Width="*" MinWidth="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Row.Address}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Row.Bytes}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Row.Mnemonic}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Row.Operands}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind CommentText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </Grid>
                        <TextBlock Padding="6,0,0,0" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind HeadingText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HeadingVisibility}" />
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <ScrollBar
            x:Name="VerticalBar"
            Grid.Column="2"
            AutomationProperties.AutomationId="Disasm_ScrollBar"
            IndicatorMode="MouseIndicator"
            Orientation="Vertical" />
    </Grid>
</UserControl>
