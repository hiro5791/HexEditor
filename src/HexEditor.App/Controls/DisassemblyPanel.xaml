<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.DisassemblyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls"
    xmlns:vm="using:HexEditor.App.ViewModels">
    <!--
        逆アセンブルパネル (ANA-23〜ANA-28、既定は右)。上部にツールバー (アーキテクチャ・モード・エンディアン・スライス・開始位置・
        ベースアドレス・構文・表示オプション・カーソルに追従・命令を検索)、通知、命令パターンの検索欄。左に「セクション」「シンボル」
        (MSIL では「型とメソッド」) の一覧、右にリスティング。パネルの幅が 600 px 未満では一覧をリスティングの上に置く。
    -->
    <Grid x:Name="RootGrid" Padding="8,6,8,8" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:WrapPanel x:Name="Toolbar" AutomationProperties.AutomationId="Disasm_Toolbar">
            <ComboBox x:Name="ArchBox" Margin="0,0,6,4" MinWidth="110" AutomationProperties.AutomationId="Disasm_Architecture" SelectionChanged="ArchBox_SelectionChanged" />
            <ComboBox x:Name="ModeBox" Margin="0,0,6,4" MinWidth="100" AutomationProperties.AutomationId="Disasm_Mode" SelectionChanged="ModeBox_SelectionChanged" />
            <ComboBox x:Name="EndianBox" Margin="0,0,6,4" MinWidth="70" AutomationProperties.AutomationId="Disasm_Endian" SelectionChanged="EndianBox_SelectionChanged" />
            <ComboBox x:Name="SliceBox" Margin="0,0,6,4" MinWidth="90" AutomationProperties.AutomationId="Disasm_Slice" SelectionChanged="SliceBox_SelectionChanged" Visibility="Collapsed" />
            <DropDownButton x:Name="StartButton" Margin="0,0,6,4" AutomationProperties.AutomationId="Disasm_Start">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="StartMenu" Placement="Bottom" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBox x:Name="BaseBox" Margin="0,0,6,4" MinWidth="130" FlowDirection="LeftToRight" FontFamily="Cascadia Mono, Consolas"
                     AutomationProperties.AutomationId="Disasm_BaseAddress" KeyDown="BaseBox_KeyDown" LostFocus="BaseBox_LostFocus" />
            <ComboBox x:Name="SyntaxBox" Margin="0,0,6,4" MinWidth="90" AutomationProperties.AutomationId="Disasm_Syntax" SelectionChanged="SyntaxBox_SelectionChanged" />
            <DropDownButton x:Name="OptionsButton" Margin="0,0,6,4" AutomationProperties.AutomationId="Disasm_Options">
                <DropDownButton.Flyout>
                    <Flyout x:Name="OptionsFlyout" Placement="Bottom">
                        <StackPanel x:Name="OptionsPanel" Spacing="6" MinWidth="240" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <ToggleButton x:Name="FollowToggle" Margin="0,0,6,4" AutomationProperties.AutomationId="Disasm_Follow" IsChecked="True" Click="FollowToggle_Click" />
            <Button x:Name="FindButton" Margin="0,0,6,4" AutomationProperties.AutomationId="Disasm_FindPatternButton" Click="FindButton_Click" />
            <Button x:Name="NativeButton" Margin="0,0,6,4" AutomationProperties.AutomationId="Disasm_NativeCode" Click="NativeButton_Click" Visibility="Collapsed" />
        </local:WrapPanel>
        <StackPanel Grid.Row="1" Spacing="4">
            <!--  変換ビュー (EDIT-45) が有効なら、変換後のデータを逆アセンブルしていることを示す (06 の 0.1.1)  -->
            <TextBlock x:Name="TransformNote" AutomationProperties.AutomationId="Disasm_TransformNote" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <InfoBar x:Name="EngineBar" AutomationProperties.AutomationId="Disasm_EngineError" IsClosable="False" Severity="Error" />
            <InfoBar x:Name="DataBar" AutomationProperties.AutomationId="Disasm_MostlyData" IsClosable="True" Severity="Warning" />
            <InfoBar x:Name="HeaderBar" AutomationProperties.AutomationId="Disasm_HeaderIssues" IsClosable="True" Severity="Warning" />
            <InfoBar x:Name="DotNetBar" AutomationProperties.AutomationId="Disasm_DotNet" IsClosable="True" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="DotNetAction" AutomationProperties.AutomationId="Disasm_DotNetAction" Click="DotNetAction_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <Grid x:Name="SearchRow" Grid.Row="2" ColumnSpacing="6" RowSpacing="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="PatternBox" FlowDirection="LeftToRight" FontFamily="Cascadia Mono, Consolas" AutomationProperties.AutomationId="Disasm_PatternBox"
                     KeyDown="PatternBox_KeyDown" />
            <CheckBox x:Name="RegexCheck" Grid.Column="1" MinWidth="0" AutomationProperties.AutomationId="Disasm_PatternRegex" />
            <Button x:Name="PatternFindAll" Grid.Column="2" AutomationProperties.AutomationId="Disasm_PatternFindAll" Click="PatternFindAll_Click" />
            <Button x:Name="PatternClose" Grid.Column="3" AutomationProperties.AutomationId="Disasm_PatternClose" Click="PatternClose_Click">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
            <TextBlock x:Name="PatternError" Grid.Row="1" Grid.ColumnSpan="4" AutomationProperties.AutomationId="Disasm_PatternError" AutomationProperties.LiveSetting="Assertive"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="Body" Grid.Row="3" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="LeftPane" Grid.Row="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="LeftTabs" AutomationProperties.AutomationId="Disasm_LeftTabs" SelectionChanged="LeftTabs_SelectionChanged">
                    <SelectorBarItem x:Name="SectionsTab" AutomationProperties.AutomationId="Disasm_SectionsTab" IsSelected="True" />
                    <SelectorBarItem x:Name="SymbolsTab" AutomationProperties.AutomationId="Disasm_SymbolsTab" />
                </SelectorBar>
                <TextBox x:Name="SymbolFilter" Grid.Row="1" AutomationProperties.AutomationId="Disasm_SymbolFilter" TextChanged="SymbolFilter_TextChanged" Visibility="Collapsed" />
                <ListView x:Name="SectionsList" Grid.Row="2" AutomationProperties.AutomationId="Disasm_Sections" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="SectionsList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DisasmSectionRow">
                            <StackPanel Padding="0,2" AutomationProperties.Name="{x:Bind Name}">
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" FlowDirection="LeftToRight">
                                    <Run Text="{x:Bind Address}" /><Run Text=" " /><Run Text="{x:Bind VirtualSize}" /><Run Text=" " /><Run Text="{x:Bind Flags}" />
                                </TextBlock>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" FlowDirection="LeftToRight">
                                    <Run Text="@" /><Run Text="{x:Bind FileOffset}" /><Run Text=" " /><Run Text="{x:Bind FileSize}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="SymbolsList" Grid.Row="2" AutomationProperties.AutomationId="Disasm_Symbols" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="SymbolsList_ItemClick" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DisasmSymbolRow">
                            <StackPanel Padding="0,2" AutomationProperties.Name="{x:Bind Name}">
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" FlowDirection="LeftToRight">
                                    <Run Text="{x:Bind Address}" /><Run Text=" " /><Run Text="{x:Bind Kind}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TreeView x:Name="MethodTree" Grid.Row="2" AutomationProperties.AutomationId="Disasm_Methods" Visibility="Collapsed" Expanding="MethodTree_Expanding" ItemInvoked="MethodTree_ItemInvoked" />
            </Grid>
            <local:DisassemblyListingView x:Name="Listing" Grid.Row="1" Grid.Column="1" />
        </Grid>
    </Grid>
</UserControl>
