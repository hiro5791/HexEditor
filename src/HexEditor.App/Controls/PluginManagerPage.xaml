<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.PluginManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="PluginManagerPage">
    <!--
        プラグインマネージャ (08 の AUTO-32)。設定画面と同じ形式のページ: 上に追加と再起動、一覧 (名前・バージョン・発行者・署名・状態・説明・
        拡張ポイント)、選んだプラグインの操作 (有効 / 無効、プラグインのフォルダを開く、削除、設定)、開発用のフォルダ (AUTO-33)、信頼済みの発行者
        (AUTO-35)。一覧には .hexplugin をドラッグ & ドロップできる。キーボードだけで操作できる (Tab で 一覧 → 有効 → フォルダを開く の順)。
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Padding="24,16,24,24" HorizontalAlignment="Stretch" Spacing="12">
            <TextBlock x:Name="TitleText" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="IntroText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <InfoBar
                x:Name="SafeModeBar"
                AutomationProperties.AutomationId="PluginManager_SafeMode"
                IsClosable="False"
                IsOpen="{x:Bind Vm.IsSafeMode, Mode=OneWay}"
                Severity="Informational" />
            <InfoBar
                x:Name="MessageBar"
                AutomationProperties.AutomationId="PluginManager_Message"
                IsClosable="False"
                IsOpen="{x:Bind Vm.HasMessage, Mode=OneWay}"
                Message="{x:Bind Vm.Message, Mode=OneWay}"
                Severity="{x:Bind MessageSeverity(Vm.MessageIsError), Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="AddButton"
                    AutomationProperties.AutomationId="PluginManager_Add"
                    Command="{x:Bind Vm.AddCommand}" />
                <Button
                    x:Name="RestartButton"
                    AutomationProperties.AutomationId="PluginManager_Restart"
                    Command="{x:Bind Vm.RestartCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind Vm.RestartRequired, Mode=OneWay}" />
            </StackPanel>
            <ListView
                x:Name="PluginList"
                MinHeight="120"
                MaxHeight="420"
                AllowDrop="True"
                AutomationProperties.AutomationId="PluginManager_List"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                DragOver="PluginList_DragOver"
                Drop="PluginList_Drop"
                ItemsSource="{x:Bind Vm.Items}"
                SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginItemViewModel">
                        <StackPanel
                            Padding="0,8"
                            AutomationProperties.AutomationId="{x:Bind Id}"
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                            Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind VersionAndPublisher, Mode=OneWay}" />
                                <Border
                                    Padding="6,0"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{x:Bind IsDevelopment}">
                                    <TextBlock Text="{x:Bind DevelopmentText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SignatureText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasDescription, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ExtensionsText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <ToggleSwitch
                    x:Name="EnabledSwitch"
                    AutomationProperties.AutomationId="PluginManager_Enabled"
                    IsEnabled="{x:Bind Vm.CanToggle, Mode=OneWay}"
                    IsOn="{x:Bind Vm.SelectedEnabled, Mode=TwoWay}" />
                <Button
                    x:Name="OpenFolderButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PluginManager_OpenFolder"
                    Command="{x:Bind Vm.OpenFolderCommand}" />
                <Button
                    x:Name="RemoveButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PluginManager_Remove"
                    Command="{x:Bind Vm.RemoveCommand}"
                    IsEnabled="{x:Bind Vm.CanRemove, Mode=OneWay}" />
                <Button
                    x:Name="SettingsButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PluginManager_Settings"
                    Command="{x:Bind Vm.OpenSettingsCommand}"
                    IsEnabled="{x:Bind Vm.SelectedHasSettings, Mode=OneWay}" />
            </StackPanel>
            <TextBlock x:Name="DevHeading" Margin="0,12,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock
                x:Name="DevIntro"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <ItemsControl x:Name="DevFolderList" ItemsSource="{x:Bind Vm.DevFolders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                Text="{x:Bind}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.AutomationId="PluginManager_RemoveDevFolder"
                                AutomationProperties.Name="{x:Bind}"
                                Click="RemoveDevFolder_Click"
                                Tag="{x:Bind}">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                x:Name="AddDevFolderButton"
                AutomationProperties.AutomationId="PluginManager_AddDevFolder"
                Command="{x:Bind Vm.AddDevFolderCommand}" />
            <TextBlock x:Name="PublisherHeading" Margin="0,12,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock
                x:Name="NoPublishersText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <ItemsControl x:Name="PublisherList" ItemsSource="{x:Bind Vm.Publishers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrustedPublisherItem">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.AutomationId="PluginManager_RevokePublisher"
                                AutomationProperties.Name="{x:Bind Name}"
                                Click="RevokePublisher_Click"
                                Tag="{x:Bind}">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
