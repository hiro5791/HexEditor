<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.ScriptListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="ScriptListPanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        スクリプト一覧 (AUTO-19)。上部: 絞り込みの検索欄と「新規作成」。下: 利用者のスクリプト (サブフォルダはツリー)・マクロ・追加したフォルダ・
        サンプルの木。Enter / ダブルクリックで実行、Shift+F10 / 右クリックのメニューで編集・名前の変更・削除・ショートカットの割り当てなど。
    -->
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="8,6,8,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FilterBox"
                AutomationProperties.AutomationId="ScriptList_Filter"
                KeyDown="Filter_KeyDown"
                Text="{x:Bind Vm.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="NewButton" Grid.Column="1" AutomationProperties.AutomationId="ScriptList_New">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="NewJsItem" AutomationProperties.AutomationId="ScriptList_NewJs" Click="NewJs_Click" />
                        <MenuFlyoutItem x:Name="NewCSharpItem" AutomationProperties.AutomationId="ScriptList_NewCSharp" Click="NewCSharp_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="OpenFolderItem" AutomationProperties.AutomationId="ScriptList_OpenFolder" Click="OpenFolder_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <TreeView
            x:Name="Tree"
            Grid.Row="1"
            AutomationProperties.AutomationId="ScriptList_Tree"
            DoubleTapped="Tree_DoubleTapped"
            ItemsSource="{x:Bind Vm.Items}"
            KeyDown="Tree_KeyDown"
            SelectionMode="Single">
            <TreeView.ContextFlyout>
                <MenuFlyout x:Name="ItemMenu" Opening="ItemMenu_Opening" />
            </TreeView.ContextFlyout>
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:ScriptListItem">
                    <TreeViewItem
                        AutomationProperties.AutomationId="ScriptList_Item"
                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        ItemsSource="{x:Bind Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock AutomationProperties.AutomationId="ScriptList_Name" Text="{x:Bind DisplayName}" />
                            <TextBlock
                                AutomationProperties.AutomationId="ScriptList_Language"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind LanguageText}" />
                            <TextBlock
                                AutomationProperties.AutomationId="ScriptList_Shortcut"
                                FontSize="11"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind ShortcutText, Mode=OneWay}" />
                            <TextBlock
                                AutomationProperties.AutomationId="ScriptList_Resident"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind ResidentText, Mode=OneWay}" />
                            <TextBlock
                                AutomationProperties.AutomationId="ScriptList_Description"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                AutomationProperties.AutomationId="ScriptList_HookCandidate"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind HookCandidateText}" />
                            <TextBlock
                                AutomationProperties.AutomationId="ScriptList_Missing"
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind local:ScriptListPanel.MissingText(IsMissing)}" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
