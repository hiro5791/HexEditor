<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.FindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls">
    <!--
        検索バー (FIND-04)。モーダルにせず、エディタの上に表示する。
        1 行目: 種類、検索欄 (履歴のドロップダウン付き)、変換結果・状態、件数、前 / 次、すべて検索、オプションの開閉、閉じる。
        2 行目 (置換のとき): 置換欄、変換結果、置換・スキップ・すべて置換、長さが違う場合の扱い (FIND-22〜24)。
        3 行目: オプション (幅が足りなければ折り返す)。
    -->
    <StackPanel
        Padding="12,6"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1"
        Spacing="6">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="KindChoice"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_Kind"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_Kind_Hex" />
                <ComboBoxItem x:Uid="Find_Kind_Text" />
                <ComboBoxItem x:Uid="Find_Kind_Integer" />
                <ComboBoxItem x:Uid="Find_Kind_Float" />
                <ComboBoxItem x:Uid="Find_Kind_RegexText" />
                <ComboBoxItem x:Uid="Find_Kind_RegexBytes" />
            </ComboBox>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="2">
                <TextBox
                    x:Name="Query"
                    x:Uid="Find_Query"
                    Width="260"
                    AutomationProperties.AutomationId="Find_Query"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    KeyDown="Query_KeyDown"
                    TextChanged="Query_TextChanged"
                    TextCompositionEnded="Query_CompositionEnded"
                    TextCompositionStarted="Query_CompositionStarted" />
                <!--  複数語 (FIND-26): 検索欄を複数行の一覧に変える。  -->
                <ToggleButton
                    x:Name="MultiTermToggle"
                    Padding="6,4"
                    AutomationProperties.AutomationId="Find_MultiTerm"
                    Checked="MultiTermToggle_Changed"
                    Unchecked="MultiTermToggle_Changed">
                    <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                </ToggleButton>
                <!--  検索履歴の一覧 (FIND-28 の仕様 4)。  -->
                <Button
                    x:Name="HistoryButton"
                    Padding="6,4"
                    AutomationProperties.AutomationId="Find_History">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    <Button.Flyout>
                        <Flyout x:Name="HistoryFlyout" Opening="HistoryFlyout_Opening" Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="360" Spacing="4">
                                <TextBlock x:Name="HistoryEmpty" x:Uid="Find_HistoryEmpty" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="HistoryItems" AutomationProperties.AutomationId="Find_HistoryList" Spacing="2" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="Status"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_Status"
                AutomationProperties.LiveSetting="Polite"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="CountText"
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_Count"
                AutomationProperties.LiveSetting="Polite"
                FlowDirection="LeftToRight" />
            <Button
                x:Name="CountButton"
                x:Uid="Find_CountButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="Find_CountButton"
                Click="Count_Click"
                Visibility="Collapsed" />
            <Button
                x:Name="PreviousButton"
                Grid.Column="4"
                AutomationProperties.AutomationId="Find_Previous"
                Click="Previous_Click">
                <FontIcon FontSize="12" Glyph="&#xE70E;" />
            </Button>
            <Button
                x:Name="NextButton"
                Grid.Column="5"
                AutomationProperties.AutomationId="Find_Next"
                Click="Next_Click"
                Style="{StaticResource AccentButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE70D;" />
            </Button>
            <!--  すべて検索 (FIND-20。Alt+Enter)。  -->
            <Button
                x:Name="FindAllButton"
                x:Uid="Find_FindAll"
                Grid.Column="6"
                AutomationProperties.AutomationId="Find_FindAll"
                Click="FindAll_Click" />
            <ToggleButton
                x:Name="OptionsToggle"
                Grid.Column="7"
                AutomationProperties.AutomationId="Find_Options"
                Checked="OptionsToggle_Click"
                Unchecked="OptionsToggle_Click">
                <FontIcon FontSize="12" Glyph="&#xE71C;" />
            </ToggleButton>
            <!--  0.5 秒を超えた検索の進捗バーとキャンセルボタン (FIND-02 の仕様 1)。  -->
            <StackPanel
                x:Name="BusyPanel"
                Grid.Column="8"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <ProgressBar
                    x:Name="Progress"
                    Width="80"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Find_Progress"
                    Maximum="1" />
                <Button
                    x:Name="CancelButton"
                    x:Uid="Find_Cancel"
                    AutomationProperties.AutomationId="Find_Cancel"
                    Click="Cancel_Click" />
            </StackPanel>
            <Button
                x:Name="CloseButton"
                Grid.Column="9"
                AutomationProperties.AutomationId="Find_Close"
                Click="Close_Click">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!--  複数語の一覧 (FIND-26 の画面)。行ごとに有効、種類、検索語、文字コード・サイズ・エンディアン。  -->
        <StackPanel
            x:Name="MultiTermRow"
            Spacing="4"
            Visibility="Collapsed">
            <local:WrapPanel>
                <Button x:Name="TermAddButton" x:Uid="Find_TermAdd" AutomationProperties.AutomationId="Find_TermAdd" Click="TermAdd_Click" />
                <Button x:Name="TermRemoveButton" x:Uid="Find_TermRemove" AutomationProperties.AutomationId="Find_TermRemove" Click="TermRemove_Click" />
                <Button x:Name="TermUpButton" x:Uid="Find_TermUp" AutomationProperties.AutomationId="Find_TermUp" Click="TermMove_Click" Tag="-1" />
                <Button x:Name="TermDownButton" x:Uid="Find_TermDown" AutomationProperties.AutomationId="Find_TermDown" Click="TermMove_Click" Tag="1" />
                <Button x:Name="TermImportButton" x:Uid="Find_TermImport" AutomationProperties.AutomationId="Find_TermImport" Click="TermImport_Click" />
                <Button x:Name="TermSaveButton" x:Uid="Find_TermSave" AutomationProperties.AutomationId="Find_TermSave" Click="TermSave_Click" />
                <Button x:Name="TermLoadButton" x:Uid="Find_TermLoad" AutomationProperties.AutomationId="Find_TermLoad" Click="TermLoad_Click" />
                <TextBlock
                    x:Name="TermSummary"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Find_TermSummary"
                    AutomationProperties.LiveSetting="Polite" />
            </local:WrapPanel>
            <ListView
                x:Name="TermList"
                MaxHeight="200"
                AutomationProperties.AutomationId="Find_TermList"
                ItemsSource="{x:Bind Terms}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TermRow">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox
                                MinWidth="0"
                                AutomationProperties.Name="{x:Bind EnabledName, Mode=OneTime}"
                                IsChecked="{x:Bind Enabled, Mode=TwoWay}" />
                            <ComboBox
                                Width="120"
                                AutomationProperties.Name="{x:Bind KindName, Mode=OneTime}"
                                ItemsSource="{x:Bind KindNames, Mode=OneTime}"
                                SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}" />
                            <TextBox
                                Width="220"
                                AutomationProperties.Name="{x:Bind TextName, Mode=OneTime}"
                                BorderBrush="{x:Bind ErrorBrush, Mode=OneWay}"
                                FlowDirection="LeftToRight"
                                FontFamily="Cascadia Mono, Consolas"
                                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Width="200"
                                AutomationProperties.Name="{x:Bind OptionName, Mode=OneTime}"
                                ItemsSource="{x:Bind OptionNames, Mode=OneWay}"
                                SelectedIndex="{x:Bind OptionIndex, Mode=TwoWay}"
                                Visibility="{x:Bind OptionVisibility, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind Error, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!--  置換欄の行 (FIND-22〜24)。Ctrl+H で開いたときだけ出す。  -->
        <local:WrapPanel x:Name="ReplaceRow" Visibility="Collapsed">
            <TextBox
                x:Name="ReplaceQuery"
                x:Uid="Find_Replace"
                Width="260"
                AutomationProperties.AutomationId="Find_Replace"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                KeyDown="ReplaceQuery_KeyDown"
                TextChanged="ReplaceQuery_TextChanged" />
            <TextBlock
                x:Name="ReplacePreview"
                MaxWidth="320"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_ReplacePreview"
                AutomationProperties.LiveSetting="Polite"
                FlowDirection="LeftToRight"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="ReplaceButton"
                x:Uid="Find_ReplaceOne"
                AutomationProperties.AutomationId="Find_ReplaceOne"
                Click="Replace_Click" />
            <Button
                x:Name="SkipButton"
                x:Uid="Find_Skip"
                AutomationProperties.AutomationId="Find_Skip"
                Click="Skip_Click" />
            <Button
                x:Name="ReplaceAllButton"
                x:Uid="Find_ReplaceAll"
                AutomationProperties.AutomationId="Find_ReplaceAll"
                Click="ReplaceAll_Click" />
            <ComboBox
                x:Name="LengthPolicyChoice"
                AutomationProperties.AutomationId="Find_LengthPolicy"
                SelectionChanged="ReplaceOption_Changed">
                <ComboBoxItem x:Name="PolicyChangeItem" x:Uid="Find_Policy_Change" />
                <ComboBoxItem x:Uid="Find_Policy_Pad" />
                <ComboBoxItem x:Uid="Find_Policy_Overwrite" />
            </ComboBox>
            <ComboBox
                x:Name="FillerChoice"
                AutomationProperties.AutomationId="Find_Filler"
                SelectedIndex="0"
                SelectionChanged="ReplaceOption_Changed">
                <ComboBoxItem x:Uid="Find_Filler_Zero" />
                <ComboBoxItem x:Uid="Find_Filler_FF" />
                <ComboBoxItem x:Uid="Find_Filler_Space" />
                <ComboBoxItem x:Uid="Find_Filler_Custom" />
            </ComboBox>
            <TextBox
                x:Name="FillerCustom"
                x:Uid="Find_FillerCustom"
                Width="120"
                AutomationProperties.AutomationId="Find_FillerCustom"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                TextChanged="ReplaceQuery_TextChanged"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ReplaceReason"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_ReplaceReason"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap" />
        </local:WrapPanel>

        <!--  オプション (FIND-04 の仕様 4)。種類に応じて表示を切り替える。  -->
        <local:WrapPanel x:Name="OptionsPanel" Visibility="Collapsed">
            <ComboBox
                x:Name="DirectionChoice"
                AutomationProperties.AutomationId="Find_Direction"
                SelectedIndex="0">
                <ComboBoxItem x:Uid="Find_Direction_Forward" />
                <ComboBoxItem x:Uid="Find_Direction_Backward" />
            </ComboBox>
            <CheckBox
                x:Name="WrapChoice"
                x:Uid="Find_Wrap"
                AutomationProperties.AutomationId="Find_Wrap"
                IsChecked="True" />
            <ComboBox
                x:Name="ScopeChoice"
                AutomationProperties.AutomationId="Find_Scope"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_Scope_Document" />
                <ComboBoxItem x:Name="ScopeSelectionItem" x:Uid="Find_Scope_Selection" />
                <ComboBoxItem x:Uid="Find_Scope_Range" />
                <ComboBoxItem x:Uid="Find_Scope_AllDocuments" />
            </ComboBox>
            <!--  オフセット範囲 (FIND-11 の仕様 1)。入力式で開始と終了 (このバイトを含む) を書く。  -->
            <TextBox
                x:Name="RangeStart"
                x:Uid="Find_RangeStart"
                Width="140"
                AutomationProperties.AutomationId="Find_RangeStart"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                TextChanged="Range_TextChanged"
                Visibility="Collapsed" />
            <TextBox
                x:Name="RangeEnd"
                x:Uid="Find_RangeEnd"
                Width="140"
                AutomationProperties.AutomationId="Find_RangeEnd"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                TextChanged="Range_TextChanged"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="RangeInfo"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_RangeInfo"
                AutomationProperties.LiveSetting="Polite"
                FlowDirection="LeftToRight"
                Visibility="Collapsed" />
            <ComboBox
                x:Name="EncodingChoice"
                AutomationProperties.AutomationId="Find_Encoding"
                SelectionChanged="Option_Changed" />
            <!--  複数の文字コード (FIND-08): チェックボックス付きの一覧 (最大 8 種類) と、名前を付けて保存した組み合わせ。  -->
            <DropDownButton
                x:Name="MultiEncodingButton"
                AutomationProperties.AutomationId="Find_MultiEncoding"
                Visibility="Collapsed">
                <DropDownButton.Flyout>
                    <Flyout x:Name="MultiEncodingFlyout" Opening="MultiEncodingFlyout_Opening" Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="320" Spacing="6">
                            <TextBlock x:Name="MultiEncodingHint" TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="280">
                                <StackPanel x:Name="MultiEncodingList" AutomationProperties.AutomationId="Find_MultiEncodingList" />
                            </ScrollViewer>
                            <ComboBox
                                x:Name="EncodingSetChoice"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="Find_EncodingSet"
                                SelectionChanged="EncodingSet_Changed" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox
                                    x:Name="EncodingSetName"
                                    x:Uid="Find_EncodingSetName"
                                    Width="180"
                                    AutomationProperties.AutomationId="Find_EncodingSetName" />
                                <Button x:Name="EncodingSetSave" x:Uid="Find_EncodingSetSave" AutomationProperties.AutomationId="Find_EncodingSetSave" Click="EncodingSetSave_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <!--  符号化できずに除いた文字コードの警告 (FIND-08 の仕様 6)。  -->
            <StackPanel
                x:Name="EncodingWarning"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="Collapsed">
                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    x:Name="EncodingWarningText"
                    MaxWidth="360"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Find_EncodingWarning"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox
                x:Name="CaseChoice"
                x:Uid="Find_CaseSensitive"
                AutomationProperties.AutomationId="Find_CaseSensitive"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <CheckBox
                x:Name="WordChoice"
                x:Uid="Find_WholeWord"
                AutomationProperties.AutomationId="Find_WholeWord"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <CheckBox
                x:Name="EscapeChoice"
                x:Uid="Find_Escapes"
                AutomationProperties.AutomationId="Find_Escapes"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <CheckBox
                x:Name="AlignChoice"
                x:Uid="Find_Align"
                AutomationProperties.AutomationId="Find_Align"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <!--  正規表現のフラグ (FIND-18 の仕様 2) と、一致の最大長の説明 (FIND-01 の仕様 3)。  -->
            <CheckBox
                x:Name="RegexIgnoreCase"
                x:Uid="Find_RegexIgnoreCase"
                AutomationProperties.AutomationId="Find_RegexIgnoreCase"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <CheckBox
                x:Name="RegexMultiline"
                x:Uid="Find_RegexMultiline"
                AutomationProperties.AutomationId="Find_RegexMultiline"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <CheckBox
                x:Name="RegexSingleline"
                x:Uid="Find_RegexSingleline"
                AutomationProperties.AutomationId="Find_RegexSingleline"
                Checked="RegexSingleline_Changed"
                Unchecked="RegexSingleline_Changed" />
            <TextBlock
                x:Name="RegexNote"
                MaxWidth="420"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_RegexNote"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <HyperlinkButton
                x:Name="RegexSettingsLink"
                x:Uid="Find_RegexSettings"
                AutomationProperties.AutomationId="Find_RegexSettings"
                Click="RegexSettings_Click" />
            <!--  ビットマスク (FIND-16): 値とマスク、またはビットパターン。  -->
            <CheckBox
                x:Name="MaskChoice"
                x:Uid="Find_Mask"
                AutomationProperties.AutomationId="Find_Mask"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <ComboBox
                x:Name="MaskModeChoice"
                AutomationProperties.AutomationId="Find_MaskMode"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_MaskMode_ValueMask" />
                <ComboBoxItem x:Uid="Find_MaskMode_Bits" />
            </ComboBox>
            <TextBox
                x:Name="MaskQuery"
                x:Uid="Find_MaskQuery"
                Width="200"
                AutomationProperties.AutomationId="Find_MaskQuery"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                TextChanged="Range_TextChanged" />
            <!--  一致しない箇所 (FIND-25)。  -->
            <CheckBox
                x:Name="MismatchChoice"
                x:Uid="Find_Mismatch"
                AutomationProperties.AutomationId="Find_Mismatch"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <CheckBox
                x:Name="MismatchAlignChoice"
                x:Uid="Find_MismatchAlign"
                AutomationProperties.AutomationId="Find_MismatchAlign"
                Checked="Check_Changed"
                IsChecked="True"
                Unchecked="Check_Changed" />
            <!--  範囲の検索の「除外」(FIND-15 の仕様 5)。  -->
            <CheckBox
                x:Name="RangeExcludeChoice"
                x:Uid="Find_RangeExclude"
                AutomationProperties.AutomationId="Find_RangeExclude"
                Checked="Check_Changed"
                Unchecked="Check_Changed" />
            <!--  位置の条件 (FIND-17): 条件なし / 指定する (x、y、基準)。よく使う値のボタン。  -->
            <ComboBox
                x:Name="PositionChoice"
                AutomationProperties.AutomationId="Find_Position"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_Position_None" />
                <ComboBoxItem x:Uid="Find_Position_Custom" />
            </ComboBox>
            <TextBox
                x:Name="PositionModulus"
                x:Uid="Find_PositionModulus"
                Width="110"
                AutomationProperties.AutomationId="Find_PositionModulus"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                TextChanged="Range_TextChanged" />
            <TextBox
                x:Name="PositionRemainder"
                x:Uid="Find_PositionRemainder"
                Width="110"
                AutomationProperties.AutomationId="Find_PositionRemainder"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                TextChanged="Range_TextChanged" />
            <ComboBox
                x:Name="PositionBaseChoice"
                AutomationProperties.AutomationId="Find_PositionBase"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_PositionBase_Offset" />
                <ComboBoxItem x:Uid="Find_PositionBase_Address" />
            </ComboBox>
            <Button x:Name="PositionPreset2" x:Uid="Find_PositionPreset2" AutomationProperties.AutomationId="Find_PositionPreset2" Click="PositionPreset_Click" Tag="2" />
            <Button x:Name="PositionPreset4" x:Uid="Find_PositionPreset4" AutomationProperties.AutomationId="Find_PositionPreset4" Click="PositionPreset_Click" Tag="4" />
            <Button x:Name="PositionPreset8" x:Uid="Find_PositionPreset8" AutomationProperties.AutomationId="Find_PositionPreset8" Click="PositionPreset_Click" Tag="8" />
            <Button x:Name="PositionPreset16" x:Uid="Find_PositionPreset16" AutomationProperties.AutomationId="Find_PositionPreset16" Click="PositionPreset_Click" Tag="16" />
            <Button x:Name="PositionPresetSector" x:Uid="Find_PositionPresetSector" AutomationProperties.AutomationId="Find_PositionPresetSector" Click="PositionPreset_Click" Tag="sector" />
            <TextBlock
                x:Name="PositionInfo"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Find_PositionInfo"
                AutomationProperties.LiveSetting="Polite"
                FlowDirection="LeftToRight" />
            <!--  整数 (FIND-13): サイズ、符号、エンディアン。  -->
            <ComboBox
                x:Name="IntBitsChoice"
                AutomationProperties.AutomationId="Find_IntBits"
                SelectionChanged="Option_Changed" />
            <ComboBox
                x:Name="SignChoice"
                AutomationProperties.AutomationId="Find_Sign"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_Sign_Either" />
                <ComboBoxItem x:Uid="Find_Sign_Signed" />
                <ComboBoxItem x:Uid="Find_Sign_Unsigned" />
            </ComboBox>
            <!--  浮動小数点 (FIND-14): 形式、許容誤差。  -->
            <ComboBox
                x:Name="FloatChoice"
                AutomationProperties.AutomationId="Find_FloatFormat"
                SelectedIndex="1"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_Float_Half" />
                <ComboBoxItem x:Uid="Find_Float_Single" />
                <ComboBoxItem x:Uid="Find_Float_Double" />
            </ComboBox>
            <ComboBox
                x:Name="EndianChoice"
                AutomationProperties.AutomationId="Find_Endian"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_Endian_Little" />
                <ComboBoxItem x:Uid="Find_Endian_Big" />
                <ComboBoxItem x:Uid="Find_Endian_Both" />
            </ComboBox>
            <ComboBox
                x:Name="ToleranceChoice"
                AutomationProperties.AutomationId="Find_Tolerance"
                SelectedIndex="0"
                SelectionChanged="Option_Changed">
                <ComboBoxItem x:Uid="Find_Tolerance_None" />
                <ComboBoxItem x:Uid="Find_Tolerance_Absolute" />
                <ComboBoxItem x:Uid="Find_Tolerance_Relative" />
                <ComboBoxItem x:Uid="Find_Tolerance_Ulp" />
            </ComboBox>
            <TextBox
                x:Name="ToleranceValue"
                x:Uid="Find_ToleranceValue"
                Width="120"
                AutomationProperties.AutomationId="Find_ToleranceValue"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                TextChanged="Range_TextChanged" />
            <CheckBox
                x:Name="OverlapChoice"
                x:Uid="Find_Overlapping"
                AutomationProperties.AutomationId="Find_Overlapping" />
            <CheckBox
                x:Name="IncrementalChoice"
                x:Uid="Find_Incremental"
                AutomationProperties.AutomationId="Find_Incremental"
                IsChecked="True" />
            <CheckBox
                x:Name="EscReturnChoice"
                x:Uid="Find_EscReturns"
