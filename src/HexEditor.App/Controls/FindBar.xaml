<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.FindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  検索バー (FIND-04)。モーダルにせず、エディタの上に表示する。  -->
    <Grid
        Padding="12,6"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1"
        ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox
            x:Name="KindChoice"
            AutomationProperties.AutomationId="Find_Kind"
            SelectedIndex="0"
            SelectionChanged="Option_Changed">
            <ComboBoxItem x:Uid="Find_Kind_Hex" />
            <ComboBoxItem x:Uid="Find_Kind_Text" />
        </ComboBox>
        <TextBox
            x:Name="Query"
            x:Uid="Find_Query"
            Grid.Column="1"
            Width="260"
            AutomationProperties.AutomationId="Find_Query"
            FlowDirection="LeftToRight"
            FontFamily="Cascadia Mono, Consolas"
            KeyDown="Query_KeyDown"
            TextChanged="Query_TextChanged" />
        <ComboBox
            x:Name="EncodingChoice"
            Grid.Column="2"
            AutomationProperties.AutomationId="Find_Encoding"
            SelectedIndex="0"
            SelectionChanged="Option_Changed"
            Visibility="Collapsed">
            <ComboBoxItem Content="ASCII" />
            <ComboBoxItem Content="UTF-8" />
            <ComboBoxItem Content="UTF-16 LE" />
            <ComboBoxItem Content="UTF-16 BE" />
            <ComboBoxItem Content="Shift_JIS" />
        </ComboBox>
        <TextBlock
            x:Name="Status"
            Grid.Column="3"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="Find_Status"
            AutomationProperties.LiveSetting="Polite"
            TextTrimming="CharacterEllipsis" />
        <CheckBox
            x:Name="WrapChoice"
            x:Uid="Find_Wrap"
            Grid.Column="4"
            MinWidth="0"
            AutomationProperties.AutomationId="Find_Wrap"
            IsChecked="True" />
        <Button
            x:Name="PreviousButton"
            Grid.Column="5"
            AutomationProperties.AutomationId="Find_Previous"
            Click="Previous_Click">
            <FontIcon FontSize="12" Glyph="&#xE70E;" />
        </Button>
        <Button
            x:Name="NextButton"
            Grid.Column="6"
            AutomationProperties.AutomationId="Find_Next"
            Click="Next_Click"
            Style="{StaticResource AccentButtonStyle}">
            <FontIcon FontSize="12" Glyph="&#xE70D;" />
        </Button>
        <ProgressRing
            x:Name="Busy"
            Grid.Column="7"
            Width="16"
            Height="16"
            IsActive="False" />
        <Button
            x:Name="CloseButton"
            Grid.Column="8"
            AutomationProperties.AutomationId="Find_Close"
            Click="Close_Click">
            <FontIcon FontSize="12" Glyph="&#xE711;" />
        </Button>
    </Grid>
</UserControl>
