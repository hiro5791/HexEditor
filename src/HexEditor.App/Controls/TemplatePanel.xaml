<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HexEditor.App.Controls.TemplatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HexEditor.App.Controls"
    xmlns:vm="using:HexEditor.App.ViewModels"
    AutomationProperties.AutomationId="TemplatePanel"
    AutomationProperties.LandmarkType="Custom">
    <!--
        結果ツリーパネル (TPL-21)。上部にツールバー (適用、再実行、評価を中止、検索、エクスポート、表示する列、カーソルに追従)、
        中央にツリー表 (仮想化。表示中の行だけを描く)、下部にパス表示と評価の状態。
        キー: ↑ / ↓ で移動、→ / ← で開閉、Enter で Hex ビューの該当範囲へ、Ctrl+C で値をコピー、Shift+F10 で右クリックメニュー。
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:TemplateRowViewModel">
            <Grid
                Margin="{x:Bind Indent, Mode=OneWay}"
                Background="Transparent"
                ColumnSpacing="6"
                ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Layout.Width0, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width1, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width2, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width3, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width4, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width5, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width6, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width7, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.Width8, Mode=OneWay}" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="{x:Bind Layout.NameColumn, Mode=OneWay}"
                    Orientation="Horizontal"
                    Spacing="4">
                    <FontIcon
                        Width="12"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="10"
                        Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" />
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        Glyph="{x:Bind KindGlyph, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Tpl_RowStatus"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        Visibility="{x:Bind StatusVisibility, Mode=OneWay}" />
                    <Border
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Background="{x:Bind AttributeSwatch, Mode=OneWay}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Visibility="{x:Bind AttributeSwatchVisibility, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <!--  ビジュアライザで表示する (TPL-16 の「呼び出し」: 結果ツリーのノードの「表示」ボタン)。  -->
                    <Button
                        Padding="4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Tpl_RowVisualize"
                        AutomationProperties.Name="{x:Bind VisualizerButtonName, Mode=OneWay}"
                        Click="{x:Bind ShowVisualizer}"
                        IsTabStop="False"
                        ToolTipService.ToolTip="{x:Bind VisualizerButtonName, Mode=OneWay}"
                        Visibility="{x:Bind VisualizerVisibility, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE8B9;" />
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Column="{x:Bind Layout.ValueColumn, Mode=OneWay}"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind Layout.ValueVisibility, Mode=OneWay}">
                    <!--  色の型の値の色見本 (TPL-03 の仕様 4)。UI オートメーションの要素にする (TC-TPL-03-04)。  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Tpl_ValueSwatch"
                        AutomationProperties.Name="{x:Bind Value, Mode=OneWay}"
                        FontSize="16"
                        Foreground="{x:Bind ValueSwatch, Mode=OneWay}"
                        Text="&#x25A0;"
                        Visibility="{x:Bind ValueSwatchVisibility, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FlowDirection="LeftToRight"
                        FontFamily="Cascadia Mono, Consolas"
                        Text="{x:Bind Value, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Grid.Column="{x:Bind Layout.TypeColumn, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Type, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Layout.TypeVisibility, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="{x:Bind Layout.OffsetColumn, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    Text="{x:Bind OffsetText, Mode=OneWay}"
                    Visibility="{x:Bind Layout.OffsetVisibility, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="{x:Bind Layout.SizeColumn, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    Text="{x:Bind SizeText, Mode=OneWay}"
                    TextAlignment="Right"
                    Visibility="{x:Bind Layout.SizeVisibility, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="{x:Bind Layout.CommentColumn, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Text="{x:Bind Comment, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Layout.CommentVisibility, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="{x:Bind Layout.EndianColumn, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Text="{x:Bind EndianText, Mode=OneWay}"
                    Visibility="{x:Bind Layout.EndianVisibility, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="{x:Bind Layout.EndColumn, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas"
                    Text="{x:Bind EndText, Mode=OneWay}"
                    Visibility="{x:Bind Layout.EndVisibility, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="{x:Bind Layout.ColorColumn, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Text="{x:Bind ColorText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Layout.ColorVisibility, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Padding="8,6,8,0"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Name="ApplyButton"
                x:Uid="Tpl_ApplyButton"
                AutomationProperties.AutomationId="Tpl_Apply"
                Click="Apply_Click">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button
                x:Name="RerunButton"
                x:Uid="Tpl_RerunButton"
                AutomationProperties.AutomationId="Tpl_Rerun"
                Click="Rerun_Click">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Name="StopButton"
                x:Uid="Tpl_StopButton"
                AutomationProperties.AutomationId="Tpl_Stop"
                Click="Stop_Click"
                Visibility="{x:Bind Vm.IsEvaluating, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE71A;" />
            </Button>
            <Button
                x:Name="ExportButton"
                x:Uid="Tpl_ExportButton"
                AutomationProperties.AutomationId="Tpl_Export"
                Click="Export_Click">
                <FontIcon FontSize="14" Glyph="&#xEDE1;" />
            </Button>
            <Button
                x:Name="ColumnsButton"
                x:Uid="Tpl_ColumnsButton"
                AutomationProperties.AutomationId="Tpl_Columns">
                <FontIcon FontSize="14" Glyph="&#xE8A9;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="ColumnsMenu" Opening="ColumnsMenu_Opening" />
                </Button.Flyout>
            </Button>
            <ToggleButton
                x:Name="FollowToggle"
                x:Uid="Tpl_FollowToggle"
                AutomationProperties.AutomationId="Tpl_FollowCursor"
                IsChecked="{x:Bind Vm.FollowCursor, Mode=TwoWay}">
                <FontIcon FontSize="14" Glyph="&#xE7C9;" />
            </ToggleButton>
        </StackPanel>
        <Grid
            Grid.Row="1"
            Padding="8,0"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FilterBox"
                x:Uid="Tpl_FilterBox"
                AutomationProperties.AutomationId="Tpl_Filter"
                KeyDown="FilterBox_KeyDown"
                TextChanged="FilterBox_TextChanged" />
            <Button
                x:Name="SearchAllButton"
                x:Uid="Tpl_SearchAllButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="Tpl_SearchAll"
                Click="SearchAll_Click" />
        </Grid>
        <Grid
            x:Name="HeaderRow"
            Grid.Row="2"
            Padding="20,0,8,0"
            AutomationProperties.AccessibilityView="Raw"
            ColumnSpacing="6" />
        <local:TemplateTreeListView
            x:Name="Tree"
            x:Uid="Tpl_Tree"
            Grid.Row="3"
            AutomationProperties.AutomationId="Tpl_Tree"
            DoubleTapped="Tree_DoubleTapped"
            IsItemClickEnabled="False"
            ItemTemplate="{StaticResource RowTemplate}"
            KeyDown="Tree_KeyDown"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Auto"
            SelectionChanged="Tree_SelectionChanged"
            SelectionMode="Extended" />
        <Grid
            Grid.Row="4"
            Padding="8,0,8,6"
            ColumnSpacing="8"
            RowSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="PathBox"
                x:Uid="Tpl_PathBox"
                AutomationProperties.AutomationId="Tpl_Path"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                KeyDown="PathBox_KeyDown"
                Text="{x:Bind Vm.PathText, Mode=OneWay}" />
            <HyperlinkButton
                x:Name="CountsButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="Tpl_Counts"
                Click="Counts_Click"
                Content="{x:Bind Vm.CountsText, Mode=OneWay}" />
            <TextBlock
                x:Name="StatusLine"
                Grid.Row="1"
                AutomationProperties.AutomationId="Tpl_Status"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind Vm.StatusText, Mode=OneWay}" />
            <TextBlock
                x:Name="MessageLine"
                Grid.Row="1"
                Grid.Column="1"
                AutomationProperties.AutomationId="Tpl_Message"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</UserControl>
