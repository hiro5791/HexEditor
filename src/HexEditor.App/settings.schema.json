{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HexEditor settings.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "a11y.announce.verbosity": {
      "description": "Screen reader detail",
      "type": "string",
      "enum": [
        "full",
        "brief",
        "offsetOnly",
        "none"
      ],
      "default": "full"
    },
    "analysis.classify.compressedEntropy": {
      "description": "Classification: compressed entropy",
      "type": "number",
      "minimum": 0,
      "maximum": 8,
      "default": 7.2
    },
    "analysis.classify.constantShare": {
      "description": "Classification: constant threshold",
      "type": "number",
      "minimum": 0.5,
      "maximum": 1,
      "default": 0.99
    },
    "analysis.classify.encryptedEntropy": {
      "description": "Classification: encrypted entropy",
      "type": "number",
      "minimum": 0,
      "maximum": 8,
      "default": 7.9
    },
    "analysis.classify.pValueHigh": {
      "description": "Classification: highest p-value",
      "type": "number",
      "minimum": 0.5,
      "maximum": 1,
      "default": 0.99
    },
    "analysis.classify.pValueLow": {
      "description": "Classification: lowest p-value",
      "type": "number",
      "minimum": 0,
      "maximum": 0.5,
      "default": 0.01
    },
    "analysis.classify.textShare": {
      "description": "Classification: text threshold",
      "type": "number",
      "minimum": 0.5,
      "maximum": 1,
      "default": 0.95
    },
    "analysis.fileType.autoDetect": {
      "description": "Detect the file type when opening",
      "type": "boolean",
      "default": true
    },
    "annotations.column": {
      "description": "Show the annotation column",
      "type": "boolean",
      "default": false
    },
    "annotations.hidden": {
      "description": "Hidden annotation sources",
      "type": "string",
      "default": ""
    },
    "annotations.style.analysis": {
      "description": "Annotation style: Analysis results",
      "type": "string",
      "enum": [
        "background",
        "border",
        "underline"
      ],
      "default": "border"
    },
    "annotations.style.bookmark": {
      "description": "Annotation style: Bookmarks",
      "type": "string",
      "enum": [
        "background",
        "border",
        "underline"
      ],
      "default": "background"
    },
    "annotations.style.script": {
      "description": "Annotation style: Scripts and plugins",
      "type": "string",
      "enum": [
        "background",
        "border",
        "underline"
      ],
      "default": "border"
    },
    "annotations.style.searchResults": {
      "description": "Annotation style: Find all results",
      "type": "string",
      "enum": [
        "background",
        "border",
        "underline"
      ],
      "default": "border"
    },
    "annotations.style.template": {
      "description": "Annotation style: Structure templates",
      "type": "string",
      "enum": [
        "background",
        "border",
        "underline"
      ],
      "default": "background"
    },
    "annotations.style.yara": {
      "description": "Annotation style: YARA matches",
      "type": "string",
      "enum": [
        "background",
        "border",
        "underline"
      ],
      "default": "border"
    },
    "bookmarks.defaultColor": {
      "description": "Default bookmark color",
      "type": "string",
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "default": "1"
    },
    "bookmarks.richToolTip": {
      "description": "Show bookmark descriptions in tooltips",
      "type": "boolean",
      "default": true
    },
    "clipboard.compatFormats": {
      "description": "Copy in formats other hex editors read",
      "type": "boolean",
      "default": true
    },
    "clipboard.hex.bytesPerLine": {
      "description": "Bytes per line in copied hex",
      "type": "integer",
      "minimum": 0,
      "maximum": 1024,
      "default": 0
    },
    "clipboard.hex.separator": {
      "description": "Separator in copied hex",
      "type": "string",
      "default": " "
    },
    "clipboard.hex.upperCase": {
      "description": "Uppercase in copied hex",
      "type": "boolean",
      "default": true
    },
    "clipboard.history.count": {
      "description": "Clipboard history items",
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 20
    },
    "clipboard.maxSizeMiB": {
      "description": "Maximum clipboard size (MiB)",
      "type": "integer",
      "minimum": 1,
      "maximum": 2048,
      "default": 64
    },
    "clipboard.user.persist": {
      "description": "Keep user clipboards after exit",
      "type": "boolean",
      "default": false
    },
    "coloring.highContrastColors": {
      "description": "Use coloring rule colors in high contrast",
      "type": "boolean",
      "default": false
    },
    "coloring.rules": {
      "description": "Coloring rules for all documents",
      "type": "string",
      "default": ""
    },
    "devices.helperIdleMinutes": {
      "description": "Close the administrator helper after (minutes)",
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 10
    },
    "devices.helperTimeoutSeconds": {
      "description": "Administrator helper request time limit (seconds)",
      "type": "integer",
      "minimum": 5,
      "maximum": 300,
      "default": 30
    },
    "diagnostics.hexView.overlay": {
      "description": "Show rendering diagnostics in the Hex view",
      "type": "boolean",
      "default": false
    },
    "diagnostics.writeMiniDump": {
      "description": "Save a memory dump on crash",
      "type": "boolean",
      "default": false
    },
    "diskImage.suggest": {
      "description": "Suggest opening disk images as disk images",
      "type": "boolean",
      "default": true
    },
    "edit.backspaceInOverwrite": {
      "description": "Backspace in overwrite mode",
      "type": "string",
      "enum": [
        "moveCursor",
        "zeroAndMove"
      ],
      "default": "moveCursor"
    },
    "edit.caseConversion": {
      "description": "Case conversion method",
      "type": "string",
      "enum": [
        "ascii",
        "encoding"
      ],
      "default": "ascii"
    },
    "edit.defaultInputMode": {
      "description": "Input mode for newly opened files",
      "type": "string",
      "enum": [
        "overwrite",
        "insert"
      ],
      "default": "overwrite"
    },
    "edit.deleteKeepsLengthInOverwrite": {
      "description": "Delete keeps the length in overwrite mode",
      "type": "boolean",
      "default": false
    },
    "edit.multiSelection.maxElements": {
      "description": "Maximum ranges in a multi-selection",
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000000,
      "default": 1000000
    },
    "edit.overwriteSelectionTyping": {
      "description": "Typing over a selection in overwrite mode",
      "type": "string",
      "enum": [
        "overwriteFromStart",
        "zeroFirst"
      ],
      "default": "overwriteFromStart"
    },
    "edit.paste.detectWithoutConfirmation": {
      "description": "Paste detected formats without asking",
      "type": "boolean",
      "default": false
    },
    "edit.paste.selectPasted": {
      "description": "Select the pasted data",
      "type": "boolean",
      "default": true
    },
    "edit.pasteOverwrite.fitSelection": {
      "description": "Fit overwrite paste to the selection",
      "type": "boolean",
      "default": false
    },
    "edit.pasteSpecial.preferLast": {
      "description": "Prefer the last paste format",
      "type": "boolean",
      "default": true
    },
    "edit.rectangle.maxRows": {
      "description": "Maximum rows for rectangle edits that change the length",
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000,
      "default": 1000000
    },
    "edit.selectionDragDrop": {
      "description": "Drag and drop the selection",
      "type": "boolean",
      "default": true
    },
    "edit.selectionShift.amount": {
      "description": "Amount for \u0022Shift selection forward / back\u0022",
      "type": "string",
      "enum": [
        "selectionLength",
        "lastAmount"
      ],
      "default": "selectionLength"
    },
    "edit.text.enterKey": {
      "description": "Enter in the text column",
      "type": "string",
      "enum": [
        "none",
        "crlf",
        "lf",
        "cr"
      ],
      "default": "none"
    },
    "edit.undo.clearOnSave": {
      "description": "Clear the undo history when saving",
      "type": "boolean",
      "default": false
    },
    "edit.undo.coalesceSeconds": {
      "description": "Group typing for undo (seconds)",
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 2
    },
    "files.autoReloadUnmodified": {
      "description": "Reload unmodified files automatically",
      "type": "boolean",
      "default": true
    },
    "formats.gapFill": {
      "description": "Fill value for gaps in Intel HEX and S-record files",
      "type": "string",
      "default": "FF"
    },
    "hash.algorithms": {
      "description": "Hash algorithms",
      "type": "string",
      "default": ""
    },
    "hash.autoRecompute": {
      "description": "Recalculate hashes automatically",
      "type": "boolean",
      "default": true
    },
    "hash.customCrc": {
      "description": "Custom CRCs",
      "type": "string",
      "default": ""
    },
    "hash.sets": {
      "description": "Hash algorithm sets",
      "type": "string",
      "default": ""
    },
    "i18n.showStringKeys": {
      "description": "Show resource keys in tooltips",
      "type": "boolean",
      "default": false
    },
    "inspector.dateFormat": {
      "description": "Inspector: date format",
      "type": "string",
      "enum": [
        "regional",
        "iso"
      ],
      "default": "regional"
    },
    "inspector.digitGrouping": {
      "description": "Inspector: digit grouping",
      "type": "boolean",
      "default": true
    },
    "inspector.floatFormat": {
      "description": "Inspector: floating-point format",
      "type": "string",
      "enum": [
        "shortest",
        "exponent",
        "hex"
      ],
      "default": "shortest"
    },
    "inspector.highlightTarget": {
      "description": "Highlight the inspector target",
      "type": "boolean",
      "default": true
    },
    "inspector.integerBase": {
      "description": "Inspector: integer base",
      "type": "string",
      "enum": [
        "decimal",
        "hex",
        "octal"
      ],
      "default": "decimal"
    },
    "inspector.rowPresets": {
      "description": "Inspector row presets",
      "type": "string",
      "default": "{}"
    },
    "inspector.rows": {
      "description": "Inspector rows",
      "type": "string",
      "default": ""
    },
    "inspector.timeZone": {
      "description": "Inspector: time zone",
      "type": "string",
      "enum": [
        "local",
        "utc"
      ],
      "default": "local"
    },
    "inspector.useCursorWithSelection": {
      "description": "Inspector: use the cursor when there is a selection",
      "type": "boolean",
      "default": false
    },
    "log.level": {
      "description": "Log level",
      "type": "string",
      "enum": [
        "info",
        "debug"
      ],
      "default": "info"
    },
    "memoryMap.refreshSeconds": {
      "description": "Memory map refresh interval (seconds)",
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 5
    },
    "network.downloads.enabled": {
      "description": "Allow downloads",
      "type": "boolean",
      "default": true
    },
    "network.offline": {
      "description": "Offline mode",
      "type": "boolean",
      "default": false
    },
    "network.translationReport.enabled": {
      "description": "Allow translation reports",
      "type": "boolean",
      "default": true
    },
    "positionManager.followCursor": {
      "description": "Position manager follows the cursor",
      "type": "boolean",
      "default": true
    },
    "process.openReadOnly": {
      "description": "Open processes read-only by default",
      "type": "boolean",
      "default": true
    },
    "recent.maxItems": {
      "description": "Number of recent files",
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 25
    },
    "recent.restorePosition": {
      "description": "Restore the last position",
      "type": "boolean",
      "default": true
    },
    "save.backup.enabled": {
      "description": "Make a backup when saving",
      "type": "boolean",
      "default": false
    },
    "save.backup.folder": {
      "description": "Backup folder",
      "type": "string",
      "default": ""
    },
    "save.backup.generations": {
      "description": "Backups to keep",
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 1
    },
    "save.backup.location": {
      "description": "Backup location",
      "type": "string",
      "enum": [
        "sameFolder",
        "folder"
      ],
      "default": "sameFolder"
    },
    "save.recoveryIntervalMinutes": {
      "description": "Recovery data interval (minutes)",
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 1
    },
    "save.shiftInPlace": {
      "description": "Save in place even when the length changes",
      "type": "boolean",
      "default": false
    },
    "search.chunkSize": {
      "description": "Search chunk size (KiB)",
      "type": "integer",
      "minimum": 256,
      "maximum": 65536,
      "default": 4096
    },
    "search.findAll.limit": {
      "description": "Find all: result limit",
      "type": "integer",
      "minimum": 1000,
      "maximum": 100000000,
      "default": 1000000
    },
    "search.highlightMatches": {
      "description": "Highlight matches",
      "type": "boolean",
      "default": true
    },
    "search.history.doNotSave": {
      "description": "Do not save search history",
      "type": "boolean",
      "default": false
    },
    "search.history.limit": {
      "description": "Search history size",
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 50
    },
    "search.maxMatchLength": {
      "description": "Maximum match length",
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576,
      "default": 4096
    },
    "search.mismatch.minRepeat": {
      "description": "Repetitions that end a non-matching range",
      "type": "integer",
      "minimum": 1,
      "maximum": 65536,
      "default": 16
    },
    "search.multiFile.parallelism": {
      "description": "Files searched at the same time",
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 4
    },
    "search.readErrors": {
      "description": "When data can\u0027t be read while searching",
      "type": "string",
      "enum": [
        "ask",
        "skip",
        "abort"
      ],
      "default": "ask"
    },
    "search.regex.timeLimit": {
      "description": "Regular expression time limit (seconds)",
      "type": "number",
      "minimum": 0.1,
      "maximum": 60,
      "default": 2
    },
    "search.results.f3Repeats": {
      "description": "F3 searches again",
      "type": "boolean",
      "default": false
    },
    "search.results.newTab": {
      "description": "Show each Find all in a new tab",
      "type": "boolean",
      "default": false
    },
    "search.results.preview": {
      "description": "Preview results with Up and Down",
      "type": "boolean",
      "default": true
    },
    "session.restoreOnStartup": {
      "description": "On startup",
      "type": "string",
      "enum": [
        "always",
        "ask",
        "never"
      ],
      "default": "always"
    },
    "shell.commandLine.enabled": {
      "description": "Make available from the command line",
      "type": "boolean",
      "default": true
    },
    "shell.jumpList.enabled": {
      "description": "Show the jump list",
      "type": "boolean",
      "default": true
    },
    "shell.openWith.extensions": {
      "description": "\u0022Open with\u0022 extensions",
      "type": "string",
      "default": ""
    },
    "statistics.autoRecompute": {
      "description": "Recalculate statistics automatically",
      "type": "boolean",
      "default": true
    },
    "storage.tempDirectory": {
      "description": "Folder for temporary data",
      "type": "string",
      "default": ""
    },
    "ui.backdrop": {
      "description": "Window background",
      "type": "string",
      "enum": [
        "mica",
        "micaAlt",
        "none"
      ],
      "default": "mica"
    },
    "ui.fullScreen.showStatusBar": {
      "description": "Show the status bar in full screen",
      "type": "boolean",
      "default": true
    },
    "ui.language": {
      "description": "Display language",
      "type": "string",
      "enum": [
        "system",
        "en",
        "zh-Hans",
        "zh-Hant",
        "ja",
        "ko",
        "id",
        "vi",
        "th",
        "de",
        "fr",
        "es",
        "pt",
        "it",
        "ru",
        "uk",
        "pl",
        "cs",
        "hu",
        "ro",
        "el",
        "ar",
        "tr",
        "fa"
      ],
      "default": "system"
    },
    "ui.statusBar.items": {
      "description": "Status bar items",
      "type": "string",
      "default": ""
    },
    "ui.statusBar.visible": {
      "description": "Show status bar",
      "type": "boolean",
      "default": true
    },
    "ui.theme": {
      "description": "Theme",
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ],
      "default": "system"
    },
    "ui.toolbar.items": {
      "description": "Toolbar buttons",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "file.new",
        "file.open",
        "file.save",
        "edit.undo",
        "edit.redo",
        "edit.cut",
        "edit.copy",
        "edit.paste",
        "search.find",
        "go.goTo",
        "edit.toggleInsert",
        "view.panel.inspector"
      ]
    },
    "ui.toolbar.visible": {
      "description": "Show toolbar",
      "type": "boolean",
      "default": false
    },
    "uninstall.removeUserData": {
      "description": "Delete my data when uninstalling",
      "type": "boolean",
      "default": false
    },
    "update.channel": {
      "description": "Update channel",
      "type": "string",
      "enum": [
        "stable",
        "preview"
      ],
      "default": "stable"
    },
    "update.checkAutomatically": {
      "description": "Check for updates automatically",
      "type": "boolean",
      "default": true
    },
    "update.downloadAutomatically": {
      "description": "Download updates automatically",
      "type": "boolean",
      "default": true
    },
    "update.skippedVersion": {
      "description": "Skipped version",
      "type": "string",
      "default": ""
    },
    "view.byteTheme": {
      "description": "Byte theme",
      "type": "string",
      "default": "none"
    },
    "view.colorScheme": {
      "description": "Color scheme",
      "type": "string",
      "default": "default"
    },
    "view.cursor.nibbleArrowKeys": {
      "description": "Move by nibble with arrow keys",
      "type": "boolean",
      "default": false
    },
    "view.font.fallback": {
      "description": "Fallback font for the text column",
      "type": "string",
      "default": ""
    },
    "view.font.family": {
      "description": "Font",
      "type": "string",
      "default": ""
    },
    "view.font.followTextScaling": {
      "description": "Follow the Windows text size",
      "type": "boolean",
      "default": true
    },
    "view.font.lineHeight": {
      "description": "Line height",
      "type": "number",
      "minimum": 1,
      "maximum": 2,
      "default": 1.2
    },
    "view.font.size": {
      "description": "Font size (pt)",
      "type": "number",
      "minimum": 6,
      "maximum": 72,
      "default": 10
    },
    "view.jump.position": {
      "description": "Position after a jump",
      "type": "string",
      "enum": [
        "top",
        "third",
        "center"
      ],
      "default": "third"
    },
    "view.minimap.content": {
      "description": "Minimap content",
      "type": "string",
      "enum": [
        "entropy",
        "byteKinds",
        "byteValue",
        "zero",
        "byteTheme"
      ],
      "default": "entropy"
    },
    "view.minimap.exact": {
      "description": "Calculate the minimap exactly",
      "type": "boolean",
      "default": false
    },
    "view.minimap.hiddenMarks": {
      "description": "Hidden minimap marks",
      "type": "string",
      "default": ""
    },
    "view.minimap.range": {
      "description": "Minimap range",
      "type": "string",
      "enum": [
        "whole",
        "around"
      ],
      "default": "whole"
    },
    "view.minimap.visible": {
      "description": "Show minimap",
      "type": "boolean",
      "default": false
    },
    "view.minimap.width": {
      "description": "Minimap width",
      "type": "integer",
      "minimum": 40,
      "maximum": 200,
      "default": 80
    },
    "view.modified.keepAfterSave": {
      "description": "Keep change marks after saving",
      "type": "boolean",
      "default": false
    },
    "view.modified.showDeletions": {
      "description": "Show deleted positions",
      "type": "boolean",
      "default": false
    },
    "view.scroll.cursorMargin": {
      "description": "Rows kept above and below the cursor",
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 0
    },
    "view.scroll.fixedOffsetColumn": {
      "description": "Keep the offset column fixed",
      "type": "boolean",
      "default": true
    },
    "view.scrollBar.bookmarkMarks": {
      "description": "Show bookmarks on the scroll bar",
      "type": "boolean",
      "default": false
    },
    "view.scrollBar.cursorMark": {
      "description": "Show the cursor position on the scroll bar",
      "type": "boolean",
      "default": true
    },
    "view.scrollBar.diffMarks": {
      "description": "Show differences on the scroll bar",
      "type": "boolean",
      "default": false
    },
    "view.scrollBar.searchMarks": {
      "description": "Show search results on the scroll bar",
      "type": "boolean",
      "default": true
    },
    "view.scrollBar.selectionMark": {
      "description": "Show the selection on the scroll bar",
      "type": "boolean",
      "default": false
    },
    "view.split.syncSettings": {
      "description": "Keep split pane display settings the same",
      "type": "boolean",
      "default": false
    },
    "view.statusBar.showNibble": {
      "description": "Show nibble position",
      "type": "boolean",
      "default": false
    },
    "view.sync.selection": {
      "description": "Synchronize selection too",
      "type": "boolean",
      "default": false
    },
    "view.text.invalidSymbol": {
      "description": "Symbol for invalid bytes",
      "type": "string",
      "enum": [
        "dot",
        "replacement"
      ],
      "default": "dot"
    },
    "view.text.nonPrintable": {
      "description": "Symbol for non-printable characters",
      "type": "string",
      "enum": [
        "dot",
        "space",
        "controlPictures"
      ],
