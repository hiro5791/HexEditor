// HexEditor 標準テンプレート (TPL-34): PDF (ヘッダ、xref 表、トレーラ、オブジェクトの位置)
// ライセンス: MIT。
// 先頭のヘッダ行と、末尾の startxref から xref 表 (従来の形式) とトレーラを読む。xref の項目はオブジェクトの位置を示す。
// 各オブジェクトの中身とストリームは解釈しない。ファイル全体は走査せず、末尾の 2 KiB だけを探す。
// xref ストリーム (PDF 1.5 以降の圧縮された形式) は xref 表として展開せず、startxref の位置だけを示す。
#pragma name "PDF document"
#pragma name.ja "PDF 文書"
#pragma description "PDF document: header, startxref, cross-reference table entries (object offsets, generations, in-use flags) and the trailer dictionary."
#pragma description.ja "PDF 文書: ヘッダ、startxref、相互参照表 (xref) の項目 (オブジェクトの位置・世代・使用中かどうか)、トレーラ辞書。"
#pragma author "HexEditor"
#pragma version "1.0.0"
#pragma license "MIT"
#pragma magic 0 "25 50 44 46 2D"
#pragma mime "application/pdf"
#pragma extensions "pdf"
#pragma endian little

/// 空白文字 (スペース、改行、復帰、タブ、NUL、フォームフィード) を飛ばした位置
fn skip_space(u64 at) -> u64 {
    local u64 p = at;
    local u64 size = std::core::size();
    while (p < size) {
        local u8 c = std::mem::read_u8(p, little);
        if (c != 0x20 && c != 0x0A && c != 0x0D && c != 0x09 && c != 0x00 && c != 0x0C) {
            break;
        }
        p += 1;
    }
    return p;
}

/// 10 進数の桁が続く長さ
fn digits(u64 at) -> u64 {
    local u64 p = at;
    local u64 size = std::core::size();
    while (p < size && std::mem::read_u8(p, little) >= 0x30 && std::mem::read_u8(p, little) <= 0x39 && p - at < 20) {
        p += 1;
    }
    return p - at;
}

fn number_at(u64 at) -> u64 {
    local u64 n = digits(at);
    if (n == 0) {
        return 0;
    }
    return std::string::parse_int(std::mem::read_string(at, n, "latin1"), 10);
}

/// 末尾の startxref の位置 (最後の 2 KiB の中の最後の出現。なければ -1)
fn find_startxref() -> s64 {
    local u64 size = std::core::size();
    local u64 from = size > 2048 ? size - 2048 : 0;
    local s64 found = -1;
    local u64 at = from;
    for (local u32 n = 0; n < 8; n += 1) {
        local s64 hit = std::mem::find(x"73 74 61 72 74 78 72 65 66", at, size);
        if (hit < 0) {
            break;
        }
        found = hit;
        at = hit + 1;
    }
    return found;
}

struct Header {
    char magic[5] [[expect(magic == "%PDF-", "PDF のヘッダではありません")]];
    char version[3] [[comment("例: 1.7")]];
};

/// xref 表の 1 項目 (20 バイト)。type は n (使用中) か f (空き)。
struct XrefEntry {
    char offset[10];
    char sp1[1];
    char generation[5];
    char sp2[1];
    char type[1];
    char eol[2];
    local u64 object_offset = std::string::parse_int(offset, 10) [[show, format("hex")]];
    local u64 generation_number = std::string::parse_int(generation, 10) [[show]];
};

struct StartXref {
    char keyword[9] [[expect(keyword == "startxref", "startxref ではありません")]];
    local u64 value_at = skip_space(addressof(keyword) + 9);
    local u64 xref_offset = number_at(value_at) [[show, format("hex")]];
};

local s64 startxref_position = find_startxref();
Header header @ 0;

if (startxref_position >= 0) {
    StartXref startxref @ startxref_position;
    local u64 xref_at = startxref.xref_offset;
    if (xref_at + 4 <= std::core::size() && std::mem::compare(xref_at, x"78 72 65 66")) {
        // 従来の xref 表: "xref" の後に「先頭の番号 個数」の行と、20 バイトの項目が続く
        char xref_keyword[4] @ xref_at;
        local u64 first_number_at = skip_space(xref_at + 4);
        local u64 first_digits = digits(first_number_at);
        local u64 count_at = skip_space(first_number_at + first_digits);
        local u64 count = number_at(count_at);
        local u64 entries_at = skip_space(count_at + digits(count_at));
        XrefEntry xref_entries[std::math::min(count, 100000000)] @ entries_at;
        // トレーラ辞書 (xref の項目の後の "trailer" から startxref の前まで)
        local u64 trailer_at = entries_at + count * 20;
        if (trailer_at + 7 <= startxref_position && std::mem::compare(trailer_at, x"74 72 61 69 6C 65 72")) {
            char trailer[startxref_position - trailer_at] @ trailer_at [[encoding("latin1")]];
        }
    }
}
