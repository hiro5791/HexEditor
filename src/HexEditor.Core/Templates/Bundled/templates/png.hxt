// HexEditor 標準テンプレート (TPL-34): PNG 画像
// ライセンス: MIT。
#pragma name "PNG image"
#pragma name.ja "PNG 画像"
#pragma description "PNG image: signature and chunks (IHDR, tEXt, others as raw data) with CRC check."
#pragma description.ja "PNG 画像: シグネチャとチャンク (IHDR、tEXt、その他は生のデータ)。CRC を確かめる。"
#pragma author "HexEditor"
#pragma version "1.0.0"
#pragma license "MIT"
#pragma magic 0 "89 50 4E 47 0D 0A 1A 0A"
#pragma mime "image/png"
#pragma extensions "png;apng"
#pragma endian big

import std.core;
import std.hash;

enum ColorType : u8 {
    Grayscale      = 0,
    Truecolor      = 2,
    Indexed        = 3,
    GrayscaleAlpha = 4,
    TruecolorAlpha = 6,
};

struct IHDR {
    u32       width;
    u32       height;
    u8        bit_depth;
    ColorType color_type;
    u8        compression;
    u8        filter;
    u8        interlace;
};

struct Chunk {
    u32     length;
    char    type[4]                 [[color("accent1")]];
    switch (type) {
        case "IHDR": IHDR header;
        case "tEXt": char text[length] [[encoding("latin1")]];
        default:     u8 data[length] [[lazy]];
    }
    u32     crc                     [[format("hex"),
                                      expect(crc == std::hash::crc32(addressof(type), length + 4),
                                             "CRC does not match")]];
};

u8    signature[8];
Chunk chunks[until(last.type == "IEND" || std::eof())];
