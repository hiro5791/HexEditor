// HexEditor 標準テンプレート (TPL-34): exFAT のブートセクタ
// ライセンス: MIT。
// ボリューム先頭のメイン ブートセクタ (VBR) だけを読む。100 GiB 以上のディスクイメージでも使える。
#pragma name "exFAT boot sector"
#pragma name.ja "exFAT ブートセクタ"
#pragma description "exFAT volume: main boot sector with file system name, partition and volume geometry, FAT and cluster heap offsets, and the boot signature."
#pragma description.ja "exFAT のボリューム: ファイルシステム名、パーティションとボリュームの配置、FAT とクラスタヒープの位置、ブートシグネチャを持つメインブートセクタ。"
#pragma author "HexEditor"
#pragma version "1.0.0"
#pragma license "MIT"
#pragma magic 3 "45 58 46 41 54 20 20 20"
#pragma mime "application/x-exfat"
#pragma extensions "img;exfat"
#pragma priority 10
#pragma endian little

flags VolumeFlags : u16 { ActiveFat = 0x1, VolumeDirty = 0x2, MediaFailure = 0x4, ClearToZero = 0x8 };

struct BootSector {
    u8          jump[3];
    char        file_system_name[8] [[expect(file_system_name == "EXFAT   ", "EXFAT ではありません")]];
    u8          must_be_zero[53] [[lazy]];
    u64         partition_offset [[comment("セクタ数")]];
    u64         volume_length [[comment("セクタ数")]];
    u32         fat_offset [[comment("セクタ数")]];
    u32         fat_length [[comment("セクタ数")]];
    u32         cluster_heap_offset [[comment("セクタ数")]];
    u32         cluster_count;
    u32         first_cluster_of_root_directory;
    u32         volume_serial_number [[format("hex")]];
    u8          file_system_revision_minor;
    u8          file_system_revision_major;
    VolumeFlags volume_flags;
    u8          bytes_per_sector_shift;
    u8          sectors_per_cluster_shift;
    u8          number_of_fats;
    u8          drive_select [[format("hex")]];
    u8          percent_in_use;
    u8          reserved[7];
    u8          boot_code[390] [[lazy]];
    u8          boot_signature[2] [[expect(boot_signature == x"55 AA", "ブートシグネチャ 55 AA がありません")]];
    local u64 bytes_per_sector = 1 << bytes_per_sector_shift [[show]];
    local u64 bytes_per_cluster = 1 << (bytes_per_sector_shift + sectors_per_cluster_shift) [[show]];
};

BootSector boot_sector;
