// HexEditor 標準ライブラリ (TPL-18): std.type
// よく使う型。guid、ipv4、filetime などの組み込み型は std::type::guid の名前でも使える。
// std::type::magic<"…"> (指定のバイト列であることを確認する型)、std::type::Size<T> (バイト数として表示する整数)、
// std::type::Bitmask<T> (2 進で表示する整数) は組み込みの型。

namespace std::type {
    using Offset32 = u32 [[format("hex")]];
    using Offset64 = u64 [[format("hex")]];
};
