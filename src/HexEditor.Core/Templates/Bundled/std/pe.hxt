// HexEditor 標準ライブラリ (TPL-18): std.pe
// Windows の実行形式 (PE/COFF) の型と補助関数。標準テンプレート (TPL-34) で使う。

namespace std::pe {

    enum Machine : u16 {
        Unknown = 0x0000,
        I386    = 0x014C,
        R4000   = 0x0166,
        ARM     = 0x01C0,
        ARMNT   = 0x01C4,
        IA64    = 0x0200,
        EBC     = 0x0EBC,
        AMD64   = 0x8664,
        ARM64   = 0xAA64,
        RISCV64 = 0x5064,
    };

    flags Characteristics : u16 {
        RelocsStripped       = 0x0001,
        Executable           = 0x0002,
        LineNumsStripped     = 0x0004,
        LocalSymsStripped    = 0x0008,
        AggressiveWsTrim     = 0x0010,
        LargeAddressAware    = 0x0020,
        BytesReversedLo      = 0x0080,
        Machine32Bit         = 0x0100,
        DebugStripped        = 0x0200,
        RemovableRunFromSwap = 0x0400,
        NetRunFromSwap       = 0x0800,
        System               = 0x1000,
        Dll                  = 0x2000,
        UpSystemOnly         = 0x4000,
        BytesReversedHi      = 0x8000,
    };

    enum Subsystem : u16 {
        Unknown = 0, Native = 1, WindowsGui = 2, WindowsCui = 3, Os2Cui = 5, PosixCui = 7, WindowsCeGui = 9,
        EfiApplication = 10, EfiBootServiceDriver = 11, EfiRuntimeDriver = 12, EfiRom = 13, Xbox = 14, WindowsBootApplication = 16,
    };

    fn fmt_mz(ref u16 v) -> string {
        return std::format("{:c}{:c} (0x{:X})", v & 0xFF, v >> 8, v);
    }

    fn fmt_pe(ref u32 v) -> string {
        return std::format("PE\\0\\0 (0x{:08X})", v);
    }

    /// MS-DOS のヘッダ (IMAGE_DOS_HEADER)
    struct DosHeader {
        le u16 e_magic [[format(fmt_mz), expect(e_magic == 0x5A4D, "MZ ではありません")]];
        le u16 e_cblp;
        le u16 e_cp;
        le u16 e_crlc;
        le u16 e_cparhdr;
        le u16 e_minalloc;
        le u16 e_maxalloc;
        le u16 e_ss;
        le u16 e_sp;
        le u16 e_csum;
        le u16 e_ip;
        le u16 e_cs;
        le u16 e_lfarlc;
        le u16 e_ovno;
        le u16 e_res[4];
        le u16 e_oemid;
        le u16 e_oeminfo;
        le u16 e_res2[10];
        le u32 e_lfanew [[format("hex")]];
    };

    /// COFF ファイルヘッダ (IMAGE_FILE_HEADER)
    struct FileHeader {
        le Machine         Machine;
        le u16             NumberOfSections;
        le time32_t        TimeDateStamp;
        le u32             PointerToSymbolTable [[format("hex")]];
        le u32             NumberOfSymbols;
        le u16             SizeOfOptionalHeader;
        le Characteristics Characteristics;
    };

    struct DataDirectory {
        le u32 VirtualAddress [[format("hex")]];
        le u32 Size;
    };

    /// オプションヘッダ (IMAGE_OPTIONAL_HEADER32 / 64)
    struct OptionalHeader {
        le u16 Magic [[format("hex")]];
        u8     MajorLinkerVersion;
        u8     MinorLinkerVersion;
        le u32 SizeOfCode;
        le u32 SizeOfInitializedData;
        le u32 SizeOfUninitializedData;
        le u32 AddressOfEntryPoint [[format("hex")]];
        le u32 BaseOfCode [[format("hex")]];
        if (Magic == 0x10B) {
            le u32 BaseOfData [[format("hex")]];
            le u32 ImageBase [[format("hex")]];
        } else {
            le u64 ImageBase [[format("hex")]];
        }
        le u32 SectionAlignment;
        le u32 FileAlignment;
        le u16 MajorOperatingSystemVersion;
        le u16 MinorOperatingSystemVersion;
        le u16 MajorImageVersion;
        le u16 MinorImageVersion;
        le u16 MajorSubsystemVersion;
        le u16 MinorSubsystemVersion;
        le u32 Win32VersionValue;
        le u32 SizeOfImage;
        le u32 SizeOfHeaders;
        le u32 CheckSum [[format("hex")]];
        le Subsystem Subsystem;
        le u16 DllCharacteristics [[format("hex")]];
        if (Magic == 0x10B) {
            le u32 SizeOfStackReserve;
            le u32 SizeOfStackCommit;
            le u32 SizeOfHeapReserve;
            le u32 SizeOfHeapCommit;
        } else {
            le u64 SizeOfStackReserve;
            le u64 SizeOfStackCommit;
            le u64 SizeOfHeapReserve;
            le u64 SizeOfHeapCommit;
        }
        le u32 LoaderFlags;
        le u32 NumberOfRvaAndSizes;
        DataDirectory DataDirectories[std::math::min(NumberOfRvaAndSizes, 16)];
    };

    /// セクションヘッダ (IMAGE_SECTION_HEADER)
    struct SectionHeader {
        char   Name[8];
        le u32 VirtualSize;
        le u32 VirtualAddress [[format("hex")]];
        le u32 SizeOfRawData;
        le u32 PointerToRawData [[format("hex")]];
        le u32 PointerToRelocations [[format("hex")]];
        le u32 PointerToLinenumbers [[format("hex")]];
        le u16 NumberOfRelocations;
        le u16 NumberOfLinenumbers;
        le SectionFlags Characteristics;
    };

    /// NT ヘッダ (IMAGE_NT_HEADERS)
    struct NtHeaders {
        le u32         Signature [[format(fmt_pe), expect(Signature == 0x00004550, "PE シグネチャではありません")]];
        FileHeader     FileHeader;
        OptionalHeader OptionalHeader;
    };

    /// リッチヘッダの 1 項目 (値は鍵で XOR されている)
    struct RichEntry {
        le u32 comp_id [[format("hex")]];
        le u32 count;
        local u32 key = rich_key();
        local u32 product_id = ((comp_id ^ key) >> 16) & 0xFFFF [[show]];
        local u32 build_number = (comp_id ^ key) & 0xFFFF [[show]];
        local u32 use_count = count ^ key [[show]];
    };

    /// リッチヘッダ (DanS 〜 Rich + 鍵。DOS スタブと NT ヘッダの間にある)
    struct RichHeader {
        le u32 dans [[format("hex")]];
        le u32 pad[3] [[format("hex")]];
        RichEntry entries[(rich_end() - rich_start() - 16) / 8];
        char   rich[4];
        le u32 key [[format("hex")]];
    };

    flags SectionFlags : u32 {
        NoPad = 0x00000008, Code = 0x00000020, InitializedData = 0x00000040, UninitializedData = 0x00000080,
        LinkRemove = 0x00000800, LinkComdat = 0x00001000, NoDeferSpecExc = 0x00004000, Gprel = 0x00008000,
        ExtendedRelocations = 0x01000000, Discardable = 0x02000000, NotCached = 0x04000000, NotPaged = 0x08000000,
        Shared = 0x10000000, Execute = 0x20000000, Read = 0x40000000, Write = 0x80000000,
    };

    /// インポートされる関数名 (IMAGE_IMPORT_BY_NAME)
    struct ImportByName {
        le u16 Hint;
        string Name;
    };

    /// インポートの参照 (IMAGE_THUNK_DATA32 / 64)。序数でなければ名前を指す。
    struct ImportThunk(bool is64) {
        if (is64) {
            le u64 Value [[format("hex")]];
        } else {
            le u32 Value [[format("hex")]];
        }
        local bool by_ordinal = is64 ? (Value >> 63) != 0 : (Value >> 31) != 0 [[show]];
        if (Value != 0 && !by_ordinal) {
            ImportByName hint_name @ rva_to_offset(Value & 0x7FFFFFFF);
        }
    };

    /// インポート記述子 (IMAGE_IMPORT_DESCRIPTOR)
    struct ImportDescriptor(bool is64) {
        le u32 OriginalFirstThunk [[format("hex")]];
        le time32_t TimeDateStamp;
        le u32 ForwarderChain;
        le u32 Name [[format("hex")]];
        le u32 FirstThunk [[format("hex")]];
        if (Name != 0) {
            local string dll_name = std::mem::read_string(rva_to_offset(Name), 256, "latin1") [[show]];
        }
        if (OriginalFirstThunk != 0) {
            ImportThunk(is64) thunks[until(last.Value == 0)] @ rva_to_offset(OriginalFirstThunk);
        }
    };

    /// エクスポートディレクトリ (IMAGE_EXPORT_DIRECTORY)
    struct ExportDirectory {
        le u32 Characteristics;
        le time32_t TimeDateStamp;
        le u16 MajorVersion;
        le u16 MinorVersion;
        le u32 Name [[format("hex")]];
        le u32 Base;
        le u32 NumberOfFunctions;
        le u32 NumberOfNames;
        le u32 AddressOfFunctions [[format("hex")]];
        le u32 AddressOfNames [[format("hex")]];
        le u32 AddressOfNameOrdinals [[format("hex")]];
        if (Name != 0) {
            local string dll_name = std::mem::read_string(rva_to_offset(Name), 256, "latin1") [[show]];
        }
        if (AddressOfFunctions != 0) {
            le u32 Functions[NumberOfFunctions] @ rva_to_offset(AddressOfFunctions);
        }
        if (AddressOfNames != 0) {
            string *Names[NumberOfNames] : u32 @ rva_to_offset(AddressOfNames) [[pointer_map(rva_to_offset)]];
        }
        if (AddressOfNameOrdinals != 0) {
            le u16 NameOrdinals[NumberOfNames] @ rva_to_offset(AddressOfNameOrdinals);
        }
    };

    /// リソースのデータ項目 (IMAGE_RESOURCE_DATA_ENTRY)
    struct ResourceDataEntry {
        le u32 OffsetToData [[format("hex")]];
        le u32 Size;
        le u32 CodePage;
        le u32 Reserved;
    };

    /// リソースのディレクトリ項目。最上位ビットが立っていれば下の階層のディレクトリを指す。
    struct ResourceEntry(u64 base, u32 depth) {
        le u32 NameOrId [[format("hex")]];
        le u32 Offset [[format("hex")]];
        if ((Offset & 0x80000000) != 0) {
            if (depth < 3) {
                ResourceDirectory(base, depth + 1) directory @ base + (Offset & 0x7FFFFFFF);
            }
        } else {
            ResourceDataEntry data @ base + Offset;
        }
    };

    /// リソースのディレクトリ (IMAGE_RESOURCE_DIRECTORY。種類 → 名前 → 言語の 3 階層)
    struct ResourceDirectory(u64 base, u32 depth) {
        le u32 Characteristics;
        le time32_t TimeDateStamp;
        le u16 MajorVersion;
        le u16 MinorVersion;
        le u16 NumberOfNamedEntries;
        le u16 NumberOfIdEntries;
        ResourceEntry(base, depth) entries[NumberOfNamedEntries + NumberOfIdEntries];
    };

    bitfield RelocationEntry : u16 {
        offset : 12;
        type   : 4;
    };

    /// 再配置ブロック (IMAGE_BASE_RELOCATION)
    struct BaseRelocationBlock {
        le u32 PageRva [[format("hex")]];
        le u32 BlockSize;
        le RelocationEntry Entries[(std::math::max(BlockSize, 8) - 8) / 2];
    };

    enum DebugType : u32 {
        Unknown = 0, Coff = 1, CodeView = 2, Fpo = 3, Misc = 4, Exception = 5, Fixup = 6, OmapToSrc = 7, OmapFromSrc = 8,
        Borland = 9, Reserved10 = 10, Clsid = 11, VcFeature = 12, Pogo = 13, Iltcg = 14, Mpx = 15, Repro = 16,
        ExDllCharacteristics = 20,
    };

    /// CodeView の PDB 7.0 情報 (RSDS)
    struct CodeViewPdb70 {
        char   Signature[4];
        guid   Guid;
        le u32 Age;
        string PdbFileName;
    };

    /// デバッグディレクトリの項目 (IMAGE_DEBUG_DIRECTORY)
    struct DebugDirectory {
        le u32 Characteristics;
        le time32_t TimeDateStamp;
        le u16 MajorVersion;
        le u16 MinorVersion;
        le DebugType Type;
        le u32 SizeOfData;
        le u32 AddressOfRawData [[format("hex")]];
        le u32 PointerToRawData [[format("hex")]];
        if (Type == DebugType::CodeView && PointerToRawData != 0 && SizeOfData >= 24) {
            CodeViewPdb70 codeview @ PointerToRawData;
        }
    };

    flags ComImageFlags : u32 {
        ILOnly = 0x1, Required32Bit = 0x2, ILLibrary = 0x4, StrongNameSigned = 0x8, NativeEntryPoint = 0x10, TrackDebugData = 0x10000,
        Prefers32Bit = 0x20000,
    };

    /// .NET の CLI ヘッダ (IMAGE_COR20_HEADER)
    struct Cor20Header {
        le u32 cb;
        le u16 MajorRuntimeVersion;
        le u16 MinorRuntimeVersion;
        DataDirectory MetaData;
        le ComImageFlags Flags;
        le u32 EntryPointToken [[format("hex")]];
        DataDirectory Resources;
        DataDirectory StrongNameSignature;
        DataDirectory CodeManagerTable;
        DataDirectory VTableFixups;
        DataDirectory ExportAddressTableJumps;
        DataDirectory ManagedNativeHeader;
    };

    /// メタデータのストリームのヘッダ (名前は 4 バイト境界まで 0 で埋める)
    struct MetadataStreamHeader(u64 root) {
        le u32 Offset [[format("hex")]];
        le u32 Size;
        string Name;
        padding[(4 - (sizeof(Name) % 4)) % 4];
        u8 Data[Size] @ root + Offset [[lazy]];
    };

    /// .NET のメタデータのルート (ECMA-335 の II.24.2.1)
    struct MetadataRoot {
        le u32 Signature [[format("hex"), expect(Signature == 0x424A5342, "BSJB ではありません")]];
        le u16 MajorVersion;
        le u16 MinorVersion;
        le u32 Reserved;
        le u32 Length;
        char   Version[Length];
        le u16 Flags;
        le u16 Streams;
        MetadataStreamHeader(addressof(this)) StreamHeaders[Streams];
    };

    /// データディレクトリの RVA (番号が範囲外なら 0)
    fn dir_rva(u64 index) -> u64 {
        local u64 nt = nt_offset();
        local u64 dirs = nt + 24 + (std::mem::read_u16(nt + 24, little) == 0x10B ? 96 : 112);
        if (index >= std::mem::read_u32(dirs - 4, little)) {
            return 0;
        }
        return std::mem::read_u32(dirs + index * 8, little);
    }

    /// データディレクトリの大きさ (番号が範囲外なら 0)
    fn dir_size(u64 index) -> u64 {
        local u64 nt = nt_offset();
        local u64 dirs = nt + 24 + (std::mem::read_u16(nt + 24, little) == 0x10B ? 96 : 112);
        if (index >= std::mem::read_u32(dirs - 4, little)) {
            return 0;
        }
        return std::mem::read_u32(dirs + index * 8 + 4, little);
    }

    /// データディレクトリの位置 (ファイル内)
    fn dir_offset(u64 index) -> u64 {
        return rva_to_offset(dir_rva(index));
    }

    /// PE32+ なら true
    fn is_pe32_plus() -> bool {
        return std::mem::read_u16(nt_offset() + 24, little) == 0x20B;
    }

    /// リッチヘッダの終わりの印 "Rich" の位置 (なければ -1。DOS ヘッダと NT ヘッダの間だけを探す)
    fn rich_end() -> s64 {
        local u64 lfanew = nt_offset();
        if (lfanew <= 0x48 || lfanew > 0x10000) {
            return -1;
        }
        return std::mem::find(x"52 69 63 68", 0x40, lfanew);
    }

    /// リッチヘッダの鍵 (Rich の後ろの 4 バイト)
    fn rich_key() -> u32 {
        return std::mem::read_u32(rich_end() + 4, little);
    }

    /// リッチヘッダの先頭 "DanS" の位置 (なければ -1)
    fn rich_start() -> s64 {
        local s64 end = rich_end();
        if (end < 0) {
            return -1;
        }
        local u32 key = rich_key();
        for (local s64 p = end - 8; p >= 0x40; p -= 4) {
            if ((std::mem::read_u32(p, little) ^ key) == 0x536E6144) {
                return p;
            }
        }
        return -1;
    }

    /// e_lfanew の位置
    fn nt_offset() -> u64 {
        return std::mem::read_u32(0x3C, little);
    }

    /// セクション表の先頭のオフセット
    fn section_table_offset() -> u64 {
        local u64 nt = nt_offset();
        return nt + 24 + std::mem::read_u16(nt + 20, little);
    }

    /// RVA をファイルの位置に変換する (見つからない場合は RVA のまま)
    fn rva_to_offset(u64 rva) -> u64 {
        local u64 nt = nt_offset();
        local u64 count = std::mem::read_u16(nt + 6, little);
        local u64 table = section_table_offset();
        for (local u64 i = 0; i < count; i += 1) {
            local u64 s = table + i * 40;
            local u64 va = std::mem::read_u32(s + 12, little);
            local u64 vsize = std::math::max(std::mem::read_u32(s + 8, little), std::mem::read_u32(s + 16, little));
            if (rva >= va && rva < va + vsize) {
                return rva - va + std::mem::read_u32(s + 20, little);
            }
        }
        return rva;
    }

    /// VA (イメージベースを含むアドレス) をファイルの位置に変換する
    fn va_to_offset(u64 va) -> u64 {
        local u64 nt = nt_offset();
        local u64 magic = std::mem::read_u16(nt + 24, little);
        local u64 base = magic == 0x10B ? std::mem::read_u32(nt + 24 + 28, little) : std::mem::read_u64(nt + 24 + 24, little);
        return rva_to_offset(va - base);
    }

    /// 名前でセクションを探す (セクションヘッダのオフセット。なければ -1)
    fn find_section(string name) -> s64 {
        local u64 count = std::mem::read_u16(nt_offset() + 6, little);
        local u64 table = section_table_offset();
        for (local u64 i = 0; i < count; i += 1) {
            if (std::mem::read_string(table + i * 40, 8, "latin1") == name) {
                return table + i * 40;
            }
        }
        return -1;
    }
};
