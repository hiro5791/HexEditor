<Project Sdk="Microsoft.NET.Sdk">

  <!--
    プラグイン SDK の UI 部分 (08 の AUTO-29 の仕様 1: HexEditor.Sdk.UI)。パネル・設定画面を WinUI の UIElement で作るための型。
    WinUI に依存する。アプリはこのアセンブリをプラグインと共有する (プラグインのフォルダに同梱しても使わない。AUTO-29 の仕様 4)。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HexEditor.Sdk.UI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>
    <!-- SDK のバージョン (HexEditor.Sdk と同じ。アプリのバージョンとは別に数える)。 -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <IsPackable>true</IsPackable>
    <PackageId>HexEditor.Sdk.UI</PackageId>
    <PackageVersion>$(HexSdkPackageVersion)</PackageVersion>
    <Description>WinUI types for HexEditor plugin panels and settings pages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexEditor.Sdk\HexEditor.Sdk.csproj" />
  </ItemGroup>

</Project>
