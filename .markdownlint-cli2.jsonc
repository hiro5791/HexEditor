// Markdown の lint (PKG-23 の lint のジョブ)。文書は日本語で長い行・表・HTML を使うため、その規則は外す。
{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["docs/**/*.md", "*.md"],
  "ignores": ["**/bin/**", "**/obj/**", "artifacts/**"]
}
