<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- テスト用のオンラインリポジトリ (TD-TPL-REPO) の署名に、本体と同じ Ed25519 の実装 (BouncyCastle を呼ぶ) を使う (07 の TPL-36)。 -->
  <ItemGroup>
    <Compile Include="..\..\src\HexEditor.Core\Security\Ed25519.cs" Link="Shared\Ed25519.cs" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <!-- 圧縮のテストデータ (TD-EDIT-EXT-*) を、アプリの展開とは別の実装で作る。 -->
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Joveler.Compression.XZ" Version="5.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>

</Project>
