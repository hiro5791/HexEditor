<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ManualTestRunner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManualTestRunner"
    Title="手動テスト支援ツール">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="12" ColumnSpacing="12" RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  絞り込み (テスト方針 8.1)  -->
        <StackPanel Spacing="6">
            <ComboBox
                x:Name="FilterChoice"
                Header="テストの選び方"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="スモーク (優先度「高」)" />
                <ComboBoxItem Content="リリース前 (すべての手動・半自動)" />
                <ComboBoxItem Content="前回不合格・保留のもの" />
                <ComboBoxItem Content="未実施のもの" />
            </ComboBox>
            <ComboBox
                x:Name="PhaseChoice"
                Header="フェーズ (以下)"
                HorizontalAlignment="Stretch"
                SelectionChanged="Filter_Changed" />
            <TextBox x:Name="FeatureFilter" Header="機能 ID (例: ENG-28)" TextChanged="FeatureFilter_TextChanged" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <CheckBox
                    x:Name="HideEquipment"
                    Checked="HideEquipment_Changed"
                    Content="機材が必要なテストを除く"
                    IsChecked="True"
                    ToolTipService.ToolTip="USB メモリ・プリンタ・別の PC などが要るテストを一覧に出さない。報告には「機材が必要なため今回は実施しない」として書く"
                    Unchecked="HideEquipment_Changed" />
                <TextBlock
                    x:Name="HiddenCount"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
        </StackPanel>

        <ListView
            x:Name="CaseList"
            Grid.Row="1"
            SelectionChanged="CaseList_SelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CaseItem">
                    <StackPanel Padding="0,4" AutomationProperties.Name="{x:Bind Header}">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Header}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock x:Name="Summary" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReportButton" Click="Report_Click" Content="報告を書き出す" />
                <Button Click="NewRun_Click" Content="新しく始める" />
            </StackPanel>
            <CheckBox x:Name="TopMost" Checked="TopMost_Changed" Content="常に手前に表示" Unchecked="TopMost_Changed" />
        </StackPanel>

        <!--  テストケースの内容と結果の記録  -->
        <ScrollViewer Grid.RowSpan="2" Grid.Column="1">
            <StackPanel x:Name="Detail" Spacing="10" Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CaseTitle" IsTextSelectionEnabled="True" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <Button
                        x:Name="CopyAll"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="CopyAll_Click"
                        Content="すべてコピー"
                        ToolTipService.ToolTip="テストケースの番号・名前・準備の手順・手順・期待結果をまとめてコピーする" />
                </Grid>
                <TextBlock x:Name="CaseFields" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="準備の手順" />
                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel x:Name="PrepPanel" Spacing="4" />
                </Border>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PrepareButton"
                            Click="Prepare_Click"
                            Content="準備"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="テストデータとテスト用の設定フォルダを作り、HexEditor を起動する" />
                        <Button x:Name="MakeVhd" Click="MakeVhd_Click" Content="仮想ディスクを作る (管理者の確認が出ます)" Visibility="Collapsed" />
                        <Button x:Name="RemoveVhd" Click="RemoveVhd_Click" Content="仮想ディスクを外す" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BuildPortable" Click="BuildPortable_Click" Content="ポータブル版を作る (数分かかります)" Visibility="Collapsed" />
                        <Button x:Name="BuildInstaller" Click="BuildInstaller_Click" Content="インストーラ版を作ってインストールする (数分かかります)" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="PrepareStatus" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ToolStatus"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="手順" />
                <StackPanel x:Name="Steps" Spacing="2" />
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="期待結果" />
                <TextBlock x:Name="Expected" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="ResultPanel" Grid.Row="2" Grid.Column="1" Spacing="6" Visibility="Collapsed">
            <TextBox x:Name="Comment" Header="コメント" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Pass_Click" Content="合格" Style="{StaticResource AccentButtonStyle}" />
                <Button Click="Fail_Click" Content="不合格" />
                <Button Click="Hold_Click" Content="保留" />
                <Button Click="NotApplicable_Click" Content="対象外" />
                <TextBlock x:Name="CurrentResult" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
