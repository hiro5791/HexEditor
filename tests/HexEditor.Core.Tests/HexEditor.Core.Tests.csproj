<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\hash\**\*" LinkBase="fixtures\hash" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\templates\**\*" LinkBase="fixtures\templates" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HexEditor.Core\HexEditor.Core.csproj" />
    <ProjectReference Include="..\..\tools\HexEditor.TestData\HexEditor.TestData.csproj" />
    <ProjectReference Include="..\..\tools\HexEditor.ManualTests\HexEditor.ManualTests.csproj" />
    <ProjectReference Include="..\..\tools\I18nTool\I18nTool.csproj" />
    <ProjectReference Include="..\..\tools\ManualBuilder\ManualBuilder.csproj" />
    <!-- C# スクリプト コンポーネント (AUTO-03)。参照はせず、ビルドした出力をテストの出力の csharp-component\ に置く (テスト用の配布元の中身)。 -->
    <ProjectReference Include="..\..\src\HexEditor.Scripting.CSharp\HexEditor.Scripting.CSharp.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\tools\TestTarget\TestTarget.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows" />
  </ItemGroup>

  <Target Name="CopyCSharpComponent" AfterTargets="Build">
    <ItemGroup>
      <_HexComponentFiles Include="..\..\src\HexEditor.Scripting.CSharp\bin\$(Configuration)\net10.0\*.dll" Exclude="..\..\src\HexEditor.Scripting.CSharp\bin\$(Configuration)\net10.0\HexEditor.Sdk.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HexComponentFiles)" DestinationFolder="$(OutDir)csharp-component" SkipUnchangedFiles="true" />
  </Target>

  <!-- テスト用のプラグイン (08 の AUTO-29〜35。TD-AUTO-PLG-*)。参照はせず、出力をテストの出力の testplugins\<プロジェクト>\ に置く。 -->
  <Import Project="..\plugins\TestPlugins.targets" />

  <!-- 引数をそのまま出すテスト用の実行ファイル (TestTarget の echo-args。TC-AUTO-18-03)。 -->
  <Target Name="CopyEchoArgs" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <_HexTestTargetFiles Include="..\..\tools\TestTarget\bin\$(Configuration)\net10.0-windows\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HexTestTargetFiles)" DestinationFolder="$(OutDir)testtarget" SkipUnchangedFiles="true" />
  </Target>

</Project>
