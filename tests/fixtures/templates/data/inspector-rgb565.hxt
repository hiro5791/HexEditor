// TD-TPL-INSPECTOR: インスペクタ用の型 (TPL-29)。RGB565 の色を #RRGGBB で表示し、#RRGGBB の入力を 565 にして書き込む。
fn hex2(u32 v) -> string {
    return std::format("{:02X}", v & 0xFF);
}

fn fmt565(ref Rgb565 c) -> string {
    local u32 r = (c.v >> 11) & 0x1F;
    local u32 g = (c.v >> 5) & 0x3F;
    local u32 b = c.v & 0x1F;
    return "#" + hex2((r << 3) | (r >> 2)) + hex2((g << 2) | (g >> 4)) + hex2((b << 3) | (b >> 2));
}

fn to565(string s) -> u32 {
    local u32 rgb = std::string::parse_int(std::string::substr(s, 1, 6), 16);
    local u32 r = (rgb >> 16) & 0xFF;
    local u32 g = (rgb >> 8) & 0xFF;
    local u32 b = rgb & 0xFF;
    return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
}

struct Rgb565 {
    le u16 v;
} [[inspector("RGB565 色"), format(fmt565), write(to565)]];
